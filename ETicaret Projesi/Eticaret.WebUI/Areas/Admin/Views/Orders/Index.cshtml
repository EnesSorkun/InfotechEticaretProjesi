@using Eticaret.Core.Enums
@model IEnumerable<Order>

@{
    ViewData["Title"] = "Siparişlerim";
}

<div class="container py-5">

    <!-- =====================================================
         BAŞLIK
         ===================================================== -->
    <div class="mb-4">

        <h1 class="fw-bold mb-1">
            Siparişlerim
        </h1>

        <p class="text-muted mb-0">
            Geçmiş siparişlerinizi, sipariş durumlarını ve sipariş detaylarınızı görüntüleyebilirsiniz.
        </p>

    </div>


    @if (!Model.Any())
    {
        <!-- =================================================
             SİPARİŞ YOK
             ================================================= -->
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <div class="empty-order-icon mb-3">
                    <i class="fa-solid fa-box-open"></i>
                </div>

                <h2 class="h4 fw-bold">
                    Henüz siparişiniz bulunmuyor.
                </h2>

                <p class="text-muted">
                    Ürünlerimizi inceleyerek ilk siparişinizi oluşturabilirsiniz.
                </p>

                <a asp-controller="Products" asp-action="Index" class="btn btn-dark px-4">

                    <i class="fa-solid fa-bag-shopping me-2"></i>

                    Alışverişe Başla

                </a>

            </div>

        </div>
    }
    else
    {
        <!-- =================================================
             SİPARİŞ LİSTESİ
             ================================================= -->
        <div class="row g-3">

            @foreach (var order in Model)
            {
                <div class="col-12">

                    <div class="card border-0 shadow-sm order-card">

                        <div class="card-body p-4">

                            <div class="row align-items-center g-3">


                                <!-- Sipariş No -->
                                <div class="col-lg-3 col-md-6">

                                    <small class="text-muted d-block mb-1">
                                        Sipariş No
                                    </small>

                                    <strong>
                                        @order.OrderNumber
                                    </strong>

                                </div>


                                <!-- Sipariş Tarihi -->
                                <div class="col-lg-2 col-md-6">

                                    <small class="text-muted d-block mb-1">
                                        Sipariş Tarihi
                                    </small>

                                    <span>
                                        @(order.OrderDate
                                            .ToLocalTime()
                                            .ToString("dd.MM.yyyy HH:mm"))
                                    </span>

                                </div>


                                <!-- Toplam Tutar -->
                                <div class="col-lg-2 col-md-6">

                                    <small class="text-muted d-block mb-1">
                                        Sipariş Toplamı
                                    </small>

                                    <strong>
                                        @order.TotalPrice.ToString("N2") ₺
                                    </strong>

                                </div>


                                <!-- Sipariş Durumu -->
                                <div class="col-lg-2 col-md-6">

                                    <small class="text-muted d-block mb-1">
                                        Sipariş Durumu
                                    </small>

                                    @switch (order.Status)
                                    {
                                        case OrderStatus.PendingApproval:

                                            <span class="badge bg-warning text-dark order-status-badge">

                                                <i class="fa-solid fa-clock me-1"></i>

                                                Onay Bekliyor

                                            </span>

                                            break;


                                        case OrderStatus.Approved:

                                            <span class="badge bg-primary order-status-badge">

                                                <i class="fa-solid fa-circle-check me-1"></i>

                                                Onaylandı

                                            </span>

                                            break;


                                        case OrderStatus.Preparing:

                                            <span class="badge bg-info text-dark order-status-badge">

                                                <i class="fa-solid fa-box me-1"></i>

                                                Hazırlanıyor

                                            </span>

                                            break;


                                        case OrderStatus.Shipped:

                                            <span class="badge bg-secondary order-status-badge">

                                                <i class="fa-solid fa-truck me-1"></i>

                                                Kargoya Verildi

                                            </span>

                                            break;


                                        case OrderStatus.Delivered:

                                            <span class="badge bg-success order-status-badge">

                                                <i class="fa-solid fa-circle-check me-1"></i>

                                                Teslim Edildi

                                            </span>

                                            break;


                                        case OrderStatus.Cancelled:

                                            <span class="badge bg-danger order-status-badge">

                                                <i class="fa-solid fa-circle-xmark me-1"></i>

                                                İptal Edildi

                                            </span>

                                            break;
                                    }

                                </div>


                                <!-- Detay -->
                                <div class="col-lg-3 col-md-12 text-lg-end">

                                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"
                                       class="btn btn-outline-dark">

                                        Sipariş Detayı

                                        <i class="fa-solid fa-chevron-right ms-2"></i>

                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>


<style>
    .order-card {
        border-radius: 14px;
        transition: all 0.2s ease;
    }

    .order-card:hover {
        transform: translateY(-2px);
    }

    .empty-order-icon {
        width: 80px;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: auto;
        margin-right: auto;
        border-radius: 50%;
        background-color: #f1f3f5;
        font-size: 2rem;
    }

    .order-status-badge {
        padding: 8px 12px;
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: 8px;
    }
</style>