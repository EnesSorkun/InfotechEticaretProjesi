@model IEnumerable<Eticaret.Core.Entities.AppUser>

@{
    ViewData["Title"] = "Kullanıcılar";
    var userCount = Model?.Count() ?? 0;
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">
                Kullanıcı Yönetimi
            </h1>

            <p class="text-muted mb-0">
                Sistemde kayıtlı kullanıcıları görüntüleyebilir ve yönetebilirsiniz.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-success px-4 py-2">
            <i class="fa-solid fa-user-plus me-2"></i>
            Yeni Kullanıcı Ekle
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">
                            Toplam Kullanıcı
                        </p>

                        <h3 class="fw-bold mb-0">
                            @userCount
                        </h3>
                    </div>

                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-users fs-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Kullanıcı Listesi
                    </h2>

                    <p class="text-muted small mb-0">
                        Kayıtlı kullanıcıların hesap ve yetki bilgileri
                    </p>
                </div>
            </div>
        </div>

        <div class="card-body p-0">

            @if (Model is null || !Model.Any())
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="fa-solid fa-user-slash fa-3x text-muted"></i>
                    </div>

                    <h3 class="h5 fw-bold">
                        Henüz kullanıcı bulunmuyor
                    </h3>

                    <p class="text-muted">
                        Yeni bir kullanıcı ekleyerek başlayabilirsiniz.
                    </p>

                    <a asp-action="Create" class="btn btn-success">
                        <i class="fa-solid fa-user-plus me-2"></i>
                        Kullanıcı Ekle
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">
                                    Kullanıcı
                                </th>

                                <th>
                                    E-posta
                                </th>

                                <th>
                                    Durum
                                </th>

                                <th>
                                    Yetki
                                </th>

                                <th>
                                    Kayıt Tarihi
                                </th>

                                <th class="text-end pe-4">
                                    İşlemler
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                                 style="width: 42px; height: 42px;">
                                                @item.Name?.Substring(0, 1).ToUpper()
                                            </div>

                                            <div>
                                                <div class="fw-semibold">
                                                    @item.Name @item.Surname
                                                </div>

                                                <div class="text-muted small">
                                                    @(string.IsNullOrWhiteSpace(item.UserName)
                                                        ? "Kullanıcı adı yok"
                                                        : item.UserName)
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <a href="mailto:@item.Email" class="text-decoration-none">
                                            @item.Email
                                        </a>
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                                <i class="fa-solid fa-circle-check me-1"></i>
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                                Pasif
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.IsAdmin)
                                        {
                                            <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">
                                                <i class="fa-solid fa-user-shield me-1"></i>
                                                Admin
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">
                                                <i class="fa-solid fa-user me-1"></i>
                                                Kullanıcı
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="fw-medium">
                                            @item.CreateDate.ToString("dd.MM.yyyy")
                                        </div>

                                        <div class="text-muted small">
                                            @item.CreateDate.ToString("HH:mm")
                                        </div>
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">

                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-md btn-outline-primary" title="Detaylar">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>

                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-md btn-outline-warning"
                                               title="Düzenle">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>

                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-md btn-outline-danger"
                                               title="Sil">
                                                <i class="fa-solid fa-trash"></i>
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>