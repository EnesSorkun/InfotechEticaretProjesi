@model AppUser

@{
    ViewData["Title"] = "Kullanıcı Düzenle";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">
                Kullanıcı Düzenle
            </h1>

            <p class="text-muted mb-0">
                Kullanıcının profil, hesap durumu ve yetki bilgilerini güncelleyebilirsiniz.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Kullanıcılara Dön
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center"
                     style="width: 46px; height: 46px;">
                    <i class="fa-solid fa-user-pen"></i>
                </div>

                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Kullanıcı Bilgileri
                    </h2>

                    <p class="text-muted small mb-0">
                        @Model.Name @Model.Surname
                    </p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                </div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreateDate" />
                <input type="hidden" asp-for="UserGuid" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold">
                            Ad
                        </label>

                        <input asp-for="Name" class="form-control form-control-lg"
                               placeholder="Kullanıcının adını giriniz" />

                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Surname" class="form-label fw-semibold">
                            Soyad
                        </label>

                        <input asp-for="Surname" class="form-control form-control-lg"
                               placeholder="Kullanıcının soyadını giriniz" />

                        <span asp-validation-for="Surname" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold">
                            E-posta
                        </label>

                        <div class="input-group input-group-lg">
                            <span class="input-group-text">
                                <i class="fa-solid fa-envelope"></i>
                            </span>

                            <input asp-for="Email" type="email" class="form-control" placeholder="ornek@site.com" />
                        </div>

                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold">
                            Telefon
                        </label>

                        <div class="input-group input-group-lg">
                            <span class="input-group-text">
                                <i class="fa-solid fa-phone"></i>
                            </span>

                            <input asp-for="Phone" type="tel" class="form-control" placeholder="05xx xxx xx xx" />
                        </div>

                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="UserName" class="form-label fw-semibold">
                            Kullanıcı Adı
                        </label>

                        <div class="input-group input-group-lg">
                            <span class="input-group-text">
                                <i class="fa-solid fa-at"></i>
                            </span>

                            <input asp-for="UserName" class="form-control" placeholder="Kullanıcı adını giriniz" />
                        </div>

                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold">
                            Şifre
                        </label>

                        <div class="input-group input-group-lg">
                            <span class="input-group-text">
                                <i class="fa-solid fa-lock"></i>
                            </span>

                            <input asp-for="Password" type="password" class="form-control"
                                   placeholder="Şifreyi giriniz" />
                        </div>

                        <span asp-validation-for="Password" class="text-danger small"></span>

                        <div class="form-text">
                            Mevcut şifreyi değiştirmek istemiyorsanız alanın yönetimini
                            controller tarafında ayrıca ele almalısınız.
                        </div>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsActive" class="form-check-input" role="switch" />

                                <label asp-for="IsActive" class="form-check-label fw-semibold">
                                    Kullanıcı aktif
                                </label>
                            </div>

                            <p class="text-muted small mb-0 mt-2">
                                Pasif kullanıcıların sisteme erişimini kısıtlamak için kapatabilirsiniz.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="form-check form-switch mb-0">
                                <input asp-for="IsAdmin" class="form-check-input" role="switch" />

                                <label asp-for="IsAdmin" class="form-check-label fw-semibold">
                                    Yönetici yetkisi
                                </label>
                            </div>

                            <p class="text-muted small mb-0 mt-2">
                                Bu seçenek kullanıcıya yönetim paneli yetkisi verir.
                            </p>
                        </div>
                    </div>

                </div>

                <div class="bg-light rounded-3 p-3 mt-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <span class="text-muted small d-block">
                                Kayıt tarihi
                            </span>

                            <span class="fw-semibold">
                                @Model.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </span>
                        </div>

                        <div class="col-md-6">
                            <span class="text-muted small d-block">
                                Kullanıcı kimliği
                            </span>

                            <span class="fw-semibold text-break">
                                @(Model.UserGuid?.ToString() ?? "Kimlik bulunmuyor")
                            </span>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        İptal
                    </a>

                    <button type="submit" class="btn btn-warning px-4">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Değişiklikleri Kaydet
                    </button>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}