@model Eticaret.Core.Entities.AppUser

@{
    ViewData["Title"] = "Kullanıcı Detayı";
    Layout = "_LayoutAdmin";

    var fullName = $"{Model.Name} {Model.Surname}";
    var firstLetter = string.IsNullOrWhiteSpace(Model.Name)
        ? "?"
        : Model.Name.Substring(0, 1).ToUpper();
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">
                Kullanıcı Detayı
            </h1>

            <p class="text-muted mb-0">
                Kullanıcının hesap, iletişim ve yetki bilgilerini görüntüleyebilirsiniz.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Kullanıcılara Dön
            </a>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fa-solid fa-pen-to-square me-2"></i>
                Düzenle
            </a>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">

                    <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold mx-auto mb-3"
                         style="width: 90px; height: 90px; font-size: 2rem;">
                        @firstLetter
                    </div>

                    <h2 class="h4 fw-bold mb-1">
                        @fullName
                    </h2>

                    <p class="text-muted mb-3">
                        @(string.IsNullOrWhiteSpace(Model.UserName)
                            ? "Kullanıcı adı bulunmuyor"
                            : $"@{Model.UserName}")
                    </p>

                    <div class="d-flex justify-content-center flex-wrap gap-2">

                        @if (Model.IsActive)
                        {
                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                <i class="fa-solid fa-circle-check me-1"></i>
                                Aktif
                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                Pasif
                            </span>
                        }

                        @if (Model.IsAdmin)
                        {
                            <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">
                                <i class="fa-solid fa-user-shield me-1"></i>
                                Admin
                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">
                                <i class="fa-solid fa-user me-1"></i>
                                Kullanıcı
                            </span>
                        }

                    </div>

                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                             style="width: 44px; height: 44px;">
                            <i class="fa-solid fa-address-card"></i>
                        </div>

                        <div>
                            <h2 class="h5 fw-bold mb-1">
                                Hesap Bilgileri
                            </h2>

                            <p class="text-muted small mb-0">
                                Kullanıcıya ait kayıtlı bilgiler
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <span class="text-muted small d-block mb-1">
                                    Ad
                                </span>

                                <span class="fw-semibold">
                                    @Model.Name
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <span class="text-muted small d-block mb-1">
                                    Soyad
                                </span>

                                <span class="fw-semibold">
                                    @Model.Surname
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <span class="text-muted small d-block mb-1">
                                    E-posta
                                </span>

                                <a href="mailto:@Model.Email" class="fw-semibold text-decoration-none">
                                    <i class="fa-solid fa-envelope me-2"></i>
                                    @Model.Email
                                </a>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <span class="text-muted small d-block mb-1">
                                    Telefon
                                </span>

                                @if (string.IsNullOrWhiteSpace(Model.Phone))
                                {
                                    <span class="text-muted">
                                        Telefon bilgisi bulunmuyor
                                    </span>
                                }
                                else
                                {
                                    <a href="tel:@Model.Phone" class="fw-semibold text-decoration-none">
                                        <i class="fa-solid fa-phone me-2"></i>
                                        @Model.Phone
                                    </a>
                                }
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <span class="text-muted small d-block mb-1">
                                    Kullanıcı adı
                                </span>

                                <span class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(Model.UserName)
                                        ? "Belirtilmemiş"
                                        : Model.UserName)
                                </span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-3 p-3 h-100">
                                <span class="text-muted small d-block mb-1">
                                    Kayıt tarihi
                                </span>

                                <span class="fw-semibold">
                                    @Model.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="border rounded-3 p-3">
                                <span class="text-muted small d-block mb-1">
                                    Kullanıcı kimliği
                                </span>

                                <span class="fw-semibold text-break">
                                    @(Model.UserGuid?.ToString() ?? "Kullanıcı kimliği bulunmuyor")
                                </span>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>

</div>