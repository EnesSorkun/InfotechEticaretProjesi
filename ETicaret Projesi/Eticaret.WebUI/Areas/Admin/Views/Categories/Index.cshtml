@model IEnumerable<Category>

@{
    ViewData["Title"] = "Kategoriler";
    Layout = "_LayoutAdmin";

    var categoryCount = Model?.Count() ?? 0;
    var activeCategoryCount = Model?.Count(x => x.IsActive) ?? 0;
    var topMenuCount = Model?.Count(x => x.IsTopMenu) ?? 0;
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">
                Kategori Yönetimi
            </h1>

            <p class="text-muted mb-0">
                Kategorileri, menü durumlarını ve sıralamalarını yönetebilirsiniz.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-success px-4 py-2">
            <i class="fa-solid fa-folder-plus me-2"></i>
            Yeni Kategori Ekle
        </a>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">
                            Toplam Kategori
                        </p>

                        <h3 class="fw-bold mb-0">
                            @categoryCount
                        </h3>
                    </div>

                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-layer-group fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">
                            Aktif Kategori
                        </p>

                        <h3 class="fw-bold mb-0">
                            @activeCategoryCount
                        </h3>
                    </div>

                    <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-circle-check fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted small mb-1">
                            Üst Menüde
                        </p>

                        <h3 class="fw-bold mb-0">
                            @topMenuCount
                        </h3>
                    </div>

                    <div class="bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-bars fs-5"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">
            <div>
                <h2 class="h5 fw-bold mb-1">
                    Kategori Listesi
                </h2>

                <p class="text-muted small mb-0">
                    Kategorilerin görsel, durum, menü ve sıralama bilgileri
                </p>
            </div>
        </div>

        <div class="card-body p-0">

            @if (Model is null || !Model.Any())
            {
                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="fa-solid fa-folder-open fa-3x text-muted"></i>
                    </div>

                    <h3 class="h5 fw-bold">
                        Henüz kategori bulunmuyor
                    </h3>

                    <p class="text-muted">
                        Yeni bir kategori ekleyerek başlayabilirsiniz.
                    </p>

                    <a asp-action="Create" class="btn btn-success">
                        <i class="fa-solid fa-folder-plus me-2"></i>
                        Kategori Ekle
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">
                                    @Html.DisplayNameFor(model => model.Name)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.Image)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.IsActive)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.IsTopMenu)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.ParentId)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.OrderNo)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.CreateDate)
                                </th>

                                <th class="text-end pe-4">
                                    İşlemler
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">

                                            <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                                 style="width: 42px; height: 42px;">
                                                @(string.IsNullOrWhiteSpace(item.Name)
                                                    ? "?"
                                                    : item.Name.Substring(0, 1).ToUpper())
                                            </div>

                                            <div>
                                                <div class="fw-semibold">
                                                    @item.Name
                                                </div>

                                                <div class="text-muted small">
                                                    Kategori No: @item.Id
                                                </div>
                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(item.Image))
                                        {
                                            <span class="text-muted">
                                                Görsel yok
                                            </span>
                                        }
                                        else
                                        {
                                            <img src="@item.Image" alt="@item.Name" class="rounded border bg-white"
                                                 style="width: 60px; height: 42px; object-fit: contain;" />
                                        }
                                    </td>

                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                                <i class="fa-solid fa-circle-check me-1"></i>
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                                Pasif
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.IsTopMenu)
                                        {
                                            <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">
                                                <i class="fa-solid fa-bars me-1"></i>
                                                Gösteriliyor
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">
                                                <i class="fa-solid fa-eye-slash me-1"></i>
                                                Gizli
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.ParentId == 0)
                                        {
                                            <span class="badge bg-dark-subtle text-dark px-3 py-2">
                                                Ana Kategori
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fw-semibold">
                                                @item.ParentId
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary px-3 py-2">
                                            @item.OrderNo
                                        </span>
                                    </td>

                                    <td>
                                        <div class="fw-medium">
                                            @item.CreateDate.ToLocalTime().ToString("dd.MM.yyyy")
                                        </div>

                                        <div class="text-muted small">
                                            @item.CreateDate.ToLocalTime().ToString("HH:mm")
                                        </div>
                                    </td>

                                    <td class="text-end pe-4">

                                        <div class="btn-group" role="group">

                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-md btn-outline-primary" title="Detaylar">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>

                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-md btn-outline-warning"
                                               title="Düzenle">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </a>

                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-md btn-outline-danger"
                                               title="Sil">
                                                <i class="fa-solid fa-trash"></i>
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>