@model IEnumerable<News>

@{
    ViewData["Title"] = "Kampanya ve Duyurular";
    Layout = "_LayoutAdmin";

    var newsCount = Model?.Count() ?? 0;
    var activeNewsCount = Model?.Count(x => x.IsActive) ?? 0;
}

<div class="container-fluid px-4 py-4">

    <!-- Sayfa Başlığı -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Kampanya ve Duyurular
            </h1>

            <p class="text-muted mb-0">
                Kampanya ve duyuruları görüntüleyebilir ve yönetebilirsiniz.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-success px-4 py-2">

            <i class="fa-solid fa-plus me-2"></i>
            Yeni Duyuru Ekle

        </a>

    </div>


    <!-- İstatistikler -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center justify-content-between">

                    <div>

                        <p class="text-muted small mb-1">
                            Toplam Duyuru
                        </p>

                        <h3 class="fw-bold mb-0">
                            @newsCount
                        </h3>

                    </div>

                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px;">

                        <i class="fa-solid fa-bullhorn fs-5"></i>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-sm-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center justify-content-between">

                    <div>

                        <p class="text-muted small mb-1">
                            Aktif Duyuru
                        </p>

                        <h3 class="fw-bold mb-0">
                            @activeNewsCount
                        </h3>

                    </div>

                    <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px;">

                        <i class="fa-solid fa-circle-check fs-5"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Liste -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div>

                <h2 class="h5 fw-bold mb-1">
                    Duyuru Listesi
                </h2>

                <p class="text-muted small mb-0">
                    Sistemde kayıtlı kampanya ve duyurular
                </p>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model is null || !Model.Any())
            {
                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="fa-solid fa-bullhorn fa-3x text-muted"></i>
                    </div>

                    <h3 class="h5 fw-bold">
                        Henüz duyuru bulunmuyor
                    </h3>

                    <p class="text-muted">
                        Yeni bir kampanya veya duyuru ekleyerek başlayabilirsiniz.
                    </p>

                    <a asp-action="Create" class="btn btn-success">

                        <i class="fa-solid fa-plus me-2"></i>
                        Yeni Duyuru Ekle

                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Görsel
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.Name)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.IsActive)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.CreateDate)
                                </th>

                                <th class="text-end pe-4">
                                    İşlemler
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Görsel -->
                                    <td class="ps-4">

                                        @if (!string.IsNullOrWhiteSpace(item.Image))
                                        {
                                            <img src="@item.Image" alt="@item.Name" class="rounded border bg-white" style="width: 75px;
                                            height: 55px;
                                            object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted"
                                                 style="width: 75px;
                                                height: 55px;">

                                                <i class="fa-solid fa-image"></i>

                                            </div>
                                        }

                                    </td>


                                    <!-- Duyuru Adı -->
                                    <td>

                                        <div class="fw-semibold">
                                            @item.Name
                                        </div>

                                        <div class="text-muted small">
                                            Duyuru ID: @item.Id
                                        </div>

                                    </td>


                                    <!-- Durum -->
                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">

                                                <i class="fa-solid fa-circle-check me-1"></i>
                                                Aktif

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">

                                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                                Pasif

                                            </span>
                                        }

                                    </td>


                                    <!-- Kayıt Tarihi -->
                                    <td>

                                        <div class="fw-medium">
                                            @(item.CreateDate.ToLocalTime().ToString("dd.MM.yyyy"))
                                        </div>

                                        <div class="text-muted small">
                                            @(item.CreateDate.ToLocalTime().ToString("HH:mm"))
                                        </div>

                                    </td>


                                    <!-- İşlemler -->
                                    <td class="text-end pe-4">

                                        <div class="btn-group" role="group">

                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-md btn-outline-primary" title="Detaylar">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>

                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-md btn-outline-warning"
                                               title="Düzenle">

                                                <i class="fa-solid fa-pen-to-square"></i>

                                            </a>

                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-md btn-outline-danger"
                                               title="Sil">

                                                <i class="fa-solid fa-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>