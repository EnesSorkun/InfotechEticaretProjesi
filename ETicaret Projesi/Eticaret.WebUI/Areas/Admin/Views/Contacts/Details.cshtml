@model Contact

@{
    ViewData["Title"] = "İletişim Detayı";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                İletişim Detayı
            </h1>

            <p class="text-muted mb-0">
                Kullanıcı tarafından gönderilen iletişim formunun detayları.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left me-1"></i>
            Listeye Dön

        </a>

    </div>


    <div class="row g-4">

        <!-- SOL TARAF -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="text-center mb-4">

                        <div class="bg-dark text-white rounded-circle d-inline-flex align-items-center justify-content-center fw-bold mb-3"
                             style="width: 70px; height: 70px; font-size: 26px;">

                            @(string.IsNullOrWhiteSpace(Model.Name)
                                ? "?"
                                : Model.Name.Substring(0, 1).ToUpper())

                        </div>

                        <h4 class="fw-bold mb-1">
                            @Model.Name @Model.Surname
                        </h4>

                        <span class="text-muted small">
                            Form #@Model.Id
                        </span>

                    </div>


                    <hr />


                    <div class="mb-3">

                        <small class="text-muted d-block mb-1">
                            Email
                        </small>

                        @if (!string.IsNullOrWhiteSpace(Model.Email))
                        {
                            <a href="mailto:@Model.Email" class="text-decoration-none">

                                <i class="fa-regular fa-envelope me-1"></i>

                                @Model.Email

                            </a>
                        }
                        else
                        {
                            <span class="text-muted">
                                Belirtilmemiş
                            </span>
                        }

                    </div>


                    <div class="mb-3">

                        <small class="text-muted d-block mb-1">
                            Telefon
                        </small>

                        @if (!string.IsNullOrWhiteSpace(Model.Phone))
                        {
                            <span>
                                <i class="fa-solid fa-phone me-1"></i>
                                @Model.Phone
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">
                                Belirtilmemiş
                            </span>
                        }

                    </div>


                    <div>

                        <small class="text-muted d-block mb-1">
                            Gönderim Tarihi
                        </small>

                        <span>
                            <i class="fa-regular fa-calendar me-1"></i>
                            @Model.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- SAĞ TARAF -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 p-4 pb-0">

                    <h5 class="fw-bold mb-0">

                        <i class="fa-regular fa-message me-2 text-primary"></i>

                        Kullanıcının Mesajı

                    </h5>

                </div>


                <div class="card-body p-4">

                    <div class="bg-light rounded-3 p-4">

                        <p class="mb-0" style="white-space: pre-wrap; line-height: 1.8;">@Model.Message</p>

                    </div>

                </div>


                <div class="card-footer bg-white border-0 px-4 pb-4">

                    <div class="d-flex flex-wrap gap-2">

                        @if (!string.IsNullOrWhiteSpace(Model.Email))
                        {
                            <a asp-action="SendMail" asp-route-id="@Model.Id" class="btn btn-success">

                                <i class="fa-solid fa-paper-plane me-2"></i>

                                Mail ile Cevapla

                            </a>
                        }


                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">

                            <i class="fa-solid fa-trash me-2"></i>

                            Kaydı Sil

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>