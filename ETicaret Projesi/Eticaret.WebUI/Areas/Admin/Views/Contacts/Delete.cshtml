@model Contact

@{
    ViewData["Title"] = "İletişim Kaydı Sil";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                İletişim Kaydı Sil
            </h1>

            <p class="text-muted mb-0">
                Seçilen iletişim kaydını sistemden silebilirsiniz.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left me-2"></i>
            Listeye Dön

        </a>

    </div>


    <div class="alert alert-danger border-0 shadow-sm mb-4">

        <div class="d-flex align-items-start gap-3">

            <div class="fs-4">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div>

                <h2 class="h5 fw-bold mb-1">
                    Bu iletişim kaydını silmek istediğinize emin misiniz?
                </h2>

                <p class="mb-0">
                    Bu işlem geri alınamaz ve kayıt veritabanından kalıcı olarak silinir.
                </p>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex align-items-center gap-3">

                <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center"
                     style="width: 46px; height: 46px;">

                    <i class="fa-solid fa-trash"></i>

                </div>

                <div>

                    <h2 class="h5 fw-bold mb-1">
                        @Model.Name @Model.Surname
                    </h2>

                    <p class="text-muted small mb-0">
                        Form #@Model.Id
                    </p>

                </div>

            </div>

        </div>


        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-6">

                    <div class="border rounded-3 p-3 h-100">

                        <div class="text-muted small mb-1">
                            Email
                        </div>

                        <div class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.Email)
                                ? "Belirtilmemiş"
                                : Model.Email)
                        </div>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="border rounded-3 p-3 h-100">

                        <div class="text-muted small mb-1">
                            Telefon
                        </div>

                        <div class="fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.Phone)
                                ? "Belirtilmemiş"
                                : Model.Phone)
                        </div>

                    </div>

                </div>


                <div class="col-12">

                    <div class="border rounded-3 p-3">

                        <div class="text-muted small mb-2">
                            Mesaj
                        </div>

                        <p class="mb-0" style="white-space: pre-wrap; line-height: 1.7;">
                            @Model.Message
                        </p>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="border rounded-3 p-3 h-100">

                        <div class="text-muted small mb-1">
                            Kayıt Tarihi
                        </div>

                        <div class="fw-semibold">

                            @Model.CreateDate
                            .ToLocalTime()
                            .ToString("dd.MM.yyyy HH:mm")

                        </div>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">

                    <a asp-action="Index" class="btn btn-outline-secondary px-4">

                        <i class="fa-solid fa-xmark me-2"></i>
                        Vazgeç

                    </a>

                    <button type="submit" class="btn btn-danger px-4">

                        <i class="fa-solid fa-trash me-2"></i>
                        Kaydı Sil

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>