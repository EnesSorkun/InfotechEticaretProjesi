@model IEnumerable<Contact>

@{
    ViewData["Title"] = "İletişim Formları";
    Layout = "_LayoutAdmin";

    var contactCount = Model?.Count() ?? 0;
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">
                İletişim Formları
            </h1>

            <p class="text-muted mb-0">
                Kullanıcılardan gelen iletişim kayıtlarını görüntüleyebilirsiniz.
            </p>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center justify-content-between">

                    <div>
                        <p class="text-muted small mb-1">
                            Toplam Form
                        </p>

                        <h3 class="fw-bold mb-0">
                            @contactCount
                        </h3>
                    </div>

                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                         style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-envelope fs-5"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div>
                <h2 class="h5 fw-bold mb-1">
                    Gelen İletişim Formları
                </h2>

                <p class="text-muted small mb-0">
                    Gönderilen iletişim kayıtları
                </p>
            </div>

        </div>

        <div class="card-body p-0">

            @if (Model is null || !Model.Any())
            {
                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="fa-regular fa-envelope-open fa-3x text-muted"></i>
                    </div>

                    <h3 class="h5 fw-bold">
                        Henüz iletişim formu bulunmuyor
                    </h3>

                    <p class="text-muted mb-0">
                        Kullanıcılar iletişim formu gönderdiğinde kayıtlar burada görüntülenecektir.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th class="ps-4">
                                    Gönderen
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.Email)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.Phone)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.CreateDate)
                                </th>

                                <th class="text-end pe-4">
                                    İşlemler
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                                 style="width: 42px; height: 42px;">

                                                @(string.IsNullOrWhiteSpace(item.Name)
                                                    ? "?"
                                                    : item.Name.Substring(0, 1).ToUpper())

                                            </div>

                                            <div>

                                                <div class="fw-semibold">
                                                    @item.Name @item.Surname
                                                </div>

                                                <div class="text-muted small">
                                                    Form #@item.Id
                                                </div>

                                            </div>

                                        </div>

                                    </td>

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(item.Email))
                                        {
                                            <span class="text-muted">
                                                Belirtilmemiş
                                            </span>
                                        }
                                        else
                                        {
                                            <a href="mailto:@item.Email" class="text-decoration-none">
                                                <i class="fa-regular fa-envelope me-1"></i>
                                                @item.Email
                                            </a>
                                        }

                                    </td>

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(item.Phone))
                                        {
                                            <span class="text-muted">
                                                Belirtilmemiş
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                <i class="fa-solid fa-phone me-1 text-muted"></i>
                                                @item.Phone
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <div class="fw-medium">
                                            @(item.CreateDate.ToLocalTime().ToString("dd.MM.yyyy"))
                                        </div>

                                        <div class="text-muted small">
                                            @(item.CreateDate.ToLocalTime().ToString("HH:mm"))
                                        </div>

                                    </td>

                                    <td class="text-end pe-4">

                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-md btn-outline-danger"
                                           title="Sil">

                                            <i class="fa-solid fa-trash"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>