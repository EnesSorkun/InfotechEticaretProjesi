@model Eticaret.Core.Entities.Slider

@{
    ViewData["Title"] = "Slider Sil";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Slider Sil
            </h1>

            <p class="text-muted mb-0">
                Seçilen slider kaydını sistemden silebilirsiniz.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left me-2"></i>
            Sliderlara Dön

        </a>

    </div>

    <div class="alert alert-danger border-0 shadow-sm mb-4">

        <div class="d-flex align-items-start gap-3">

            <div class="fs-4">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div>

                <h2 class="h5 fw-bold mb-1">
                    Bu sliderı silmek istediğinize emin misiniz?
                </h2>

                <p class="mb-0">
                    Bu işlem slider kaydını sistemden kalıcı olarak kaldıracaktır.
                    Silme işlemi geri alınamaz.
                </p>

            </div>

        </div>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex align-items-center gap-3">

                <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center"
                     style="width: 46px; height: 46px;">

                    <i class="fa-solid fa-trash"></i>

                </div>

                <div>

                    <h2 class="h5 fw-bold mb-1">
                        @Model.Title
                    </h2>

                    <p class="text-muted small mb-0">
                        Slider ID: @Model.Id
                    </p>

                </div>

            </div>

        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-lg-7">

                    <div class="row g-4">

                        <div class="col-12">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.Title)
                                </div>

                                <div class="fw-semibold fs-5">
                                    @Model.Title
                                </div>

                            </div>

                        </div>

                        <div class="col-12">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-2">
                                    @Html.DisplayNameFor(model => model.Description)
                                </div>

                                @if (string.IsNullOrWhiteSpace(Model.Description))
                                {
                                    <span class="text-muted">
                                        Açıklama bulunmuyor.
                                    </span>
                                }
                                else
                                {
                                    <p class="mb-0">
                                        @Model.Description
                                    </p>
                                }

                            </div>

                        </div>

                        <div class="col-12">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-2">
                                    @Html.DisplayNameFor(model => model.Link)
                                </div>

                                @if (string.IsNullOrWhiteSpace(Model.Link))
                                {
                                    <span class="text-muted">
                                        Bağlantı bulunmuyor.
                                    </span>
                                }
                                else
                                {
                                    <span class="fw-semibold text-break">
                                        @Model.Link
                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-lg-5">

                    <div class="border rounded-3 p-4 h-100">

                        <div class="text-muted small mb-3">
                            @Html.DisplayNameFor(model => model.Image)
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Image))
                        {
                            <div class="text-center">

                                <img src="@Model.Image" alt="@Model.Title" class="img-fluid rounded border bg-white"
                                     style="width: 100%; max-height: 320px; object-fit: cover;" />

                                <div class="text-muted small text-break mt-3">
                                    @Model.Image
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">

                                <i class="fa-solid fa-image fa-3x text-muted mb-3"></i>

                                <p class="text-muted mb-0">
                                    Slider görseli bulunmuyor.
                                </p>

                            </div>
                        }

                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">

                    <a asp-action="Index" class="btn btn-outline-secondary px-4">

                        <i class="fa-solid fa-xmark me-2"></i>
                        Vazgeç

                    </a>

                    <button type="submit" class="btn btn-danger px-4">

                        <i class="fa-solid fa-trash me-2"></i>
                        Sliderı Sil

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>