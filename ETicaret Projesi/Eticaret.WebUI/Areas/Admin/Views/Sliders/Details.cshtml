@model Eticaret.Core.Entities.Slider

@{
    ViewData["Title"] = "Slider Detayları";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Slider Detayları
            </h1>

            <p class="text-muted mb-0">
                Slider'a ait tüm bilgileri görüntüleyebilirsiniz.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Index" class="btn btn-outline-secondary">

                <i class="fa-solid fa-arrow-left me-2"></i>
                Sliderlara Dön

            </a>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">

                <i class="fa-solid fa-pen-to-square me-2"></i>
                Düzenle

            </a>

        </div>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex align-items-center gap-3">

                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                     style="width: 46px; height: 46px;">

                    <i class="fa-solid fa-images"></i>

                </div>

                <div>

                    <h2 class="h5 fw-bold mb-1">
                        @Model.Title
                    </h2>

                    <p class="text-muted small mb-0">
                        Slider ID: @Model.Id
                    </p>

                </div>

            </div>

        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-lg-7">

                    <div class="row g-4">

                        <div class="col-12">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.Title)
                                </div>

                                <div class="fw-semibold fs-5">
                                    @Model.Title
                                </div>

                            </div>

                        </div>

                        <div class="col-12">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-2">
                                    @Html.DisplayNameFor(model => model.Description)
                                </div>

                                @if (string.IsNullOrWhiteSpace(Model.Description))
                                {
                                    <span class="text-muted">
                                        Açıklama bulunmuyor.
                                    </span>
                                }
                                else
                                {
                                    <p class="mb-0">
                                        @Model.Description
                                    </p>
                                }

                            </div>

                        </div>

                        <div class="col-12">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-2">
                                    @Html.DisplayNameFor(model => model.Link)
                                </div>

                                @if (string.IsNullOrWhiteSpace(Model.Link))
                                {
                                    <span class="text-muted">
                                        Bağlantı bulunmuyor.
                                    </span>
                                }
                                else
                                {
                                    <a href="@Model.Link" class="text-decoration-none fw-semibold" target="_blank">

                                        <i class="fa-solid fa-arrow-up-right-from-square me-2"></i>
                                        @Model.Link

                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-lg-5">

                    <div class="border rounded-3 p-4 h-100">

                        <div class="text-muted small mb-3">
                            @Html.DisplayNameFor(model => model.Image)
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Image))
                        {
                            <div class="text-center">

                                <img src="@Model.Image" alt="@Model.Title" class="img-fluid rounded border bg-white" style="width: 100%;
                                max-height: 320px;
                                object-fit: cover;" />

                                <div class="text-muted small text-break mt-3">
                                    @Model.Image
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">

                                <i class="fa-solid fa-image fa-3x text-muted mb-3"></i>

                                <p class="text-muted mb-0">
                                    Slider görseli bulunmuyor.
                                </p>

                            </div>
                        }

                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">

                <a asp-action="Index" class="btn btn-outline-secondary px-4">

                    <i class="fa-solid fa-arrow-left me-2"></i>
                    Geri Dön

                </a>

                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">

                    <i class="fa-solid fa-pen-to-square me-2"></i>
                    Sliderı Düzenle

                </a>

            </div>

        </div>

    </div>

</div>