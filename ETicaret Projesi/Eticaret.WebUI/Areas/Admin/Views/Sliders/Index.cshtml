@model IEnumerable<Slider>

@{
    ViewData["Title"] = "Slider Yönetimi";
    Layout = "_LayoutAdmin";

    var sliderCount = Model?.Count() ?? 0;
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Slider Yönetimi
            </h1>

            <p class="text-muted mb-0">
                Ana sayfada gösterilecek slider alanlarını yönetebilirsiniz.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-success px-4 py-2">

            <i class="fa-solid fa-plus me-2"></i>
            Yeni Slider Ekle

        </a>

    </div>


    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center justify-content-between">

                    <div>

                        <p class="text-muted small mb-1">
                            Toplam Slider
                        </p>

                        <h3 class="fw-bold mb-0">
                            @sliderCount
                        </h3>

                    </div>

                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;">

                        <i class="fa-solid fa-images fs-5"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div>

                <h2 class="h5 fw-bold mb-1">
                    Slider Listesi
                </h2>

                <p class="text-muted small mb-0">
                    Sistemde kayıtlı slider görsellerini ve bağlantılarını görüntüleyebilirsiniz.
                </p>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model is null || !Model.Any())
            {
                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="fa-solid fa-images fa-3x text-muted"></i>

                    </div>

                    <h3 class="h5 fw-bold">
                        Henüz slider bulunmuyor
                    </h3>

                    <p class="text-muted">
                        Yeni bir slider ekleyerek başlayabilirsiniz.
                    </p>

                    <a asp-action="Create" class="btn btn-success">

                        <i class="fa-solid fa-plus me-2"></i>
                        Slider Ekle

                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Görsel
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.Title)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.Link)
                                </th>

                                <th class="text-end pe-4">
                                    İşlemler
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="ps-4">

                                        @if (!string.IsNullOrWhiteSpace(item.Image))
                                        {
                                            <img src="@item.Image" alt="@item.Title" class="rounded border bg-white"
                                                 style="width:140px;height:70px;object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted"
                                                 style="width:140px;height:70px;">

                                                <i class="fa-solid fa-image fs-4"></i>

                                            </div>
                                        }

                                    </td>


                                    <td>

                                        <div class="fw-semibold">
                                            @item.Title
                                        </div>

                                        <div class="text-muted small">
                                            Slider ID: @item.Id
                                        </div>

                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Link))
                                        {
                                            <span class="text-muted small">
                                                @item.Link
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Link bulunmuyor
                                            </span>
                                        }

                                    </td>


                                    <td class="text-end pe-4">

                                        <div class="btn-group" role="group">

                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-md btn-outline-primary" title="Detaylar">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>

                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-md btn-outline-warning"
                                               title="Düzenle">

                                                <i class="fa-solid fa-pen-to-square"></i>

                                            </a>

                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-md btn-outline-danger"
                                               title="Sil">

                                                <i class="fa-solid fa-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>