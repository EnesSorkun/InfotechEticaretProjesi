@model IEnumerable<Eticaret.Core.Entities.Product>

@{
    ViewData["Title"] = "Ürünler";
    Layout = "_LayoutAdmin";

    var productCount = Model?.Count() ?? 0;
    var activeProductCount = Model?.Count(x => x.IsActive) ?? 0;
    var homeProductCount = Model?.Count(x => x.IsHome) ?? 0;
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Ürün Yönetimi
            </h1>

            <p class="text-muted mb-0">
                Sistemde kayıtlı ürünleri görüntüleyebilir ve yönetebilirsiniz.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-success px-4 py-2">

            <i class="fa-solid fa-plus me-2"></i>
            Yeni Ürün Ekle

        </a>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center justify-content-between">

                    <div>
                        <p class="text-muted small mb-1">
                            Toplam Ürün
                        </p>

                        <h3 class="fw-bold mb-0">
                            @productCount
                        </h3>
                    </div>

                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;">

                        <i class="fa-solid fa-box fs-5"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-sm-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center justify-content-between">

                    <div>
                        <p class="text-muted small mb-1">
                            Aktif Ürün
                        </p>

                        <h3 class="fw-bold mb-0">
                            @activeProductCount
                        </h3>
                    </div>

                    <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;">

                        <i class="fa-solid fa-circle-check fs-5"></i>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-sm-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body d-flex align-items-center justify-content-between">

                    <div>
                        <p class="text-muted small mb-1">
                            Ana Sayfadaki Ürün
                        </p>

                        <h3 class="fw-bold mb-0">
                            @homeProductCount
                        </h3>
                    </div>

                    <div class="bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center"
                         style="width:48px;height:48px;">

                        <i class="fa-solid fa-house fs-5"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div>
                <h2 class="h5 fw-bold mb-1">
                    Ürün Listesi
                </h2>

                <p class="text-muted small mb-0">
                    Ürünlerin fiyat, stok, kategori, marka ve durum bilgileri
                </p>
            </div>

        </div>

        <div class="card-body p-0">

            @if (Model is null || !Model.Any())
            {
                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="fa-solid fa-box-open fa-3x text-muted"></i>
                    </div>

                    <h3 class="h5 fw-bold">
                        Henüz ürün bulunmuyor
                    </h3>

                    <p class="text-muted">
                        Yeni bir ürün ekleyerek başlayabilirsiniz.
                    </p>

                    <a asp-action="Create" class="btn btn-success">

                        <i class="fa-solid fa-plus me-2"></i>
                        Ürün Ekle

                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    Ürün
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.Price)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.Stock)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.Category)
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.Brand)
                                </th>

                                <th>
                                    Durum
                                </th>

                                <th>
                                    Ana Sayfa
                                </th>

                                <th>
                                    @Html.DisplayNameFor(model => model.CreateDate)
                                </th>

                                <th class="text-end pe-4">
                                    İşlemler
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <div class="d-flex align-items-center gap-3">

                                            @if (!string.IsNullOrWhiteSpace(item.Image))
                                            {
                                                <img src="@item.Image" alt="@item.Name" class="rounded border bg-white"
                                                     style="width:64px;height:52px;object-fit:contain;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted"
                                                     style="width:64px;height:52px;">

                                                    <i class="fa-solid fa-image"></i>

                                                </div>
                                            }

                                            <div>

                                                <div class="fw-semibold">
                                                    @item.Name
                                                </div>

                                                <div class="text-muted small">
                                                    @(string.IsNullOrWhiteSpace(item.ProductCode)
                                                        ? $"Ürün ID: {item.Id}"
                                                        : item.ProductCode)
                                                </div>

                                            </div>

                                        </div>

                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @item.Price.ToString("N2") ₺
                                        </span>
                                    </td>

                                    <td>

                                        @if (item.Stock <= 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-3 py-2">
                                                Stok Yok
                                            </span>
                                        }
                                        else if (item.Stock <= 5)
                                        {
                                            <span class="badge bg-warning-subtle text-warning px-3 py-2">
                                                @item.Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2">
                                                @item.Stock
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @(item.Category?.Name ?? "Kategori Yok")
                                    </td>

                                    <td>
                                        @(item.Brand?.Name ?? "Marka Yok")
                                    </td>

                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                                <i class="fa-solid fa-circle-check me-1"></i>
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                                Pasif
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (item.IsHome)
                                        {
                                            <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">
                                                <i class="fa-solid fa-house me-1"></i>
                                                Gösteriliyor
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">
                                                <i class="fa-solid fa-eye-slash me-1"></i>
                                                Gizli
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <div class="fw-medium">
                                            @(item.CreateDate.ToLocalTime().ToString("dd.MM.yyyy"))
                                        </div>

                                        <div class="text-muted small">
                                            @(item.CreateDate.ToLocalTime().ToString("HH:mm"))
                                        </div>

                                    </td>

                                    <td class="text-end pe-4">

                                        <div class="btn-group" role="group">

                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-md btn-outline-primary" title="Detaylar">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>

                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-md btn-outline-warning"
                                               title="Düzenle">

                                                <i class="fa-solid fa-pen-to-square"></i>

                                            </a>

                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-md btn-outline-danger"
                                               title="Sil">

                                                <i class="fa-solid fa-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>