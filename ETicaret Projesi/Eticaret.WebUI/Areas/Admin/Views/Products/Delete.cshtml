@model Eticaret.Core.Entities.Product

@{
    ViewData["Title"] = "Ürün Sil";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Ürün Sil
            </h1>

            <p class="text-muted mb-0">
                Seçilen ürünü sistemden silebilirsiniz.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Ürünlere Dön
        </a>

    </div>

    <div class="alert alert-danger border-0 shadow-sm mb-4">

        <div class="d-flex align-items-start gap-3">

            <div class="fs-4">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div>
                <h2 class="h5 fw-bold mb-1">
                    Bu ürünü silmek istediğinize emin misiniz?
                </h2>

                <p class="mb-0">
                    Bu işlem ürünü sistemden kalıcı olarak kaldıracaktır.
                    Silme işlemi geri alınamaz.
                </p>
            </div>

        </div>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex align-items-center gap-3">

                <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center"
                     style="width: 46px; height: 46px;">
                    <i class="fa-solid fa-trash"></i>
                </div>

                <div>
                    <h2 class="h5 fw-bold mb-1">
                        @Model.Name
                    </h2>

                    <p class="text-muted small mb-0">
                        @(string.IsNullOrWhiteSpace(Model.ProductCode)
                            ? $"Ürün ID: {Model.Id}"
                            : $"Ürün Kodu: {Model.ProductCode}")
                    </p>
                </div>

            </div>

        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-lg-8">

                    <div class="row g-4">

                        <div class="col-12">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.Name)
                                </div>

                                <div class="fw-semibold fs-5">
                                    @Model.Name
                                </div>

                            </div>

                        </div>

                        <div class="col-12">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-2">
                                    @Html.DisplayNameFor(model => model.Description)
                                </div>

                                @if (string.IsNullOrWhiteSpace(Model.Description))
                                {
                                    <span class="text-muted">
                                        Açıklama bulunmuyor.
                                    </span>
                                }
                                else
                                {
                                    <p class="mb-0">
                                        @Model.Description
                                    </p>
                                }

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.Price)
                                </div>

                                <div class="fw-bold fs-5">
                                    @Model.Price.ToString("N2") ₺
                                </div>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.Stock)
                                </div>

                                <div class="fw-semibold">
                                    @Model.Stock adet
                                </div>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.OrderNo)
                                </div>

                                <div class="fw-semibold">
                                    @Model.OrderNo
                                </div>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.Category)
                                </div>

                                <div class="fw-semibold">
                                    @(Model.Category?.Name ?? "Kategori bulunmuyor")
                                </div>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.Brand)
                                </div>

                                <div class="fw-semibold">
                                    @(Model.Brand?.Name ?? "Marka bulunmuyor")
                                </div>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-2">
                                    @Html.DisplayNameFor(model => model.IsActive)
                                </div>

                                @if (Model.IsActive)
                                {
                                    <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                        <i class="fa-solid fa-circle-check me-1"></i>
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                                        <i class="fa-solid fa-circle-xmark me-1"></i>
                                        Pasif
                                    </span>
                                }

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-2">
                                    @Html.DisplayNameFor(model => model.IsHome)
                                </div>

                                @if (Model.IsHome)
                                {
                                    <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">
                                        <i class="fa-solid fa-house me-1"></i>
                                        Ana Sayfada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">
                                        <i class="fa-solid fa-eye-slash me-1"></i>
                                        Gizli
                                    </span>
                                }

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.CreateDate)
                                </div>

                                <div class="fw-semibold">
                                    @(Model.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-lg-4">

                    <div class="border rounded-3 p-4 h-100">

                        <div class="text-muted small mb-3">
                            @Html.DisplayNameFor(model => model.Image)
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Image))
                        {
                            <div class="text-center">

                                <img src="@Model.Image" alt="@Model.Name" class="img-fluid rounded border bg-white p-2"
                                     style="width: 100%; max-height: 320px; object-fit: contain;" />

                                <div class="text-muted small text-break mt-3">
                                    @Model.Image
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">

                                <i class="fa-solid fa-image fa-3x text-muted mb-3"></i>

                                <p class="text-muted mb-0">
                                    Ürün görseli bulunmuyor.
                                </p>

                            </div>
                        }

                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">

                    <a asp-action="Index" class="btn btn-outline-secondary px-4">

                        <i class="fa-solid fa-xmark me-2"></i>
                        Vazgeç

                    </a>

                    <button type="submit" class="btn btn-danger px-4">

                        <i class="fa-solid fa-trash me-2"></i>
                        Ürünü Sil

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>