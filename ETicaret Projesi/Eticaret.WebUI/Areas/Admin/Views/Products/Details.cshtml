@model Eticaret.Core.Entities.Product

@{
    ViewData["Title"] = "Ürün Detayları";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Ürün Detayları
            </h1>

            <p class="text-muted mb-0">
                Ürüne ait tüm bilgileri görüntüleyebilirsiniz.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Ürünlere Dön
            </a>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fa-solid fa-pen-to-square me-2"></i>
                Düzenle
            </a>

        </div>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex align-items-center gap-3">

                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                     style="width: 46px; height: 46px;">
                    <i class="fa-solid fa-box"></i>
                </div>

                <div>
                    <h2 class="h5 fw-bold mb-1">
                        @Model.Name
                    </h2>

                    <p class="text-muted small mb-0">
                        @(string.IsNullOrWhiteSpace(Model.ProductCode)
                            ? $"Ürün ID: {Model.Id}"
                            : $"Ürün Kodu: {Model.ProductCode}")
                    </p>
                </div>

            </div>

        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-lg-8">

                    <div class="row g-4">

                        <div class="col-12">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.Name)
                                </div>

                                <div class="fw-semibold fs-5">
                                    @Model.Name
                                </div>

                            </div>

                        </div>

                        <div class="col-12">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-2">
                                    @Html.DisplayNameFor(model => model.Description)
                                </div>

                                @if (string.IsNullOrWhiteSpace(Model.Description))
                                {
                                    <span class="text-muted">
                                        Açıklama bulunmuyor.
                                    </span>
                                }
                                else
                                {
                                    <p class="mb-0">
                                        @Model.Description
                                    </p>
                                }

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.Price)
                                </div>

                                <div class="fw-bold fs-5">
                                    @Model.Price.ToString("N2") ₺
                                </div>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.Stock)
                                </div>

                                @if (Model.Stock <= 0)
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2">
                                        Stok Yok
                                    </span>
                                }
                                else if (Model.Stock <= 5)
                                {
                                    <span class="badge bg-warning-subtle text-warning px-3 py-2">
                                        @Model.Stock adet
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-2">
                                        @Model.Stock adet
                                    </span>
                                }

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.OrderNo)
                                </div>

                                <div class="fw-semibold">
                                    @Model.OrderNo
                                </div>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.Category)
                                </div>

                                <div class="fw-semibold">
                                    @(Model.Category?.Name ?? "Kategori bulunmuyor")
                                </div>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.Brand)
                                </div>

                                <div class="fw-semibold">
                                    @(Model.Brand?.Name ?? "Marka bulunmuyor")
                                </div>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-2">
                                    @Html.DisplayNameFor(model => model.IsActive)
                                </div>

                                @if (Model.IsActive)
                                {
                                    <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                        <i class="fa-solid fa-circle-check me-1"></i>
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                                        <i class="fa-solid fa-circle-xmark me-1"></i>
                                        Pasif
                                    </span>
                                }

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-2">
                                    @Html.DisplayNameFor(model => model.IsHome)
                                </div>

                                @if (Model.IsHome)
                                {
                                    <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">
                                        <i class="fa-solid fa-house me-1"></i>
                                        Ana Sayfada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">
                                        <i class="fa-solid fa-eye-slash me-1"></i>
                                        Gizli
                                    </span>
                                }

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="border rounded-3 p-3 h-100">

                                <div class="text-muted small mb-1">
                                    @Html.DisplayNameFor(model => model.CreateDate)
                                </div>

                                <div class="fw-semibold">
                                    @(Model.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-lg-4">

                    <div class="border rounded-3 p-4 h-100">

                        <div class="text-muted small mb-3">
                            @Html.DisplayNameFor(model => model.Image)
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Image))
                        {
                            <div class="text-center">

                                <img src="@Model.Image" alt="@Model.Name" class="img-fluid rounded border bg-white p-2"
                                     style="width: 100%; max-height: 320px; object-fit: contain;" />

                                <div class="text-muted small text-break mt-3">
                                    @Model.Image
                                </div>

                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">

                                <i class="fa-solid fa-image fa-3x text-muted mb-3"></i>

                                <p class="text-muted mb-0">
                                    Ürün görseli bulunmuyor.
                                </p>

                            </div>
                        }

                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">

                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="fa-solid fa-arrow-left me-2"></i>
                    Geri Dön
                </a>

                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">
                    <i class="fa-solid fa-pen-to-square me-2"></i>
                    Ürünü Düzenle
                </a>

            </div>

        </div>

    </div>

</div>