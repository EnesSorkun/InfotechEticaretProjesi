@model Eticaret.WebUI.Areas.Admin.Models.ProductImageFormViewModel

@{
    ViewData["Title"] = "Ürün Resmi Ekle";
}

<div class="container">

    <div class="card shadow-sm">

        <div class="card-header">
            <h4 class="mb-0">
                Ürüne Resim Ekle
            </h4>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post" enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="ProductId" class="form-label">
                    </label>

                    <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select">

                        <option value="">
                            Ürün Seçiniz
                        </option>

                    </select>

                    <span asp-validation-for="ProductId" class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="ImageFile" class="form-label">
                    </label>

                    <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />

                    <span asp-validation-for="ImageFile" class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="OrderNo" class="form-label">
                    </label>

                    <input asp-for="OrderNo" class="form-control" />

                </div>

                <div class="form-check mb-4">

                    <input asp-for="IsMain" class="form-check-input" />

                    <label asp-for="IsMain" class="form-check-label">
                    </label>

                </div>

                <button type="submit" class="btn btn-success">
                    Kaydet
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Geri Dön
                </a>

            </form>

        </div>

    </div>

</div>