@model Brand

@{
    ViewData["Title"] = "Marka Detayı";
    Layout = "_LayoutAdmin";

    var firstLetter = string.IsNullOrWhiteSpace(Model.Name)
        ? "?"
        : Model.Name.Substring(0, 1).ToUpper();
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Marka Detayı
            </h1>

            <p class="text-muted mb-0">
                Markaya ait bilgileri görüntüleyebilirsiniz.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-2"></i>
                Markalara Dön
            </a>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fa-solid fa-pen-to-square me-2"></i>
                Düzenle
            </a>

        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center p-4">

                    <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold mx-auto mb-3"
                         style="width:90px;height:90px;font-size:2rem;">

                        @firstLetter

                    </div>

                    <h2 class="h4 fw-bold mb-2">
                        @Model.Name
                    </h2>

                    @if (Model.IsActive)
                    {
                        <span class="badge rounded-pill bg-success px-3 py-2">
                            <i class="fa-solid fa-circle-check me-1"></i>
                            Aktif
                        </span>
                    }
                    else
                    {
                        <span class="badge rounded-pill bg-danger px-3 py-2">
                            <i class="fa-solid fa-circle-xmark me-1"></i>
                            Pasif
                        </span>
                    }

                </div>

            </div>

        </div>

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex align-items-center gap-3">

                        <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center"
                             style="width:44px;height:44px;">
                            <i class="fa-solid fa-tag"></i>
                        </div>

                        <div>

                            <h2 class="h5 fw-bold mb-1">
                                Marka Bilgileri
                            </h2>

                            <p class="text-muted small mb-0">
                                Marka hakkında kayıtlı bilgiler
                            </p>

                        </div>

                    </div>

                </div>

                <div class="card-body p-4">

                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <span class="text-muted small d-block mb-1">
                                    @Html.DisplayNameFor(x => x.Name)
                                </span>

                                <span class="fw-semibold">
                                    @Model.Name
                                </span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <span class="text-muted small d-block mb-1">
                                    @Html.DisplayNameFor(x => x.OrderNo)
                                </span>

                                <span class="fw-semibold">
                                    @Model.OrderNo
                                </span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <span class="text-muted small d-block mb-2">
                                    @Html.DisplayNameFor(x => x.Logo)
                                </span>

                                @if (!string.IsNullOrWhiteSpace(Model.Logo))
                                {
                                    <img src="@Model.Logo" class="img-fluid rounded border p-2 bg-white"
                                         style="max-height:120px; object-fit:contain;" />
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Logo bulunmuyor.
                                    </span>
                                }

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <span class="text-muted small d-block mb-1">
                                    @Html.DisplayNameFor(x => x.CreateDate)
                                </span>

                                <span class="fw-semibold">
                                    @Model.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>