@model Brand

@{
    ViewData["Title"] = "Marka Düzenle";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                Marka Düzenle
            </h1>

            <p class="text-muted mb-0">
                Marka bilgilerini ve logosunu güncelleyebilirsiniz.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Markalara Dön
        </a>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex align-items-center gap-3">

                <div class="bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center"
                     style="width: 46px; height: 46px;">
                    <i class="fa-solid fa-pen-to-square"></i>
                </div>

                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Marka Bilgileri
                    </h2>

                    <p class="text-muted small mb-0">
                        @Model.Name
                    </p>
                </div>

            </div>

        </div>

        <div class="card-body p-4">

            <form asp-action="Edit" method="post" enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                </div>

                <input type="hidden" asp-for="Id" />

                <div class="row g-4">

                    <div class="col-md-8">

                        <label asp-for="Name" class="form-label fw-semibold">
                        </label>

                        <input asp-for="Name" class="form-control form-control-lg" placeholder="Marka adını giriniz" />

                        <span asp-validation-for="Name" class="text-danger small"></span>

                    </div>

                    <div class="col-md-4">

                        <label asp-for="OrderNo" class="form-label fw-semibold">
                        </label>

                        <input asp-for="OrderNo" type="number" min="0" class="form-control form-control-lg"
                               placeholder="Sıra numarası" />

                        <span asp-validation-for="OrderNo" class="text-danger small"></span>

                    </div>

                    <div class="col-12">

                        <label class="form-label fw-semibold">
                            Mevcut Logo
                        </label>

                        <div class="border rounded-3 p-3 bg-light">

                            @if (!string.IsNullOrWhiteSpace(Model.Logo))
                            {
                                <div class="d-flex flex-column flex-md-row align-items-md-center gap-3">

                                    <img src="@Model.Logo" alt="@Model.Name" class="rounded border bg-white p-2"
                                         style="width: 160px; height: 100px; object-fit: contain;" />

                                    <div>
                                        <div class="fw-semibold">
                                            Mevcut logo
                                        </div>

                                        <div class="text-muted small text-break">
                                            @Model.Logo
                                        </div>
                                    </div>

                                </div>
                            }
                            else
                            {
                                <div class="text-muted">
                                    <i class="fa-solid fa-image me-2"></i>
                                    Bu marka için henüz logo yüklenmemiş.
                                </div>
                            }

                        </div>

                    </div>

                    <div class="col-12">

                        <label class="form-label fw-semibold">
                            Yeni Logo
                        </label>

                        <div class="input-group input-group-lg">

                            <span class="input-group-text">
                                <i class="fa-solid fa-upload"></i>
                            </span>

                            <input type="file" name="logoFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />

                        </div>

                        <span asp-validation-for="Logo" class="text-danger small"></span>

                        <div class="form-text">
                            Yeni bir dosya seçmezseniz mevcut logo korunur.
                            JPG, JPEG, PNG veya WEBP formatında en fazla 2 MB dosya yükleyebilirsiniz.
                        </div>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="border rounded-3 p-3 h-100">

                            <div class="form-check form-switch mb-0">

                                <input asp-for="IsActive" class="form-check-input" role="switch" />

                                <label asp-for="IsActive" class="form-check-label fw-semibold">
                                </label>

                            </div>

                            <p class="text-muted small mb-0 mt-2">
                                Pasif markalar kullanıcı tarafında görüntülenmez.
                            </p>

                        </div>

                    </div>

                    <div class="col-md-6">

                        <div class="border rounded-3 p-3 h-100">

                            <span class="text-muted small d-block mb-1">
                                Kayıt Tarihi
                            </span>

                            <span class="fw-semibold">
                                @Model.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </span>

                        </div>

                    </div>

                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">

                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        İptal
                    </a>

                    <button type="submit" class="btn btn-warning px-4">

                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Değişiklikleri Kaydet

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}