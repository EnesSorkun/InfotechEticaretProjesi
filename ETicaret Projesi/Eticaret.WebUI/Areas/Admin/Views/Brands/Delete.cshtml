@model Brand

@{
    ViewData["Title"] = "Marka Sil";
    Layout = "_LayoutAdmin";

    var firstLetter = string.IsNullOrWhiteSpace(Model.Name)
        ? "?"
        : Model.Name.Substring(0, 1).ToUpper();
}

<div class="container-fluid px-4 py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold text-danger mb-1">
                Marka Sil
            </h1>

            <p class="text-muted mb-0">
                Seçilen markayı sistemden kalıcı olarak silebilirsiniz.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Markalara Dön
        </a>

    </div>

    <div class="alert alert-danger border-0 shadow-sm mb-4" role="alert">

        <div class="d-flex align-items-start gap-3">

            <div class="fs-2">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div>
                <h2 class="h5 fw-bold mb-2">
                    Bu işlem geri alınamaz
                </h2>

                <p class="mb-0">
                    Marka ve markaya ait logo dosyası kalıcı olarak silinecektir.
                    Devam etmek istediğinizden emin olun.
                </p>
            </div>

        </div>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex align-items-center gap-3">

                <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center"
                     style="width: 46px; height: 46px;">
                    <i class="fa-solid fa-trash"></i>
                </div>

                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Silinecek Marka
                    </h2>

                    <p class="text-muted small mb-0">
                        Silmeden önce marka bilgilerini kontrol ediniz.
                    </p>
                </div>

            </div>

        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-lg-4">

                    <div class="border rounded-3 p-4 text-center h-100">

                        @if (!string.IsNullOrWhiteSpace(Model.Logo))
                        {
                            <img src="@Model.Logo" alt="@Model.Name" class="img-fluid rounded border bg-white p-2 mb-3"
                                 style="width: 180px; height: 120px; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center fw-bold mx-auto mb-3"
                                 style="width: 90px; height: 90px; font-size: 2rem;">
                                @firstLetter
                            </div>
                        }

                        <h3 class="h4 fw-bold mb-2">
                            @Model.Name
                        </h3>

                        @if (Model.IsActive)
                        {
                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                <i class="fa-solid fa-circle-check me-1"></i>
                                Aktif
                            </span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                Pasif
                            </span>
                        }

                    </div>

                </div>

                <div class="col-lg-8">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <span class="text-muted small d-block mb-1">
                                    @Html.DisplayNameFor(model => model.Name)
                                </span>

                                <span class="fw-semibold">
                                    @Model.Name
                                </span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <span class="text-muted small d-block mb-1">
                                    @Html.DisplayNameFor(model => model.OrderNo)
                                </span>

                                <span class="fw-semibold">
                                    @Model.OrderNo
                                </span>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <span class="text-muted small d-block mb-1">
                                    @Html.DisplayNameFor(model => model.IsActive)
                                </span>

                                @if (Model.IsActive)
                                {
                                    <span class="text-success fw-semibold">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger fw-semibold">
                                        Pasif
                                    </span>
                                }

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3 h-100">

                                <span class="text-muted small d-block mb-1">
                                    @Html.DisplayNameFor(model => model.CreateDate)
                                </span>

                                <span class="fw-semibold">
                                    @Model.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </span>

                            </div>

                        </div>

                        <div class="col-12">

                            <div class="border rounded-3 p-3">

                                <span class="text-muted small d-block mb-1">
                                    @Html.DisplayNameFor(model => model.Logo)
                                </span>

                                <span class="fw-semibold text-break">
                                    @(string.IsNullOrWhiteSpace(Model.Logo)
                                        ? "Logo bulunmuyor"
                                        : Model.Logo)
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">

                    <a asp-action="Index" class="btn btn-outline-secondary px-4">

                        <i class="fa-solid fa-xmark me-2"></i>
                        Vazgeç

                    </a>

                    <button type="submit" class="btn btn-danger px-4">

                        <i class="fa-solid fa-trash me-2"></i>
                        Markayı Kalıcı Olarak Sil

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>