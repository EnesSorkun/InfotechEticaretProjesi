@model Eticaret.WebUI.Areas.Admin.Models.AdminDashboardViewModel
@using Eticaret.Core.Enums
@{
    ViewData["Title"] = "Admin Anasayfa";
}

<!-- =====================================================
     KAYITLI KULLANICI SAYISI
     ===================================================== -->

<div class="row mb-4">

    <div class="col-xl-4 col-md-6">

        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <div class="d-flex
                    justify-content-between
                    align-items-center">

                    <div>

                        <div class="text-muted mb-1">
                            Kayıtlı Kullanıcı
                        </div>

                        <h2 class="fw-bold mb-0">
                            @Model.UserCount
                        </h2>

                    </div>


                    <div class="bg-primary-subtle
                        text-primary
                        rounded-circle
                        d-flex
                        align-items-center
                        justify-content-center" style="width:60px;height:60px;">

                        <i class="fas fa-users fa-lg"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- =====================================================
     SİPARİŞLER
     ===================================================== -->

<div class="card mb-4">

    <div class="card-header fw-semibold">

        <i class="fas fa-shopping-cart me-2"></i>

        Siparişler

    </div>

    <div class="card-body">

        <table id="ordersTable" class="table table-striped table-hover align-middle">

            <thead>

                <tr>

                    <th>Sipariş No</th>
                    <th>Müşteri</th>
                    <th>Tarih</th>
                    <th>Tutar</th>
                    <th>Durum</th>
                    <th>İşlem</th>

                </tr>

            </thead>


            <tbody>

                @foreach (var order in Model.Orders)
                {
                    <tr>

                        <td>
                            <strong>
                                @order.OrderNumber
                            </strong>
                        </td>


                        <td>

                            @if (order.AppUser is not null)
                            {
                                <div class="fw-semibold">

                                    @order.AppUser.Name
                                    @order.AppUser.Surname

                                </div>

                                <small class="text-muted">

                                    @order.AppUser.Email

                                </small>
                            }

                        </td>


                        <td>

                            @(order.OrderDate
                                .ToLocalTime()
                                .ToString("dd.MM.yyyy HH:mm"))

                        </td>


                        <td>

                            <strong>
                                @order.TotalPrice.ToString("N2") ₺
                            </strong>

                        </td>


                        <td>

                            @switch (order.Status)
                            {
                                case OrderStatus.PendingApproval:

                                    <span class="badge bg-warning text-dark">
                                        Onay Bekliyor
                                    </span>

                                    break;


                                case OrderStatus.Approved:

                                    <span class="badge bg-primary">
                                        Onaylandı
                                    </span>

                                    break;


                                case OrderStatus.Preparing:

                                    <span class="badge bg-info text-dark">
                                        Hazırlanıyor
                                    </span>

                                    break;


                                case OrderStatus.Shipped:

                                    <span class="badge bg-secondary">
                                        Kargoya Verildi
                                    </span>

                                    break;


                                case OrderStatus.Delivered:

                                    <span class="badge bg-success">
                                        Teslim Edildi
                                    </span>

                                    break;


                                case OrderStatus.Cancelled:

                                    <span class="badge bg-danger">
                                        İptal Edildi
                                    </span>

                                    break;
                            }

                        </td>


                        <td>

                            <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id"
                               class="btn btn-sm btn-outline-primary">

                                <i class="fas fa-eye me-1"></i>

                                Detay

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

<!-- =====================================================
     ÜRÜNLER
     ===================================================== -->

<div class="card mb-4">

    <div class="card-header fw-semibold">

        <i class="fas fa-box me-2"></i>

        Ürünler

    </div>

    <div class="card-body">

        <table id="productsTable" class="table table-striped table-hover align-middle">

            <thead>

                <tr>

                    <th>Resim</th>
                    <th>Ürün</th>
                    <th>Kategori</th>
                    <th>Marka</th>
                    <th>Fiyat</th>
                    <th>Stok</th>
                    <th>Durum</th>
                    <th>İşlem</th>

                </tr>

            </thead>


            <tbody>

                @foreach (var product in Model.Products)
                {
                    <tr>

                        <!-- RESİM -->

                        <td>

                            @if (!string.IsNullOrWhiteSpace(product.Image))
                            {
                                <img src="@product.Image" alt="@product.Name" class="rounded border" style="
                                width:70px;
                                height:55px;
                                object-fit:contain;
                                " />
                            }
                            else
                            {
                                <span class="text-muted">
                                    Resim Yok
                                </span>
                            }

                        </td>


                        <!-- ÜRÜN -->

                        <td>

                            <div class="fw-semibold">
                                @product.Name
                            </div>

                            <small class="text-muted">
                                @product.ProductCode
                            </small>

                        </td>


                        <!-- KATEGORİ -->

                        <td>
                            @(product.Category?.Name ?? "-")
                        </td>


                        <!-- MARKA -->

                        <td>
                            @(product.Brand?.Name ?? "-")
                        </td>


                        <!-- FİYAT -->

                        <td>

                            <strong>
                                @product.Price.ToString("N2") ₺
                            </strong>

                        </td>


                        <!-- STOK -->

                        <td>

                            @if (product.Stock <= 0)
                            {
                                <span class="badge bg-danger">
                                    Stok Yok
                                </span>
                            }
                            else if (product.Stock <= 5)
                            {
                                <span class="badge bg-warning text-dark">

                                    @product.Stock adet

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">

                                    @product.Stock adet

                                </span>
                            }

                        </td>


                        <!-- DURUM -->

                        <td>

                            @if (product.IsActive)
                            {
                                <span class="badge bg-success">
                                    Aktif
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Pasif
                                </span>
                            }

                        </td>


                        <!-- İŞLEM -->

                        <td>

                            <a asp-area="Admin" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                               class="btn btn-sm btn-outline-primary">

                                <i class="fas fa-eye me-1"></i>

                                Detay

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts
{
    <script>

        window.addEventListener(
            "DOMContentLoaded",
            function () {

                // Sipariş DataTable
                const ordersTable =
                    document.getElementById("ordersTable");

                if (ordersTable) {
                    new simpleDatatables.DataTable(
                        ordersTable
                    );
                }


                // Ürün DataTable
                const productsTable =
                    document.getElementById("productsTable");

                if (productsTable) {
                    new simpleDatatables.DataTable(
                        productsTable
                    );
                }

            }
        );

    </script>
}
