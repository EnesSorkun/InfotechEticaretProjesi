@using Eticaret.Service.Concrete
@using Eticaret.WebUI.ExtensionMethods
@using Eticaret.WebUI.Models

@{
    // =====================================================
    // FAVORİ SAYISI
    // =====================================================
    var favoriteProducts =
        Context.Session
            .GetJson<List<FavoriteProductViewModel>>("Favorites")
        ?? new List<FavoriteProductViewModel>();

    var favoriteCount =
        User.Identity?.IsAuthenticated == true
            ? favoriteProducts.Count
            : 0;


    // =====================================================
    // SEPET SAYISI
    // =====================================================
    var cart =
        Context.Session
            .GetJson<CartService>("Cart")
        ?? new CartService();

    // Sepette kaç FARKLI ürün olduğunu gösteriyoruz.
    var cartCount =
        User.Identity?.IsAuthenticated == true
            ? cart.CartLines.Count
            : 0;
}


<header class="site-header">

    <!-- =====================================================
         ÜST HEADER
         ===================================================== -->
    <div class="header-main">

        <div class="container">

            <div class="header-main-inner">

                <!-- =================================================
                     LOGO
                     ================================================= -->
                <a class="site-logo" asp-area="" asp-controller="Home" asp-action="Index">

                    <span class="site-logo-icon">
                        <i class="fa-solid fa-gem"></i>
                    </span>

                    <span class="site-logo-text">

                        <span class="logo-main">
                            Kehr-i
                        </span>

                        <span class="logo-sub">
                            Bar
                        </span>

                    </span>

                </a>


                <!-- =================================================
                     DESKTOP ARAMA
                     ================================================= -->
                <form asp-area="" asp-controller="Products" asp-action="Index" method="get"
                      class="header-search d-none d-md-flex">

                    <div class="header-search-box">

                        <span class="header-search-icon">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>

                        <input type="text" name="search" class="form-control" placeholder="Ara..." autocomplete="off" />

                        <button class="search-button" type="submit">

                            <span>
                                Ara
                            </span>

                            <i class="fa-solid fa-arrow-right"></i>

                        </button>

                    </div>

                </form>


                <!-- =================================================
                     SAĞ ALAN
                     ================================================= -->
                <div class="header-actions">

                    <!-- =============================================
                         HESABIM
                         ============================================= -->
                    <div class="dropdown">

                        <button class="header-action" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                                title="Hesabım">

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <i class="fa-solid fa-user"></i>
                            }
                            else
                            {
                                <i class="fa-regular fa-user"></i>
                            }

                        </button>


                        <ul class="dropdown-menu dropdown-menu-end account-dropdown">

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <!-- =====================================
                                     KULLANICI
                                     ===================================== -->
                                <li class="account-user-header">

                                    <div class="account-avatar">

                                        <i class="fa-solid fa-user"></i>

                                    </div>


                                    <div class="account-user-info">

                                        <small>
                                            HOŞ GELDİNİZ
                                        </small>

                                        <strong>
                                            @User.Identity.Name
                                        </strong>


                                        @if (User.IsInRole("Admin"))
                                        {
                                            <span class="account-role admin-role">

                                                <i class="fa-solid fa-shield-halved"></i>

                                                Yönetici

                                            </span>
                                        }
                                        else if (User.IsInRole("Customer"))
                                        {
                                            <span class="account-role customer-role">

                                                <i class="fa-regular fa-user"></i>

                                                Müşteri

                                            </span>
                                        }

                                    </div>

                                </li>


                                <li>
                                    <hr class="dropdown-divider" />
                                </li>


                                <!-- =====================================
                                     KULLANICI BİLGİLERİM
                                     ===================================== -->
                                <li>

                                    <a class="dropdown-item account-menu-item" asp-area="" asp-controller="Account"
                                       asp-action="Profile">

                                        <span class="account-menu-icon">
                                            <i class="fa-regular fa-user"></i>
                                        </span>

                                        <span>
                                            Kullanıcı Bilgilerim
                                        </span>

                                        <i class="fa-solid fa-chevron-right account-menu-arrow"></i>

                                    </a>

                                </li>


                                <!-- =====================================
                                     SİPARİŞLERİM
                                     ===================================== -->
                                <li>

                                    <a class="dropdown-item account-menu-item" asp-area="" asp-controller="Orders"
                                       asp-action="Index">

                                        <span class="account-menu-icon">
                                            <i class="fa-solid fa-box"></i>
                                        </span>

                                        <span>
                                            Siparişlerim
                                        </span>

                                        <i class="fa-solid fa-chevron-right account-menu-arrow"></i>

                                    </a>

                                </li>


                                <!-- =====================================
                                     ADRESLERİM
                                     ===================================== -->
                                <li>

                                    <a class="dropdown-item account-menu-item" asp-area="" asp-controller="Addresses"
                                       asp-action="Index">

                                        <span class="account-menu-icon">
                                            <i class="fa-solid fa-location-dot"></i>
                                        </span>

                                        <span>
                                            Adreslerim
                                        </span>

                                        <i class="fa-solid fa-chevron-right account-menu-arrow"></i>

                                    </a>

                                </li>


                                <!-- =====================================
                                     ADMIN
                                     ===================================== -->
                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>


                                    <li>

                                        <a class="dropdown-item account-menu-item admin-menu-item" asp-area="Admin"
                                           asp-controller="Main" asp-action="Index" target="_blank">

                                            <span class="account-menu-icon admin-menu-icon">
                                                <i class="fa-solid fa-gauge-high"></i>
                                            </span>

                                            <span>
                                                Admin Paneli
                                            </span>

                                            <i class="fa-solid fa-arrow-up-right-from-square account-menu-arrow"></i>

                                        </a>

                                    </li>
                                }


                                <li>
                                    <hr class="dropdown-divider" />
                                </li>


                                <!-- =====================================
                                     ÇIKIŞ
                                     ===================================== -->
                                <li>

                                    <form asp-area="" asp-controller="Account" asp-action="SignOut" method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="dropdown-item account-menu-item logout-item">

                                            <span class="account-menu-icon">
                                                <i class="fa-solid fa-right-from-bracket"></i>
                                            </span>

                                            <span>
                                                Oturumu Kapat
                                            </span>

                                        </button>

                                    </form>

                                </li>
                            }
                            else
                            {
                                <!-- =====================================
                                     MİSAFİR KULLANICI
                                     ===================================== -->
                                <li class="account-guest-header">

                                    <div class="guest-header-icon">

                                        <i class="fa-regular fa-user"></i>

                                    </div>


                                    <div>

                                        <span>
                                            HESABIM
                                        </span>

                                        <strong>
                                            Hoş Geldiniz
                                        </strong>

                                        <p>
                                            Hesabınıza giriş yapın veya
                                            yeni hesap oluşturun.
                                        </p>

                                    </div>

                                </li>


                                <li>
                                    <hr class="dropdown-divider" />
                                </li>


                                <li class="account-auth-item">

                                    <a asp-area="" asp-controller="Account" asp-action="SignIn"
                                       class="account-login-button">

                                        <i class="fa-solid fa-right-to-bracket"></i>

                                        <span>
                                            Giriş Yap
                                        </span>

                                    </a>

                                </li>


                                <li class="account-auth-item">

                                    <a asp-area="" asp-controller="Account" asp-action="SignUp"
                                       class="account-register-button">

                                        <i class="fa-solid fa-user-plus"></i>

                                        <span>
                                            Kayıt Ol
                                        </span>

                                    </a>

                                </li>
                            }

                        </ul>

                    </div>


                    <!-- =============================================
                         FAVORİLER
                         ============================================= -->
                    <a asp-area="" asp-controller="Favorites" asp-action="Index" class="header-action position-relative"
                       title="Favorilerim">

                        @if (favoriteCount > 0)
                        {
                            <i class="fa-solid fa-heart favorite-active"></i>
                        }
                        else
                        {
                            <i class="fa-regular fa-heart"></i>
                        }

                        @if (favoriteCount > 0)
                        {
                            <span class="action-badge favorite-badge">
                                @favoriteCount
                            </span>
                        }

                    </a>


                    <!-- =============================================
                         SEPET
                         ============================================= -->
                    <a asp-area="" asp-controller="Cart" asp-action="Index" class="header-action position-relative"
                       title="Sepetim">

                        <i class="fa-solid fa-bag-shopping"></i>

                        @if (cartCount > 0)
                        {
                            <span class="action-badge">
                                @cartCount
                            </span>
                        }

                    </a>

                </div>

            </div>


            <!-- =================================================
                 MOBİL ARAMA
                 ================================================= -->
            <form asp-area="" asp-controller="Products" asp-action="Index" method="get"
                  class="header-search mobile-header-search d-flex d-md-none">

                <div class="header-search-box">

                    <span class="header-search-icon">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>

                    <input type="text" name="search" class="form-control" placeholder="Ürün ara..."
                           autocomplete="off" />

                    <button class="search-button" type="submit">

                        <i class="fa-solid fa-magnifying-glass"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- =========================================================
         ALT NAVBAR
         ========================================================= -->
    <nav class="header-navigation navbar navbar-expand-lg">

        <div class="container">

            <button class="navbar-toggler header-navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Menüyü Aç">

                <i class="fa-solid fa-bars"></i>

                <span>
                    Menü
                </span>

            </button>


            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav header-nav-list">

                    <!-- =========================================
                         ANASAYFA
                         ========================================= -->
                    <li class="nav-item">

                        <a class="nav-link header-nav-link" asp-area="" asp-controller="Home" asp-action="Index">

                            Anasayfa

                        </a>

                    </li>


                    <!-- =========================================
                         ATEŞ KEHRİBAR
                         ========================================= -->
                    <li class="nav-item">

                        <a class="nav-link header-nav-link" asp-area="" asp-controller="Products" asp-action="Index"
                           asp-route-categoryId="11">

                            Ateş Kehribar

                        </a>

                    </li>


                    <!-- =========================================
                         SIKMA KEHRİBAR
                         ========================================= -->
                    <li class="nav-item">

                        <a class="nav-link header-nav-link" asp-area="" asp-controller="Products" asp-action="Index"
                           asp-route-categoryId="12">

                            Sıkma Kehribar

                        </a>

                    </li>


                    <!-- =========================================
                         DAMLA KEHRİBAR
                         ========================================= -->
                    <li class="nav-item">

                        <a class="nav-link header-nav-link" asp-area="" asp-controller="Products" asp-action="Index"
                           asp-route-categoryId="13">

                            Damla Kehribar

                        </a>

                    </li>


                    <!-- =========================================
                         İLETİŞİM
                         ========================================= -->
                    <li class="nav-item">

                        <a class="nav-link header-nav-link" asp-area="" asp-controller="Home" asp-action="ContactUs">

                            İletişim

                        </a>

                    </li>


                    <!-- =========================================
                         MOBİL ADMIN
                         ========================================= -->
                    @if (User.Identity?.IsAuthenticated == true &&
                         User.IsInRole("Admin"))
                    {
                        <li class="nav-item d-lg-none">

                            <a class="nav-link header-nav-link" asp-area="Admin" asp-controller="Main" asp-action="Index">

                                <i class="fa-solid fa-gauge-high me-1"></i>

                                Admin Paneli

                            </a>

                        </li>
                    }

                </ul>


                <!-- =================================================
                     DESKTOP SAĞ YAZI
                     ================================================= -->
                <div class="header-nav-brand d-none d-lg-flex">

                    <i class="fa-solid fa-gem"></i>

                    <span>
                        Kehribar Tesbih Koleksiyonları
                    </span>

                </div>

            </div>

        </div>

    </nav>

</header>


<style>
    /* =========================================================
       HEADER
       ========================================================= */

    .site-header {
        position: relative;

        z-index: 1000;

        background-color: #ffffff;

        box-shadow:
            0 3px 18px rgba(70, 47, 30, 0.035);
    }


    .header-main {
        background:
            radial-gradient(circle at top left,
                rgba(190, 145, 91, 0.06),
                transparent 30%),
            #ffffff;
    }


    .header-main-inner {
        min-height: 82px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 30px;
    }


    /* =========================================================
       LOGO
       ========================================================= */

    .site-logo {
        display: inline-flex;
        align-items: center;

        gap: 10px;

        flex-shrink: 0;

        color: inherit;

        text-decoration: none;
    }


    .site-logo-icon {
        width: 43px;
        height: 43px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 12px;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #493225,
                #9b6838);

        font-size: 0.95rem;

        box-shadow:
            0 6px 16px rgba(73, 50, 37, 0.18);

        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease;
    }


    .site-logo:hover .site-logo-icon {
        transform: rotate(-4deg) translateY(-1px);

        box-shadow:
            0 8px 20px rgba(73, 50, 37, 0.23);
    }


    .site-logo-text {
        display: flex;
        align-items: baseline;

        gap: 4px;

        white-space: nowrap;
    }


    .logo-main {
        color: #30251d;

        font-size: 1.55rem;
        font-weight: 800;

        letter-spacing: -0.04em;
    }


    .logo-sub {
        color: #a16e3d;

        font-size: 1.55rem;
        font-weight: 800;

        letter-spacing: -0.04em;
    }


    /* =========================================================
       ARAMA
       ========================================================= */

    .header-search {
        width: 100%;
        max-width: 590px;

        margin: 0 auto;
    }


    .header-search-box {
        width: 100%;
        height: 45px;

        display: flex;
        align-items: center;

        overflow: hidden;

        border: 1px solid #e0d5ca;
        border-radius: 12px;

        background-color: #fbf9f6;

        transition:
            border-color 0.2s ease,
            background-color 0.2s ease,
            box-shadow 0.2s ease;
    }


    .header-search-box:focus-within {
        border-color: #b7895a;

        background-color: #ffffff;

        box-shadow:
            0 0 0 0.15rem rgba(183, 137, 90, 0.10);
    }


    .header-search-icon {
        width: 43px;
        height: 100%;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        color: #a28a73;

        font-size: 0.73rem;
    }


    .header-search .form-control {
        height: 100%;

        min-width: 0;

        padding: 0 12px 0 0;

        border: 0;

        color: #43352b;

        background-color: transparent;

        font-size: 0.76rem;

        box-shadow: none !important;
    }


    .header-search .form-control::placeholder {
        color: #ada298;
    }


    .search-button {
        height: 35px;

        display: flex;
        align-items: center;
        justify-content: center;

        gap: 7px;

        flex-shrink: 0;

        margin-right: 5px;
        padding: 0 14px;

        border: 0;
        border-radius: 8px;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #493225,
                #8b5e34);

        font-size: 0.68rem;
        font-weight: 700;

        transition:
            background 0.2s ease,
            transform 0.2s ease;
    }


    .search-button:hover {
        color: #ffffff;

        background:
            linear-gradient(135deg,
                #5b3e2b,
                #9b6a3a);

        transform: translateX(1px);
    }


    .search-button i {
        font-size: 0.55rem;
    }


    /* =========================================================
       HEADER ACTIONS
       ========================================================= */

    .header-actions {
        display: flex;
        align-items: center;

        gap: 7px;

        flex-shrink: 0;
    }


    .header-action {
        position: relative;

        width: 41px;
        height: 41px;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 0;

        border: 1px solid #e4dacf;
        border-radius: 11px;

        color: #554236;

        background-color: #ffffff;

        font-size: 0.82rem;

        text-decoration: none;

        box-shadow:
            0 3px 10px rgba(70, 47, 30, 0.035);

        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background-color 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }


    .header-action:hover,
    .header-action[aria-expanded="true"] {
        color: #815a35;

        border-color: #cdb49a;

        background-color: #faf5ef;

        transform: translateY(-2px);

        box-shadow:
            0 5px 13px rgba(70, 47, 30, 0.07);
    }


    /* =========================================================
       FAVORİ
       ========================================================= */

    .favorite-active {
        color: #a95757;
    }


    /* =========================================================
       BADGE
       ========================================================= */

    .action-badge {
        position: absolute;

        top: -6px;
        right: -6px;

        min-width: 18px;
        height: 18px;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 0 5px;

        border: 2px solid #ffffff;
        border-radius: 20px;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #85582f,
                #bd8148);

        font-size: 0.55rem;
        font-weight: 800;

        line-height: 1;
    }


    .favorite-badge {
        background-color: #a95757;
        background-image: none;
    }


    /* =========================================================
       ACCOUNT DROPDOWN
       ========================================================= */

    .account-dropdown {
        width: 300px;

        margin-top: 11px !important;
        padding: 8px;

        overflow: hidden;

        border: 1px solid #e5d9cd !important;
        border-radius: 16px;

        background-color: #ffffff;

        box-shadow:
            0 16px 40px rgba(62, 42, 28, 0.13) !important;
    }


    .account-dropdown .dropdown-divider {
        margin: 6px 5px;

        border-color: #eee5dc;
    }


    /* =========================================================
       KULLANICI HEADER
       ========================================================= */

    .account-user-header {
        display: flex;
        align-items: center;

        gap: 11px;

        padding: 10px;
    }


    .account-avatar {
        width: 43px;
        height: 43px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 11px;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #493225,
                #986538);

        font-size: 0.8rem;

        box-shadow:
            0 4px 12px rgba(73, 50, 37, 0.15);
    }


    .account-user-info {
        min-width: 0;

        flex: 1;
    }


    .account-user-info small {
        display: block;

        margin-bottom: 1px;

        color: #a17b57;

        font-size: 0.51rem;
        font-weight: 800;

        letter-spacing: 0.1em;
    }


    .account-user-info strong {
        display: block;

        overflow: hidden;

        color: #3e3027;

        font-size: 0.8rem;
        font-weight: 800;

        text-overflow: ellipsis;

        white-space: nowrap;
    }


    /* =========================================================
       ROLE
       ========================================================= */

    .account-role {
        width: fit-content;

        display: flex;
        align-items: center;

        gap: 4px;

        margin-top: 5px;
        padding: 3px 7px;

        border: 1px solid;
        border-radius: 20px;

        font-size: 0.5rem;
        font-weight: 800;
    }


    .admin-role {
        color: #81572f;

        border-color: #dfc5a7;

        background-color: #f8ecde;
    }


    .customer-role {
        color: #6e5846;

        border-color: #e0d3c7;

        background-color: #f8f4ef;
    }


    /* =========================================================
       ACCOUNT MENU ITEM
       ========================================================= */

    .account-menu-item {
        display: flex;
        align-items: center;

        gap: 9px;

        width: 100%;

        padding: 8px 9px;

        border: 0;
        border-radius: 9px;

        color: #59463a;

        background-color: transparent;

        font-size: 0.69rem;
        font-weight: 650;

        transition:
            color 0.2s ease,
            background-color 0.2s ease;
    }


    .account-menu-item:hover {
        color: #714e31;

        background-color: #faf5ef;
    }


    .account-menu-icon {
        width: 29px;
        height: 29px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 8px;

        color: #8c6949;

        background-color: #f3e8dc;

        font-size: 0.62rem;

        transition:
            color 0.2s ease,
            background-color 0.2s ease;
    }


    .account-menu-item:hover .account-menu-icon {
        color: #ffffff;

        background-color: #91623a;
    }


    .account-menu-arrow {
        margin-left: auto;

        color: #b6a89b;

        font-size: 0.48rem;

        transition:
            color 0.2s ease,
            transform 0.2s ease;
    }


    .account-menu-item:hover .account-menu-arrow {
        color: #91623a;

        transform: translateX(2px);
    }


    /* =========================================================
       ADMIN
       ========================================================= */

    .admin-menu-item {
        font-weight: 750;
    }


    .admin-menu-icon {
        color: #80552f;

        background-color: #f5e6d6;
    }


    /* =========================================================
       LOGOUT
       ========================================================= */

    .logout-item {
        color: #a65353;
    }


    .logout-item .account-menu-icon {
        color: #a65353;

        background-color: #faeeee;
    }


    .logout-item:hover {
        color: #9b4646;

        background-color: #fcf2f2;
    }


    .logout-item:hover .account-menu-icon {
        color: #ffffff;

        background-color: #a65353;
    }


    /* =========================================================
       MİSAFİR
       ========================================================= */

    .account-guest-header {
        display: flex;
        align-items: flex-start;

        gap: 10px;

        padding: 10px;
    }


    .guest-header-icon {
        width: 39px;
        height: 39px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        color: #805832;

        background-color: #f2e4d5;

        font-size: 0.73rem;
    }


    .account-guest-header span {
        display: block;

        margin-bottom: 1px;

        color: #9b7147;

        font-size: 0.5rem;
        font-weight: 800;

        letter-spacing: 0.1em;
    }


    .account-guest-header strong {
        display: block;

