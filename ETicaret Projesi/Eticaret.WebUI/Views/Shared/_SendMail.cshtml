@model Eticaret.Core.Entities.Contact

@{
    ViewData["Title"] = "Mail Gönder";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid px-4 py-4 mail-page">

    <!-- =====================================================
         SAYFA BAŞLIĞI
         ===================================================== -->
    <div class="mail-page-header">

        <div>
            <span class="mail-page-eyebrow">
                İletişim Yönetimi
            </span>

            <h1 class="mail-page-title">
                Mail Gönder
            </h1>

            <p class="mail-page-description">
                Kullanıcının iletişim formuna verdiği bilgilere göre doğrudan cevap gönderebilirsiniz.
            </p>
        </div>

        <a asp-area="Admin" asp-controller="Contacts" asp-action="Index" class="mail-back-button">

            <i class="fa-solid fa-arrow-left"></i>

            <span>
                İletişim Formlarına Dön
            </span>

        </a>

    </div>


    <div class="row g-4">

        <!-- =====================================================
             KULLANICI BİLGİLERİ
             ===================================================== -->
        <div class="col-lg-4">

            <div class="contact-card h-100">

                <div class="contact-card-top">

                    <div class="contact-avatar">

                        @(string.IsNullOrWhiteSpace(Model.Name)
                            ? "?"
                            : Model.Name.Substring(0, 1).ToUpper())

                    </div>

                    <h2 class="contact-name">
                        @Model.Name @Model.Surname
                    </h2>

                    <span class="contact-form-number">
                        Form #@Model.Id
                    </span>

                </div>


                <div class="contact-divider"></div>


                <!-- E-POSTA -->
                <div class="contact-info-item">

                    <div class="contact-info-icon">
                        <i class="fa-solid fa-envelope"></i>
                    </div>

                    <div class="contact-info-content">

                        <span class="contact-info-label">
                            E-posta
                        </span>

                        <span class="contact-info-value">
                            @Model.Email
                        </span>

                    </div>

                </div>


                <!-- TELEFON -->
                <div class="contact-info-item">

                    <div class="contact-info-icon">
                        <i class="fa-solid fa-phone"></i>
                    </div>

                    <div class="contact-info-content">

                        <span class="contact-info-label">
                            Telefon
                        </span>

                        <span class="contact-info-value">

                            @(string.IsNullOrWhiteSpace(Model.Phone)
                                ? "Belirtilmemiş"
                                : Model.Phone)

                        </span>

                    </div>

                </div>


                <!-- KULLANICI MESAJI -->
                <div class="contact-message-area">

                    <div class="contact-message-title">

                        <i class="fa-regular fa-message"></i>

                        <span>
                            Kullanıcının Mesajı
                        </span>

                    </div>

                    <div class="contact-message-box">
                        @Model.Message
                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             CEVAP MAİLİ
             ===================================================== -->
        <div class="col-lg-8">

            <div class="mail-form-card">

                <!-- Başlık -->
                <div class="mail-form-header">

                    <div class="mail-form-header-icon">
                        <i class="fa-solid fa-paper-plane"></i>
                    </div>

                    <div>

                        <h2 class="mail-form-title">
                            Cevap Maili
                        </h2>

                        <p class="mail-form-subtitle">
                            Mesajınız
                            <strong>@Model.Email</strong>
                            adresine gönderilecektir.
                        </p>

                    </div>

                </div>


                <div class="mail-form-body">

                    <form asp-area="Admin" asp-controller="Contacts" asp-action="SendMail" asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- KONU -->
                        <div class="mail-form-group">

                            <label for="subject" class="mail-form-label">

                                <i class="fa-solid fa-heading"></i>

                                Konu

                            </label>

                            <input id="subject" type="text" name="subject" class="form-control mail-form-control"
                                   placeholder="Örneğin: İletişim talebiniz hakkında" required />

                            <span class="mail-form-help">
                                Kullanıcı mail kutusunda bu başlığı görecektir.
                            </span>

                        </div>


                        <!-- MESAJ -->
                        <div class="mail-form-group">

                            <label for="message" class="mail-form-label">

                                <i class="fa-regular fa-comment-dots"></i>

                                Mesaj

                            </label>

                            <textarea id="message" name="message" class="form-control mail-message-control" rows="11"
                                      placeholder="Kullanıcıya göndermek istediğiniz cevabı buraya yazınız..."
                                      required></textarea>

                        </div>


                        <!-- ALT BUTONLAR -->
                        <div class="mail-form-actions">

                            <a asp-area="Admin" asp-controller="Contacts" asp-action="Details" asp-route-id="@Model.Id"
                               class="mail-cancel-button">

                                Vazgeç

                            </a>

                            <button type="submit" class="mail-submit-button">

                                <i class="fa-solid fa-paper-plane"></i>

                                <span>
                                    Mail Gönder
                                </span>

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<style>
    /* =========================================================
       SAYFA
       ========================================================= */

    .mail-page {
        max-width: 1600px;
    }


    /* =========================================================
       SAYFA BAŞLIĞI
       ========================================================= */

    .mail-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 20px;

        margin-bottom: 28px;
    }


    .mail-page-eyebrow {
        display: inline-block;

        margin-bottom: 5px;

        color: #9a7042;

        font-size: 0.72rem;
        font-weight: 700;

        letter-spacing: 0.12em;

        text-transform: uppercase;
    }


    .mail-page-title {
        margin: 0 0 6px;

        color: #2e241c;

        font-size: 1.8rem;
        font-weight: 800;
    }


    .mail-page-description {
        margin: 0;

        color: #7c7167;

        font-size: 0.9rem;
        line-height: 1.6;
    }


    .mail-back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        flex-shrink: 0;

        padding: 10px 16px;

        border: 1px solid #ddd3c6;
        border-radius: 10px;

        color: #5b4a3c;

        background-color: #ffffff;

        font-size: 0.85rem;
        font-weight: 600;

        text-decoration: none;

        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background-color 0.2s ease,
            transform 0.2s ease;
    }


    .mail-back-button:hover {
        color: #3f2f23;

        border-color: #c7aa88;

        background-color: #fbf8f4;

        transform: translateY(-1px);
    }


    /* =========================================================
       KULLANICI KARTI
       ========================================================= */

    .contact-card {
        padding: 24px;

        border: 1px solid #e8dfd4;
        border-radius: 18px;

        background-color: #ffffff;

        box-shadow:
            0 8px 24px rgba(65, 45, 30, 0.06);
    }


    .contact-card-top {
        text-align: center;
    }


    .contact-avatar {
        width: 72px;
        height: 72px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin: 0 auto 14px;

        border-radius: 50%;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #493225,
                #956536);

        font-size: 1.65rem;
        font-weight: 800;

        box-shadow:
            0 7px 18px rgba(80, 54, 30, 0.18);
    }


    .contact-name {
        margin: 0 0 4px;

        color: #30251d;

        font-size: 1.15rem;
        font-weight: 800;
    }


    .contact-form-number {
        color: #988b7f;

        font-size: 0.78rem;
        font-weight: 500;
    }


    .contact-divider {
        height: 1px;

        margin: 22px 0;

        background-color: #eee7df;
    }


    /* =========================================================
       KULLANICI BİLGİLERİ
       ========================================================= */

    .contact-info-item {
        display: flex;
        align-items: center;

        gap: 12px;

        margin-bottom: 17px;
    }


    .contact-info-icon {
        width: 38px;
        height: 38px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        color: #8c6135;

        background-color: #f7f0e8;

        font-size: 0.85rem;
    }


    .contact-info-content {
        min-width: 0;

        display: flex;
        flex-direction: column;
    }


    .contact-info-label {
        margin-bottom: 2px;

        color: #9a8c80;

        font-size: 0.7rem;
        font-weight: 600;
    }


    .contact-info-value {
        color: #3a2e25;

        font-size: 0.86rem;
        font-weight: 650;

        word-break: break-word;
    }


    /* =========================================================
       KULLANICI MESAJI
       ========================================================= */

    .contact-message-area {
        margin-top: 24px;
    }


    .contact-message-title {
        display: flex;
        align-items: center;

        gap: 8px;

        margin-bottom: 9px;

        color: #4d3a2b;

        font-size: 0.8rem;
        font-weight: 700;
    }


    .contact-message-title i {
        color: #9a7042;
    }


    .contact-message-box {
        min-height: 130px;

        padding: 15px;

        border: 1px solid #eee5db;
        border-radius: 12px;

        color: #62574d;

        background-color: #faf8f5;

        font-size: 0.84rem;
        line-height: 1.65;

        white-space: pre-wrap;
    }


    /* =========================================================
       MAİL FORM KARTI
       ========================================================= */

    .mail-form-card {
        overflow: hidden;

        border: 1px solid #e8dfd4;
        border-radius: 18px;

        background-color: #ffffff;

        box-shadow:
            0 8px 24px rgba(65, 45, 30, 0.06);
    }


    /* =========================================================
       FORM BAŞLIK
       ========================================================= */

    .mail-form-header {
        display: flex;
        align-items: center;

        gap: 13px;

        padding: 20px 22px;

        border-bottom: 1px solid #eee7df;

        background:
            linear-gradient(180deg,
                #ffffff 0%,
                #fcfaf7 100%);
    }


    .mail-form-header-icon {
        width: 44px;
        height: 44px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 12px;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #4a3425,
                #946637);

        box-shadow:
            0 5px 14px rgba(75, 52, 36, 0.16);
    }


    .mail-form-title {
        margin: 0 0 3px;

        color: #31261e;

        font-size: 1rem;
        font-weight: 800;
    }


    .mail-form-subtitle {
        margin: 0;

        color: #84786d;

        font-size: 0.78rem;
    }


    .mail-form-subtitle strong {
        color: #63482f;

        font-weight: 700;
    }


    /* =========================================================
       FORM BODY
       ========================================================= */

    .mail-form-body {
        padding: 24px;
    }


    .mail-form-group {
        margin-bottom: 22px;
    }


    .mail-form-label {
        display: flex;
        align-items: center;

        gap: 7px;

        margin-bottom: 8px;

        color: #403229;

        font-size: 0.8rem;
        font-weight: 700;
    }


    .mail-form-label i {
        color: #9a7042;

        font-size: 0.76rem;
    }


    .mail-form-control,
    .mail-message-control {
        border: 1px solid #e2d9cf;
        border-radius: 11px;

        color: #3b3028;

        background-color: #fbfaf8;

        font-size: 0.88rem;

        box-shadow: none !important;

        transition:
            border-color 0.2s ease,
            background-color 0.2s ease,
            box-shadow 0.2s ease;
    }


    .mail-form-control {
        min-height: 47px;

        padding: 10px 13px;
    }


    .mail-message-control {
        min-height: 245px;

        padding: 13px;

        resize: vertical;

        line-height: 1.6;
    }


    .mail-form-control:focus,
    .mail-message-control:focus {
        border-color: #b58a5d;

        background-color: #ffffff;

        box-shadow:
            0 0 0 0.15rem rgba(181, 138, 93, 0.10) !important;
    }


    .mail-form-control::placeholder,
    .mail-message-control::placeholder {
        color: #b1a69d;
    }


    .mail-form-help {
        display: block;

        margin-top: 6px;

        color: #9a8e83;

        font-size: 0.7rem;
    }


    /* =========================================================
       ALT BUTONLAR
       ========================================================= */

    .mail-form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;

        gap: 10px;

        margin-top: 28px;
        padding-top: 20px;

        border-top: 1px solid #eee7df;
    }


    .mail-cancel-button,
    .mail-submit-button {
        min-height: 42px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        padding: 9px 18px;

        border-radius: 10px;

        font-size: 0.82rem;
        font-weight: 700;

        text-decoration: none;

        transition:
            transform 0.2s ease,
            border-color 0.2s ease,
            background-color 0.2s ease,
            color 0.2s ease,
            box-shadow 0.2s ease;
    }


    .mail-cancel-button {
        border: 1px solid #ddd3c6;

        color: #67584b;

        background-color: #ffffff;
    }


    .mail-cancel-button:hover {
        color: #3d3026;

        border-color: #c7aa88;

        background-color: #fbf8f4;
    }


    .mail-submit-button {
        border: 1px solid #4a3425;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #493225,
                #895c31);

        box-shadow:
            0 5px 15px rgba(73, 50, 37, 0.16);
    }


    .mail-submit-button:hover {
        color: #ffffff;

        border-color: #9b6c3b;

        background:
            linear-gradient(135deg,
                #5b3e2b,
                #9b6c3b);

        transform: translateY(-1px);

        box-shadow:
            0 7px 18px rgba(73, 50, 37, 0.22);
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 991.98px) {

        .mail-page-header {
            align-items: flex-start;
        }


        .contact-card {
            height: auto !important;
        }

    }


    /* =========================================================
       MOBİL
       ========================================================= */

    @@media (max-width: 767.98px) {

        .mail-page {
            padding-left: 16px !important;
            padding-right: 16px !important;
        }


        .mail-page-header {
            flex-direction: column;
            align-items: stretch;

            margin-bottom: 22px;
        }


        .mail-page-title {
            font-size: 1.5rem;
        }


        .mail-back-button {
            width: fit-content;
        }


        .contact-card,
        .mail-form-body {
            padding: 18px;
        }


        .mail-form-header {
            padding: 17px 18px;
        }


        .mail-message-control {
            min-height: 210px;
        }


        .mail-form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }


        .mail-cancel-button,
        .mail-submit-button {
            width: 100%;
        }

    }


    /* =========================================================
       KÜÇÜK TELEFON
       ========================================================= */

    @@media (max-width: 480px) {

        .contact-avatar {
            width: 64px;
            height: 64px;

            font-size: 1.45rem;
        }


        .mail-form-header-icon {
            width: 40px;
            height: 40px;
        }


        .mail-form-subtitle {
            line-height: 1.45;
        }

    }
</style>