@model IEnumerable<Category>

@foreach (var anaKategori in Model.Where(c => c.ParentId == 0))
{
    var altKategoriler = Model
        .Where(c => c.ParentId == anaKategori.Id)
        .ToList();

    <div class="dropdown">

        <a class="btn dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            @anaKategori.Name
        </a>

        @if (altKategoriler.Any())
        {
            <ul class="dropdown-menu">

                @foreach (var altKategori in altKategoriler)
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Categories" asp-action="Index" asp-route-id="@altKategori.Id">
                            @altKategori.Name
                        </a>
                    </li>
                }

            </ul>
        }

    </div>
}