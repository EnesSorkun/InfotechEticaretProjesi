@model News

<div class="col-12 col-md-6 col-xl-4 campaign-column">

    <a asp-area="" asp-controller="News" asp-action="Details" asp-route-id="@Model.Id" class="campaign-image-card"
       aria-label="@Model.Name kampanyasını incele">

        @if (!string.IsNullOrWhiteSpace(Model.Image))
        {
            <div class="campaign-image-area">

                <img src="@Model.Image" alt="@Model.Name" class="campaign-image" loading="lazy" />

            </div>
        }
        else
        {
            <div class="campaign-no-image">

                <div class="campaign-no-image-icon">
                    <i class="fa-regular fa-image"></i>
                </div>

                <span>
                    Kampanya görseli bulunamadı.
                </span>

            </div>
        }

    </a>

</div>


<style>
    /* =========================================================
       KAMPANYA KOLONU
       ========================================================= */

    .campaign-column {
        display: flex;
        margin-bottom: 28px;
    }


    /* =========================================================
       KAMPANYA KARTI
       ========================================================= */

    .campaign-image-card {
        position: relative;

        display: block;

        width: 100%;
        height: 100%;

        overflow: hidden;

        border: 1px solid #e7ddd2;
        border-radius: 22px;

        background-color: #fbf8f4;

        text-decoration: none;

        box-shadow:
            0 12px 32px rgba(70, 47, 30, 0.08);

        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease,
            border-color 0.3s ease;
    }


    /* =========================================================
       GÖRSEL ALANI
       ========================================================= */

    .campaign-image-area {
        position: relative;

        display: flex;

        width: 100%;

        align-items: center;
        justify-content: center;

        overflow: hidden;

        background:
            linear-gradient(145deg,
                #fbf8f4,
                #f5eee6);
    }


    /* =========================================================
       KAMPANYA GÖRSELİ

       ÖNEMLİ:
       width: 100% ve height: auto sayesinde görselin
       orijinal oranı korunur ve hiçbir bölümü kesilmez.
       ========================================================= */

    .campaign-image {
        display: block;

        width: 100%;
        height: auto;

        object-fit: contain;
        object-position: center;

        transition:
            transform 0.45s ease;
    }


    /* =========================================================
       HOVER
       ========================================================= */

    .campaign-image-card:hover {
        border-color: #d3b493;

        transform: translateY(-6px);

        box-shadow:
            0 20px 45px rgba(70, 47, 30, 0.14);
    }


    .campaign-image-card:hover .campaign-image {
        transform: scale(1.015);
    }


    /* =========================================================
       HAFİF PARLAMA EFEKTİ
       ========================================================= */

    .campaign-image-card::after {
        content: "";

        position: absolute;

        top: 0;
        left: -120%;

        width: 55%;
        height: 100%;

        pointer-events: none;

        background:
            linear-gradient(110deg,
                transparent,
                rgba(255, 255, 255, 0.10),
                transparent);

        transform: skewX(-18deg);

        transition:
            left 0.65s ease;
    }


    .campaign-image-card:hover::after {
        left: 140%;
    }


    /* =========================================================
       GÖRSEL YOK
       ========================================================= */

    .campaign-no-image {
        width: 100%;
        min-height: 430px;

        display: flex;
        flex-direction: column;

        align-items: center;
        justify-content: center;

        gap: 14px;

        padding: 35px;

        color: #89796c;

        text-align: center;

        background:
            linear-gradient(145deg,
                #faf6f1,
                #f1e7dc);
    }


    .campaign-no-image-icon {
        width: 68px;
        height: 68px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 50%;

        color: #8b5e34;

        background-color: #eee0d0;

        font-size: 1.55rem;
    }


    .campaign-no-image span {
        color: #75675c;

        font-size: 0.9rem;
        font-weight: 600;
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 1199.98px) {

        .campaign-image-card {
            border-radius: 19px;
        }

        .campaign-column {
            margin-bottom: 24px;
        }

    }


    /* =========================================================
       TELEFON
       ========================================================= */

    @@media (max-width: 767.98px) {

        .campaign-column {
            margin-bottom: 20px;
        }

        .campaign-image-card {
            border-radius: 17px;
        }

        .campaign-image-card:hover {
            transform: translateY(-3px);
        }

        .campaign-no-image {
            min-height: 300px;
        }

    }


    /* =========================================================
       KÜÇÜK TELEFON
       ========================================================= */

    @@media (max-width: 480px) {

        .campaign-image-card {
            border-radius: 15px;
        }

        .campaign-no-image {
            min-height: 250px;
        }

    }
</style>