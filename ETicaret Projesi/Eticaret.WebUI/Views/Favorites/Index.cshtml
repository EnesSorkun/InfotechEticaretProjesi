@model List<FavoriteProductViewModel>

@{
    ViewData["Title"] = "Favorilerim";
}

<section class="favorites-page">

    <div class="container">

        <!-- =====================================================
             SAYFA BAŞLIĞI
             ===================================================== -->
        <div class="favorites-header">

            <div>

                <span class="favorites-label">
                    HESABIM
                </span>

                <h1>
                    Favorilerim
                </h1>

                <p>
                    Beğendiğiniz ürünleri burada görüntüleyebilir
                    ve dilediğiniz zaman tekrar inceleyebilirsiniz.
                </p>

            </div>


            <div class="favorite-count">

                <div class="favorite-count-icon">
                    <i class="fa-regular fa-heart"></i>
                </div>

                <div>

                    <span>
                        Favori Ürün
                    </span>

                    <strong>
                        @Model.Count
                    </strong>

                </div>

            </div>

        </div>


        <!-- =====================================================
             MESAJLAR
             ===================================================== -->
        @if (TempData["SuccessMessage"] is not null)
        {
            <div class="favorites-message favorites-success">

                <div class="favorites-message-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>

                <span>
                    @TempData["SuccessMessage"]
                </span>

            </div>
        }


        @if (TempData["InfoMessage"] is not null)
        {
            <div class="favorites-message favorites-info">

                <div class="favorites-message-icon">
                    <i class="fa-solid fa-circle-info"></i>
                </div>

                <span>
                    @TempData["InfoMessage"]
                </span>

            </div>
        }


        @if (Model.Count == 0)
        {
            <!-- =================================================
                 FAVORİ YOK
                 ================================================= -->
            <div class="empty-favorites">

                <div class="empty-icon">
                    <i class="fa-regular fa-heart"></i>
                </div>

                <span class="empty-favorites-label">
                    FAVORİLERİM
                </span>

                <h2>
                    Favori ürününüz bulunmuyor
                </h2>

                <p>
                    Beğendiğiniz tesbih modellerini favorilerinize
                    ekleyerek daha sonra kolayca ulaşabilirsiniz.
                </p>


                <a asp-controller="Products" asp-action="Index" class="empty-favorites-button">

                    <i class="fa-solid fa-bag-shopping"></i>

                    <span>
                        Ürünleri İncele
                    </span>

                </a>

            </div>
        }
        else
        {
            <!-- =================================================
                 FAVORİ ÜRÜNLER
                 ================================================= -->
            <div class="row g-4">

                @foreach (var item in Model)
                {
                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">

                        <div class="favorite-card">

                            <!-- =================================================
                                 ÜRÜN RESMİ
                                 ================================================= -->
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id"
                               class="favorite-image-area">

                                <img src="@item.Image" alt="@item.Name" class="favorite-image" />

                            </a>


                            <!-- =================================================
                                 FAVORİDEN ÇIKAR
                                 ================================================= -->
                            <form asp-controller="Favorites" asp-action="Remove" method="post" class="remove-form">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="id" value="@item.Id" />


                                <button type="submit" class="remove-button" title="Favorilerden Kaldır"
                                        aria-label="Favorilerden Kaldır">

                                    <i class="fa-solid fa-heart"></i>

                                </button>

                            </form>


                            <!-- =================================================
                                 ÜRÜN BİLGİLERİ
                                 ================================================= -->
                            <div class="favorite-content">

                                <div class="favorite-product-top">

                                    @if (!string.IsNullOrWhiteSpace(item.BrandName))
                                    {
                                        <span class="brand-name">
                                            @item.BrandName
                                        </span>
                                    }


                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id"
                                       class="product-name">

                                        @item.Name

                                    </a>


                                    @if (!string.IsNullOrWhiteSpace(item.ProductCode))
                                    {
                                        <div class="product-code">

                                            <i class="fa-solid fa-barcode"></i>

                                            <span>
                                                @item.ProductCode
                                            </span>

                                        </div>
                                    }

                                </div>


                                <!-- =================================================
                                     FİYAT + STOK
                                     ================================================= -->
                                <div class="favorite-price-row">

                                    <span class="product-price">
                                        @item.Price.ToString("N2") ₺
                                    </span>


                                    @if (item.Stock > 0)
                                    {
                                        <span class="stock-badge stock-available">

                                            <i class="fa-solid fa-circle-check"></i>

                                            Stokta

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="stock-badge stock-empty">

                                            <i class="fa-solid fa-circle-xmark"></i>

                                            Tükendi

                                        </span>
                                    }

                                </div>


                                <!-- =================================================
                                     DETAY BUTONU
                                     ================================================= -->
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id"
                                   class="favorite-detail-button">

                                    <span>
                                        Ürünü İncele
                                    </span>

                                    <i class="fa-solid fa-chevron-right"></i>

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</section>


<style>
    /* =========================================================
       SAYFA
       ========================================================= */

    .favorites-page {
        min-height: 72vh;

        padding: 55px 0 70px;

        background:
            radial-gradient(circle at top left,
                rgba(190, 145, 91, 0.07),
                transparent 32%),
            linear-gradient(180deg,
                #ffffff 0%,
                #faf7f3 100%);
    }


    /* =========================================================
       SAYFA BAŞLIĞI
       ========================================================= */

    .favorites-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 25px;

        margin-bottom: 30px;
    }


    .favorites-label {
        display: inline-block;

        margin-bottom: 6px;

        color: #9a7042;

        font-size: 0.67rem;
        font-weight: 800;

        letter-spacing: 0.15em;
    }


    .favorites-header h1 {
        position: relative;

        margin: 0 0 10px;
        padding-bottom: 12px;

        color: #30251d;

        font-size: 2rem;
        font-weight: 800;

        letter-spacing: -0.02em;
    }


    .favorites-header h1::after {
        content: "";

        position: absolute;

        left: 0;
        bottom: 0;

        width: 42px;
        height: 3px;

        border-radius: 20px;

        background:
            linear-gradient(90deg,
                #895b2e,
                #d0a16a);
    }


    .favorites-header p {
        max-width: 640px;

        margin: 0;

        color: #887b70;

        font-size: 0.84rem;
        line-height: 1.65;
    }


    /* =========================================================
       FAVORİ SAYISI
       ========================================================= */

    .favorite-count {
        min-width: 135px;

        display: flex;
        align-items: center;

        gap: 10px;

        padding: 10px 13px;

        border: 1px solid #e4d8cc;
        border-radius: 12px;

        background-color: #ffffff;

        box-shadow:
            0 5px 15px rgba(70, 47, 30, 0.05);
    }


    .favorite-count-icon {
        width: 36px;
        height: 36px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 9px;

        color: #9b5656;

        background-color: #faeeee;

        font-size: 0.85rem;
    }


    .favorite-count span {
        display: block;

        margin-bottom: 1px;

        color: #9a8d81;

        font-size: 0.61rem;
        font-weight: 600;
    }


    .favorite-count strong {
        display: block;

        color: #49382c;

        font-size: 0.88rem;
        font-weight: 800;
    }


    /* =========================================================
       MESAJLAR
       ========================================================= */

    .favorites-message {
        display: flex;
        align-items: center;

        gap: 10px;

        margin-bottom: 22px;
        padding: 12px 15px;

        border-radius: 11px;

        font-size: 0.77rem;
        font-weight: 600;
    }


    .favorites-message-icon {
        width: 27px;
        height: 27px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 8px;

        font-size: 0.7rem;
    }


    .favorites-success {
        border: 1px solid #d6e5d1;

        color: #526d4b;

        background-color: #f1f7ef;
    }


    .favorites-success .favorites-message-icon {
        color: #54764c;

        background-color: #e1efdd;
    }


    .favorites-info {
        border: 1px solid #ded6ca;

        color: #725f4d;

        background-color: #f8f4ee;
    }


    .favorites-info .favorites-message-icon {
        color: #8e653e;

        background-color: #eee2d4;
    }


    /* =========================================================
       FAVORİ KARTI
       ========================================================= */

    .favorite-card {
        position: relative;

        height: 100%;

        display: flex;
        flex-direction: column;

        overflow: hidden;

        border: 1px solid #e8ded3;
        border-radius: 18px;

        background-color: #ffffff;

        box-shadow:
            0 8px 24px rgba(70, 47, 30, 0.06);

        transition:
            transform 0.25s ease,
            border-color 0.25s ease,
            box-shadow 0.25s ease;
    }


    .favorite-card:hover {
        border-color: #d7bea2;

        transform: translateY(-4px);

        box-shadow:
            0 14px 30px rgba(70, 47, 30, 0.10);
    }


    /* =========================================================
       ÜRÜN RESMİ
       ========================================================= */

    .favorite-image-area {
        position: relative;

        display: block;

        height: 275px;

        padding: 20px;

        overflow: hidden;

        background:
            radial-gradient(circle at center,
                #ffffff 0%,
                #faf6f1 100%);
    }


    .favorite-image {
        width: 100%;
        height: 100%;

        object-fit: contain;
        object-position: center;

        transition:
            transform 0.35s ease;
    }


    .favorite-card:hover .favorite-image {
        transform: scale(1.035);
    }


    /* =========================================================
       FAVORİDEN ÇIKAR
       ========================================================= */

    .remove-form {
        position: absolute;

        z-index: 5;

        top: 14px;
        right: 14px;

        margin: 0;
    }


    .remove-button {
        width: 39px;
        height: 39px;

        display: flex;
        align-items: center;
        justify-content: center;

        border: 1px solid #ead5d5;
        border-radius: 50%;

        color: #a85757;

        background-color: rgba(255, 255, 255, 0.95);

        font-size: 0.86rem;

        box-shadow:
            0 4px 12px rgba(70, 47, 30, 0.09);

        cursor: pointer;

        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background-color 0.2s ease,
            transform 0.2s ease;
    }


    .remove-button:hover {
        color: #ffffff;

        border-color: #a85353;

        background-color: #a85353;

        transform: scale(1.06);
    }


    /* =========================================================
       İÇERİK
       ========================================================= */

    .favorite-content {
        display: flex;
        flex-direction: column;

        flex: 1;

        padding: 18px;

        border-top: 1px solid #eee5dc;
    }


    .favorite-product-top {
        flex: 1;
    }


    /* =========================================================
       MARKA
       ========================================================= */

    .brand-name {
        display: block;

        margin-bottom: 5px;

        color: #a07952;

        font-size: 0.65rem;
        font-weight: 800;

        letter-spacing: 0.06em;

        text-transform: uppercase;
    }


    /* =========================================================
       ÜRÜN ADI
       ========================================================= */

    .product-name {
        display: -webkit-box;

        min-height: 45px;

        overflow: hidden;

        color: #3b2e25;

        font-size: 0.92rem;
        font-weight: 750;
        line-height: 1.45;

        text-decoration: none;

        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;

        transition:
            color 0.2s ease;
    }


    .product-name:hover {
        color: #9a6839;
    }


    /* =========================================================
       ÜRÜN KODU
       ========================================================= */

    .product-code {
        display: flex;
        align-items: center;

        gap: 5px;

        margin-top: 8px;

        color: #9c9085;

        font-size: 0.67rem;
    }


    .product-code i {
        color: #af957c;

        font-size: 0.62rem;
    }


    /* =========================================================
       FİYAT + STOK
       ========================================================= */

    .favorite-price-row {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 10px;

        margin-top: 17px;
    }


    .product-price {
        color: #81562e;

        font-size: 1.08rem;
        font-weight: 800;

        letter-spacing: -0.01em;
    }


    .stock-badge {
        display: inline-flex;
        align-items: center;

        gap: 4px;

        padding: 5px 8px;

        border: 1px solid transparent;
        border-radius: 20px;

        font-size: 0.59rem;
        font-weight: 800;

        white-space: nowrap;
    }


    .stock-badge i {
        font-size: 0.52rem;
    }


    .stock-available {
        color: #4f6c49;

        border-color: #d4e3d0;

        background-color: #eef5ec;
    }


    .stock-empty {
        color: #a05252;

        border-color: #ead1d1;

        background-color: #faeeee;
    }


    /* =========================================================
       ÜRÜNÜ İNCELE
       ========================================================= */

    .favorite-detail-button {
        min-height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        margin-top: 15px;

        padding: 8px 14px;

        border: 1px solid #493225;
        border-radius: 10px;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #493225,
                #8b5e34);

        font-size: 0.72rem;
        font-weight: 700;

        text-decoration: none;

        box-shadow:
            0 5px 14px rgba(73, 50, 37, 0.13);

        transition:
            background 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }


    .favorite-detail-button i {
        font-size: 0.6rem;

        transition:
            transform 0.2s ease;
    }


    .favorite-detail-button:hover {
        color: #ffffff;

        background:
            linear-gradient(135deg,
                #5b3e2b,
                #9b6a3a);

        transform: translateY(-1px);

        box-shadow:
            0 7px 18px rgba(73, 50, 37, 0.18);
    }


    .favorite-detail-button:hover i {
        transform: translateX(2px);
    }


    /* =========================================================
       BOŞ FAVORİLER
       ========================================================= */

    .empty-favorites {
        max-width: 650px;

        margin: 20px auto 0;

        padding: 55px 25px;

        border: 1px solid #e7ddd2;
        border-radius: 20px;

        background-color: #ffffff;

        text-align: center;

        box-shadow:
            0 12px 34px rgba(70, 47, 30, 0.07);
    }


    .empty-icon {
        width: 76px;
        height: 76px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin: 0 auto 17px;

        border-radius: 50%;

        color: #a15757;

        background:
            linear-gradient(145deg,
                #fbf0ee,
                #efd6d0);

        font-size: 1.7rem;
    }


    .empty-favorites-label {
        display: inline-block;

        margin-bottom: 5px;

        color: #9a7042;

        font-size: 0.65rem;
        font-weight: 800;

        letter-spacing: 0.14em;
    }


    .empty-favorites h2 {
        margin: 0 0 8px;

        color: #34281f;

        font-size: 1.35rem;
        font-weight: 800;
    }


    .empty-favorites p {
        max-width: 480px;

        margin: 0 auto 22px;

        color: #897d72;

        font-size: 0.82rem;
        line-height: 1.6;
    }


    .empty-favorites-button {
        min-height: 44px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        padding: 9px 18px;

        border: 1px solid #493225;
        border-radius: 10px;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #493225,
                #8b5e34);

        font-size: 0.77rem;
        font-weight: 700;

        text-decoration: none;

        box-shadow:
            0 5px 15px rgba(73, 50, 37, 0.16);

        transition:
            transform 0.2s ease,
            background 0.2s ease,
            box-shadow 0.2s ease;
    }


    .empty-favorites-button:hover {
        color: #ffffff;

        background:
            linear-gradient(135deg,
                #5b3e2b,
                #9b6a3a);

        transform: translateY(-2px);

        box-shadow:
            0 8px 20px rgba(73, 50, 37, 0.21);
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 991.98px) {

        .favorites-page {
            padding: 40px 0 55px;
        }


        .favorite-image-area {
            height: 250px;
        }

    }


    /* =========================================================
       MOBİL
       ========================================================= */

    @@media (max-width: 767.98px) {

        .favorites-page {
            padding: 30px 0 45px;
        }


        .favorites-header {
            flex-direction: column;
            align-items: flex-start;

            gap: 18px;
        }


        .favorites-header h1 {
            font-size: 1.65rem;
        }


        .favorite-count {
            width: 100%;
        }


        .favorite-image-area {
            height: 235px;
        }

    }


    /* =========================================================
       KÜÇÜK TELEFON
       ========================================================= */

    @@media (max-width: 480px) {

        .favorite-image-area {
            height: 215px;
        }


        .favorite-content {
            padding: 16px;
        }


        .empty-favorites {
            padding: 45px 20px;
        }


        .empty-favorites h2 {
            font-size: 1.2rem;
        }

    }
</style>