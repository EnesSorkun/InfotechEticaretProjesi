@model Contact

@{
    ViewData["Title"] = "İletişim";
}

<section class="contact-section">

    <div class="container">

        <div class="contact-header text-center">
            <span class="contact-label">BİZE ULAŞIN</span>

            <h1>İletişim</h1>

            <p>
                Sorularınız, önerileriniz veya destek talepleriniz için
                bizimle iletişime geçebilirsiniz.
            </p>
        </div>


        @if (TempData["ContactSuccess"] != null)
        {
            <div class="alert alert-success contact-alert">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["ContactSuccess"]
            </div>
        }


        <div class="row g-4">

            <!-- SOL TARAF -->
            <div class="col-lg-4">

                <div class="contact-info-card">

                    <h3>İletişim Bilgileri</h3>

                    <p class="contact-info-description">
                        Aşağıdaki iletişim kanallarından da bize ulaşabilirsiniz.
                    </p>


                    <div class="contact-info-item">

                        <div class="contact-icon">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>

                        <div>
                            <span>Adres</span>
                            <strong>
                                Göztepe / Kadıköy / İstanbul
                            </strong>
                        </div>

                    </div>


                    <div class="contact-info-item">

                        <div class="contact-icon">
                            <i class="fa-solid fa-envelope"></i>
                        </div>

                        <div>
                            <span>Email</span>
                            <strong>
                                info@eticaretsitesi.com
                            </strong>
                        </div>

                    </div>


                    <div class="contact-info-item">

                        <div class="contact-icon">
                            <i class="fa-solid fa-phone"></i>
                        </div>

                        <div>
                            <span>Telefon</span>
                            <strong>
                                0216 444 80 95
                            </strong>
                        </div>

                    </div>

                </div>

            </div>


            <!-- SAĞ TARAF -->
            <div class="col-lg-8">

                <div class="contact-form-card">

                    <div class="contact-form-title">

                        <h3>Bize Mesaj Gönderin</h3>

                        <p>
                            Formu doldurun, en kısa sürede sizinle iletişime geçelim.
                        </p>

                    </div>


                    <form asp-controller="Home" asp-action="ContactUs" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                        </div>


                        <div class="row g-3">

                            <!-- AD -->
                            <div class="col-md-6">

                                <label asp-for="Name" class="form-label">
                                </label>

                                <input asp-for="Name" class="form-control contact-input"
                                       placeholder="Adınızı giriniz" />

                                <span asp-validation-for="Name" class="text-danger small">
                                </span>

                            </div>


                            <!-- SOYAD -->
                            <div class="col-md-6">

                                <label asp-for="Surname" class="form-label">
                                </label>

                                <input asp-for="Surname" class="form-control contact-input"
                                       placeholder="Soyadınızı giriniz" />

                                <span asp-validation-for="Surname" class="text-danger small">
                                </span>

                            </div>


                            <!-- EMAIL -->
                            <div class="col-md-6">

                                <label asp-for="Email" class="form-label">
                                </label>

                                <input asp-for="Email" type="email" class="form-control contact-input"
                                       placeholder="ornek@email.com" />

                                <span asp-validation-for="Email" class="text-danger small">
                                </span>

                            </div>


                            <!-- TELEFON -->
                            <div class="col-md-6">

                                <label asp-for="Phone" class="form-label">
                                </label>

                                <input asp-for="Phone" type="tel" class="form-control contact-input"
                                       placeholder="05xx xxx xx xx" />

                                <span asp-validation-for="Phone" class="text-danger small">
                                </span>

                            </div>


                            <!-- MESAJ -->
                            <div class="col-12">

                                <label asp-for="Message" class="form-label">
                                </label>

                                <textarea asp-for="Message" class="form-control contact-input contact-textarea" rows="6"
                                          placeholder="Mesajınızı yazınız..."></textarea>

                                <span asp-validation-for="Message" class="text-danger small">
                                </span>

                            </div>


                            <!-- BUTON -->
                            <div class="col-12">

                                <button type="submit" class="contact-submit-button">

                                    Mesajı Gönder

                                    <i class="fa-solid fa-paper-plane"></i>

                                </button>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>


<style>
    .contact-section {
        padding: 50px 0 80px;
        background-color: #ffffff;
    }


    /* HEADER */

    .contact-header {
        max-width: 650px;
        margin: 0 auto 45px;
    }

    .contact-label {
        display: block;

        margin-bottom: 8px;

        color: #6c757d;

        font-size: 0.75rem;
        font-weight: 700;

        letter-spacing: 2px;
    }

    .contact-header h1 {
        margin-bottom: 12px;

        color: #212529;

        font-size: 2.5rem;
        font-weight: 800;
    }

    .contact-header p {
        margin: 0;

        color: #6c757d;

        font-size: 1rem;
        line-height: 1.7;
    }


    /* SUCCESS */

    .contact-alert {
        max-width: 800px;

        margin: 0 auto 30px;

        border: 0;
        border-radius: 12px;
    }


    /* SOL KART */

    .contact-info-card {
        height: 100%;

        padding: 35px 30px;

        border-radius: 22px;

        color: #ffffff;

        background-color: #212529;

        box-shadow:
            0 12px 30px rgba(0, 0, 0, 0.10);
    }

    .contact-info-card h3 {
        margin-bottom: 10px;

        font-size: 1.4rem;
        font-weight: 700;
    }

    .contact-info-description {
        margin-bottom: 35px;

        color: rgba(255, 255, 255, 0.65);

        font-size: 0.9rem;
        line-height: 1.6;
    }


    /* İLETİŞİM SATIRI */

    .contact-info-item {
        display: flex;
        align-items: center;

        gap: 15px;

        margin-bottom: 28px;
    }

    .contact-icon {
        width: 45px;
        height: 45px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 12px;

        color: #212529;

        background-color: #ffffff;
    }

    .contact-info-item span {
        display: block;

        margin-bottom: 3px;

        color: rgba(255, 255, 255, 0.55);

        font-size: 0.75rem;
    }

    .contact-info-item strong {
        display: block;

        color: #ffffff;

        font-size: 0.9rem;
        font-weight: 500;

        word-break: break-word;
    }


    /* FORM KART */

    .contact-form-card {
        height: 100%;

        padding: 35px;

        border: 1px solid #e9ecef;
        border-radius: 22px;

        background-color: #ffffff;

        box-shadow:
            0 10px 30px rgba(0, 0, 0, 0.06);
    }

    .contact-form-title {
        margin-bottom: 28px;
    }

    .contact-form-title h3 {
        margin-bottom: 6px;

        color: #212529;

        font-size: 1.4rem;
        font-weight: 700;
    }

    .contact-form-title p {
        margin: 0;

        color: #6c757d;

        font-size: 0.9rem;
    }


    /* INPUT */

    .contact-form-card .form-label {
        margin-bottom: 7px;

        color: #343a40;

        font-size: 0.85rem;
        font-weight: 600;
    }

    .contact-input {
        min-height: 48px;

        border: 1px solid #dee2e6;
        border-radius: 10px;

        background-color: #f8f9fa;

        font-size: 0.9rem;

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background-color 0.2s ease;
    }

    .contact-input:focus {
        border-color: #212529;

        background-color: #ffffff;

        box-shadow:
            0 0 0 0.15rem rgba(33, 37, 41, 0.08);
    }

    .contact-textarea {
        min-height: 150px;

        resize: vertical;
    }


    /* BUTTON */

    .contact-submit-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 9px;

        margin-top: 8px;

        padding: 12px 24px;

        border: 0;
        border-radius: 10px;

        color: #ffffff;

        background-color: #212529;

        font-size: 0.9rem;
        font-weight: 600;

        transition:
            background-color 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .contact-submit-button:hover {
        background-color: #000000;

        transform: translateY(-2px);

        box-shadow:
            0 7px 18px rgba(0, 0, 0, 0.18);
    }


    /* TABLET */

    @@media (max-width: 991.98px) {

        .contact-section {
            padding: 35px 0 60px;
        }

        .contact-header {
            margin-bottom: 30px;
        }

        .contact-info-card,
        .contact-form-card {
            border-radius: 18px;
        }

    }


    /* MOBİL */

    @@media (max-width: 767.98px) {

        .contact-section {
            padding: 25px 0 45px;
        }

        .contact-header h1 {
            font-size: 2rem;
        }

        .contact-header p {
            font-size: 0.9rem;
        }

        .contact-info-card {
            padding: 27px 22px;
        }

        .contact-form-card {
            padding: 27px 20px;
        }

        .contact-submit-button {
            width: 100%;
        }

    }
</style>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}