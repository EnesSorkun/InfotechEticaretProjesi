@model Order

@{
    ViewData["Title"] = "Sipariş Tamamlandı";
}

<section class="order-success-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-7 col-lg-8">

                <div class="order-success-card">

                    <!-- =====================================================
                         BAŞARI İKONU
                         ===================================================== -->
                    <div class="success-icon">

                        <div class="success-icon-inner">
                            <i class="fa-solid fa-check"></i>
                        </div>

                    </div>


                    <!-- =====================================================
                         ÜST BAŞLIK
                         ===================================================== -->
                    <span class="success-label">
                        SİPARİŞ TAMAMLANDI
                    </span>


                    <!-- =====================================================
                         BAŞLIK
                         ===================================================== -->
                    <h1>
                        Siparişiniz Alındı!
                    </h1>


                    <p class="success-description">
                        Siparişiniz başarıyla oluşturuldu.
                        Siparişinizin durumunu hesabınızdaki
                        siparişler bölümünden takip edebilirsiniz.
                    </p>


                    <!-- =====================================================
                         SİPARİŞ BİLGİLERİ
                         ===================================================== -->
                    <div class="order-info-card">

                        <!-- Sipariş Numarası -->
                        <div class="order-info-item">

                            <div class="order-info-icon">

                                <i class="fa-solid fa-receipt"></i>

                            </div>


                            <div class="order-info-content">

                                <span>
                                    Sipariş Numaranız
                                </span>

                                <strong>
                                    @Model.OrderNumber
                                </strong>

                            </div>

                        </div>


                        <div class="order-info-divider"></div>


                        <!-- Sipariş Toplamı -->
                        <div class="order-info-item">

                            <div class="order-info-icon">

                                <i class="fa-solid fa-wallet"></i>

                            </div>


                            <div class="order-info-content">

                                <span>
                                    Sipariş Toplamı
                                </span>

                                <strong class="order-total-price">
                                    @Model.TotalPrice.ToString("N2") ₺
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- =====================================================
                         BİLGİ NOTU
                         ===================================================== -->
                    <div class="order-success-note">

                        <div class="order-success-note-icon">

                            <i class="fa-solid fa-box"></i>

                        </div>


                        <div>

                            <strong>
                                Siparişiniz hazırlanıyor
                            </strong>

                            <p>
                                Sipariş durumundaki gelişmeleri
                                Siparişlerim sayfasından takip edebilirsiniz.
                            </p>

                        </div>

                    </div>


                    <!-- =====================================================
                         BUTONLAR
                         ===================================================== -->
                    <div class="order-success-actions">

                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id"
                           class="order-detail-button">

                            <i class="fa-solid fa-box-open"></i>

                            <span>
                                Sipariş Detayı
                            </span>

                        </a>


                        <a asp-controller="Orders" asp-action="Index" class="orders-button">

                            <i class="fa-solid fa-list"></i>

                            <span>
                                Siparişlerim
                            </span>

                        </a>


                        <a asp-controller="Home" asp-action="Index" class="continue-button">

                            <i class="fa-solid fa-house"></i>

                            <span>
                                Alışverişe Devam Et
                            </span>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<style>
    /* =========================================================
       SAYFA
       ========================================================= */

    .order-success-page {
        min-height: 75vh;

        display: flex;
        align-items: center;

        padding: 65px 0 80px;

        background:
            radial-gradient(circle at top left,
                rgba(190, 145, 91, 0.08),
                transparent 32%),
            radial-gradient(circle at bottom right,
                rgba(139, 94, 52, 0.05),
                transparent 30%),
            linear-gradient(180deg,
                #ffffff 0%,
                #faf7f3 100%);
    }


    /* =========================================================
       ANA KART
       ========================================================= */

    .order-success-card {
        position: relative;

        overflow: hidden;

        padding: 52px 45px 42px;

        border: 1px solid #e7ddd2;
        border-radius: 24px;

        background-color: #ffffff;

        text-align: center;

        box-shadow:
            0 18px 48px rgba(70, 47, 30, 0.09);
    }


    .order-success-card::before {
        content: "";

        position: absolute;

        top: 0;
        left: 50%;

        width: 120px;
        height: 3px;

        border-radius: 0 0 20px 20px;

        background:
            linear-gradient(90deg,
                #8b5e34,
                #d0a16a);

        transform: translateX(-50%);
    }


    /* =========================================================
       BAŞARI İKONU
       ========================================================= */

    .success-icon {
        width: 92px;
        height: 92px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin: 0 auto 20px;

        border-radius: 50%;

        background:
            linear-gradient(145deg,
                #edf5ea,
                #dcebd7);

        box-shadow:
            0 8px 22px rgba(75, 111, 68, 0.12);
    }


    .success-icon-inner {
        width: 62px;
        height: 62px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #5d7d55,
                #7c9a73);

        font-size: 1.35rem;

        box-shadow:
            0 5px 15px rgba(75, 111, 68, 0.20);
    }


    /* =========================================================
       ÜST ETİKET
       ========================================================= */

    .success-label {
        display: inline-block;

        margin-bottom: 7px;

        color: #9a7042;

        font-size: 0.63rem;
        font-weight: 800;

        letter-spacing: 0.16em;
    }


    /* =========================================================
       BAŞLIK
       ========================================================= */

    .order-success-card h1 {
        position: relative;

        margin: 0 0 13px;
        padding-bottom: 13px;

        color: #30251d;

        font-size: 2rem;
        font-weight: 800;

        letter-spacing: -0.025em;
    }


    .order-success-card h1::after {
        content: "";

        position: absolute;

        left: 50%;
        bottom: 0;

        width: 42px;
        height: 3px;

        border-radius: 20px;

        background:
            linear-gradient(90deg,
                #895b2e,
                #d0a16a);

        transform: translateX(-50%);
    }


    /* =========================================================
       AÇIKLAMA
       ========================================================= */

    .success-description {
        max-width: 520px;

        margin: 0 auto 28px;

        color: #887b70;

        font-size: 0.84rem;
        line-height: 1.7;
    }


    /* =========================================================
       SİPARİŞ BİLGİ KARTI
       ========================================================= */

    .order-info-card {
        max-width: 500px;

        display: grid;

        grid-template-columns:
            minmax(0, 1fr) 1px minmax(0, 1fr);

        align-items: center;

        gap: 20px;

        margin: 0 auto 22px;
        padding: 18px 20px;

        border: 1px solid #e6dbcf;
        border-radius: 15px;

        background:
            linear-gradient(145deg,
                #fdfaf6,
                #f7f0e8);
    }


    .order-info-item {
        display: flex;
        align-items: center;

        gap: 11px;

        text-align: left;
    }


    .order-info-icon {
        width: 39px;
        height: 39px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        color: #835a35;

        background-color: #f0dfcd;

        font-size: 0.78rem;
    }


    .order-info-content {
        min-width: 0;
    }


    .order-info-content span {
        display: block;

        margin-bottom: 2px;

        color: #998b7f;

        font-size: 0.61rem;
        font-weight: 600;
    }


    .order-info-content strong {
        display: block;

        overflow: hidden;

        color: #49382c;

        font-size: 0.82rem;
        font-weight: 800;

        text-overflow: ellipsis;

        white-space: nowrap;
    }


    .order-total-price {
        color: #80542d !important;

        font-size: 0.91rem !important;
    }


    .order-info-divider {
        width: 1px;
        height: 45px;

        background-color: #dfd2c5;
    }


    /* =========================================================
       BİLGİ NOTU
       ========================================================= */

    .order-success-note {
        max-width: 500px;

        display: flex;
        align-items: center;

        gap: 11px;

        margin: 0 auto 28px;
        padding: 13px 15px;

        border: 1px solid #e4ddd4;
        border-radius: 12px;

        background-color: #fbf9f6;

        text-align: left;
    }


    .order-success-note-icon {
        width: 36px;
        height: 36px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 9px;

        color: #8b623b;

        background-color: #f0e4d7;

        font-size: 0.72rem;
    }


    .order-success-note strong {
        display: block;

        margin-bottom: 1px;

        color: #554235;

        font-size: 0.7rem;
    }


    .order-success-note p {
        margin: 0;

        color: #978a7f;

        font-size: 0.62rem;
        line-height: 1.5;
    }


    /* =========================================================
       BUTONLAR
       ========================================================= */

    .order-success-actions {
        display: flex;
        align-items: center;
        justify-content: center;

        gap: 9px;

        flex-wrap: wrap;
    }


    .order-detail-button,
    .orders-button,
    .continue-button {
        min-height: 43px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 7px;

        padding: 9px 15px;

        border-radius: 10px;

        font-size: 0.7rem;
        font-weight: 700;

        text-decoration: none;

        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }


    /* =========================================================
       SİPARİŞ DETAY
       ========================================================= */

    .order-detail-button {
        border: 1px solid #493225;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #493225,
                #8b5e34);

        box-shadow:
            0 5px 15px rgba(73, 50, 37, 0.16);
    }


    .order-detail-button:hover {
        color: #ffffff;

        border-color: #9b6a3a;

        background:
            linear-gradient(135deg,
                #5b3e2b,
                #9b6a3a);

        transform: translateY(-2px);

        box-shadow:
            0 8px 20px rgba(73, 50, 37, 0.20);
    }


    /* =========================================================
       SİPARİŞLERİM
       ========================================================= */

    .orders-button {
        border: 1px solid #cdb79f;

        color: #634a37;

        background-color: #fdfaf6;
    }


    .orders-button:hover {
        color: #493225;

        border-color: #ae875f;

        background-color: #f6ede3;

        transform: translateY(-2px);
    }


    /* =========================================================
       ALIŞVERİŞE DEVAM
       ========================================================= */

    .continue-button {
        border: 1px solid #dfd5cb;

        color: #746458;

        background-color: #ffffff;
    }


    .continue-button:hover {
        color: #4f3d30;

        border-color: #c7ae93;

        background-color: #fbf8f4;

        transform: translateY(-2px);
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 991.98px) {

        .order-success-page {
            padding: 50px 0 65px;
        }

    }


    /* =========================================================
       MOBİL
       ========================================================= */

    @@media (max-width: 767.98px) {

        .order-success-page {
            padding: 35px 0 50px;
        }


        .order-success-card {
            padding: 42px 24px 30px;

            border-radius: 19px;
        }


        .success-icon {
            width: 82px;
            height: 82px;
        }


        .success-icon-inner {
            width: 55px;
            height: 55px;
        }


        .order-success-card h1 {
            font-size: 1.65rem;
        }


        .order-info-card {
            grid-template-columns: 1fr;

            gap: 13px;

            text-align: left;
        }


        .order-info-divider {
            width: 100%;
            height: 1px;
        }


        .order-success-actions {
            flex-direction: column;

            align-items: stretch;
        }


        .order-detail-button,
        .orders-button,
        .continue-button {
            width: 100%;
        }

    }


    /* =========================================================
       KÜÇÜK TELEFON
       ========================================================= */

    @@media (max-width: 480px) {

        .order-success-card {
            padding-left: 18px;
            padding-right: 18px;
        }


        .success-description {
            font-size: 0.78rem;
        }


        .order-info-card {
            padding: 15px;
        }

    }
</style>