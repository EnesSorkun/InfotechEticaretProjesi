@model CheckoutViewModel

@{
    ViewData["Title"] = "Ödeme";
}

<section class="checkout-page">

    <div class="container">

        <!-- =====================================================
             SAYFA BAŞLIĞI
             ===================================================== -->
        <div class="checkout-page-header">

            <span class="checkout-page-label">
                ALIŞVERİŞ
            </span>

            <h1>
                Siparişi Tamamla
            </h1>

            <p>
                Teslimat adresinizi seçin ve ödeme bilgilerinizi
                girerek siparişinizi güvenli şekilde tamamlayın.
            </p>

        </div>


        <form asp-controller="Cart"
              asp-action="Checkout"
              method="post">

            @Html.AntiForgeryToken()


            <!-- =====================================================
                 GENEL VALIDATION
                 ===================================================== -->
            <div asp-validation-summary="ModelOnly"
                 class="checkout-validation-summary">
            </div>


            <div class="row g-4">

                <!-- =================================================
                     SOL TARAF
                     ================================================= -->
                <div class="col-lg-8">


                    <!-- =================================================
                         1 - TESLİMAT ADRESİ
                         ================================================= -->
                    <div class="checkout-card mb-4">

                        <div class="checkout-card-header">

                            <div class="checkout-step">
                                1
                            </div>


                            <div class="checkout-card-heading flex-grow-1">

                                <span>
                                    TESLİMAT
                                </span>

                                <h2>
                                    Teslimat Adresi
                                </h2>

                                <p>
                                    Siparişinizin teslim edileceği kayıtlı
                                    adresinizi seçiniz.
                                </p>

                            </div>


                            <a asp-controller="Addresses"
                               asp-action="Create"
                               class="new-address-button">

                                <i class="fa-solid fa-plus"></i>

                                <span>
                                    Yeni Adres
                                </span>

                            </a>

                        </div>


                        <span asp-validation-for="SelectedAddressId"
                              class="text-danger checkout-validation-message">
                        </span>


                        @if (Model.Addresses.Any())
                        {
                            <div class="row g-3">

                                @foreach (var address in Model.Addresses)
                                {
                                    <div class="col-md-6">

                                        <label class="address-select-card">

                                            <input type="radio"
                                                   asp-for="SelectedAddressId"
                                                   value="@address.Id"
                                                   class="address-radio" />


                                            <div class="address-select-content">

                                                <!-- =====================================
                                                     SEÇİM İŞARETİ
                                                     ===================================== -->
                                                <div class="address-selected-icon">

                                                    <i class="fa-solid fa-check"></i>

                                                </div>


                                                <div class="address-select-top">

                                                    <div class="address-title-area">

                                                        <div class="address-icon">

                                                            <i class="fa-solid fa-location-dot"></i>

                                                        </div>


                                                        <div>

                                                            <strong class="address-title">
                                                                @address.Title
                                                            </strong>


                                                            @if (address.IsDefault)
                                                            {
                                                                <span class="default-address-badge">

                                                                    <i class="fa-solid fa-star"></i>

                                                                    Varsayılan

                                                                </span>
                                                            }

                                                        </div>

                                                    </div>

                                                </div>


                                                <div class="address-person">

                                                    <i class="fa-regular fa-user"></i>

                                                    <span>
                                                        @address.Name @address.Surname
                                                    </span>

                                                </div>


                                                <div class="address-details">

                                                    <div class="address-detail-row">

                                                        <i class="fa-regular fa-map"></i>

                                                        <span>
                                                            @address.FullAddress
                                                        </span>

                                                    </div>


                                                    <div class="address-detail-row">

                                                        <i class="fa-solid fa-city"></i>

                                                        <span>
                                                            @address.District / @address.City
                                                        </span>

                                                    </div>


                                                    @if (!string.IsNullOrWhiteSpace(address.PostalCode))
                                                    {
                                                        <div class="address-detail-row">

                                                            <i class="fa-solid fa-envelope"></i>

                                                            <span>
                                                                @address.PostalCode
                                                            </span>

                                                        </div>
                                                    }


                                                    <div class="address-detail-row">

                                                        <i class="fa-solid fa-phone"></i>

                                                        <span>
                                                            @address.Phone
                                                        </span>

                                                    </div>

                                                </div>


                                                <div class="address-select-footer">

                                                    <span>
                                                        Teslimat adresi olarak seç
                                                    </span>

                                                    <i class="fa-regular fa-circle-check"></i>

                                                </div>

                                            </div>

                                        </label>

                                    </div>
                                }

                            </div>


                            <div class="manage-address-area">

                                <a asp-controller="Addresses"
                                   asp-action="Index"
                                   class="manage-address-link">

                                    <i class="fa-solid fa-location-dot"></i>

                                    <span>
                                        Adreslerimi Yönet
                                    </span>

                                    <i class="fa-solid fa-chevron-right"></i>

                                </a>

                            </div>
                        }
                        else
                        {
                            <!-- =============================================
                                 ADRES YOK
                                 ============================================= -->
                            <div class="no-address-warning">

                                <div class="no-address-icon">

                                    <i class="fa-solid fa-location-dot"></i>

                                </div>


                                <div>

                                    <strong>
                                        Kayıtlı adresiniz bulunmuyor
                                    </strong>

                                    <p>
                                        Sipariş verebilmek için önce bir
                                        teslimat adresi eklemeniz gerekiyor.
                                    </p>


                                    <a asp-controller="Addresses"
                                       asp-action="Create">

                                        Yeni adres ekleyin

                                        <i class="fa-solid fa-arrow-right"></i>

                                    </a>

                                </div>

                            </div>
                        }

                    </div>


                    <!-- =================================================
                         2 - ÖDEME BİLGİLERİ
                         ================================================= -->
                    <div class="checkout-card">

                        <div class="checkout-card-header">

                            <div class="checkout-step">
                                2
                            </div>


                            <div class="checkout-card-heading">

                                <span>
                                    ÖDEME
                                </span>

                                <h2>
                                    Ödeme Bilgileri
                                </h2>

                                <p>
                                    Siparişinizi tamamlamak için kart
                                    bilgilerinizi giriniz.
                                </p>

                            </div>

                        </div>


                        <div class="row g-3">

                            <!-- =========================================
                                 KART SAHİBİ
                                 ========================================= -->
                            <div class="col-12">

                                <label asp-for="CardHolderName"
                                       class="checkout-form-label">
                                </label>


                                <div class="checkout-input">

                                    <span class="checkout-input-icon">

                                        <i class="fa-regular fa-user"></i>

                                    </span>


                                    <input asp-for="CardHolderName"
                                           class="form-control"
                                           autocomplete="cc-name"
                                           placeholder="Ad Soyad" />

                                </div>


                                <span asp-validation-for="CardHolderName"
                                      class="text-danger checkout-validation-message">
                                </span>

                            </div>


                            <!-- =========================================
                                 KART NUMARASI
                                 ========================================= -->
                            <div class="col-12">

                                <label asp-for="CardNumber"
                                       class="checkout-form-label">
                                </label>


                                <div class="checkout-input">

                                    <span class="checkout-input-icon">

                                        <i class="fa-regular fa-credit-card"></i>

                                    </span>


                                    <input asp-for="CardNumber"
                                           class="form-control"
                                           autocomplete="cc-number"
                                           inputmode="numeric"
                                           maxlength="19"
                                           placeholder="0000 0000 0000 0000" />

                                </div>


                                <span asp-validation-for="CardNumber"
                                      class="text-danger checkout-validation-message">
                                </span>

                            </div>


                            <!-- =========================================
                                 SON KULLANMA TARİHİ
                                 ========================================= -->
                            <div class="col-md-6">

                                <label asp-for="ExpirationDate"
                                       class="checkout-form-label">
                                </label>


                                <div class="checkout-input">

                                    <span class="checkout-input-icon">

                                        <i class="fa-regular fa-calendar"></i>

                                    </span>


                                    <input asp-for="ExpirationDate"
                                           class="form-control"
                                           autocomplete="cc-exp"
                                           placeholder="AA/YY" />

                                </div>


                                <span asp-validation-for="ExpirationDate"
                                      class="text-danger checkout-validation-message">
                                </span>

                            </div>


                            <!-- =========================================
                                 CVV
                                 ========================================= -->
                            <div class="col-md-6">

                                <label asp-for="Cvv"
                                       class="checkout-form-label">
                                </label>


                                <div class="checkout-input">

                                    <span class="checkout-input-icon">

                                        <i class="fa-solid fa-lock"></i>

                                    </span>


                                    <input asp-for="Cvv"
                                           type="password"
                                           class="form-control"
                                           autocomplete="cc-csc"
                                           inputmode="numeric"
                                           maxlength="4"
                                           placeholder="***" />

                                </div>


                                <span asp-validation-for="Cvv"
                                      class="text-danger checkout-validation-message">
                                </span>

                            </div>

                        </div>


                        <!-- =================================================
                             GÜVENLİ ÖDEME
                             ================================================= -->
                        <div class="payment-security">

                            <div class="payment-security-icon">

                                <i class="fa-solid fa-shield-halved"></i>

                            </div>


                            <div>

                                <strong>
                                    Güvenli Ödeme
                                </strong>

                                <p>
                                    Kart bilgileriniz sipariş kaydında saklanmaz.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     SAĞ TARAF - SİPARİŞ ÖZETİ
                     ================================================= -->
                <div class="col-lg-4">

                    <div class="checkout-summary">

                        <!-- =================================================
                             HEADER
                             ================================================= -->
                        <div class="checkout-summary-header">

                            <div class="summary-header-icon">

                                <i class="fa-solid fa-receipt"></i>

                            </div>


                            <div>

                                <span>
                                    SİPARİŞ
                                </span>

                                <h2>
                                    Sipariş Özeti
                                </h2>

                            </div>

                        </div>


                        <div class="checkout-summary-body">

                            <!-- =================================================
                                 ÜRÜNLER
                                 ================================================= -->
                            <div class="checkout-products">

                                @foreach (var item in Model.CartLines)
                                {
                                    <div class="checkout-product">

                                        <a asp-controller="Products"
                                           asp-action="Details"
                                           asp-route-id="@item.Product.Id"
                                           class="checkout-product-image">

                                            <img src="@item.Product.Image"
                                                 alt="@item.Product.Name" />

                                        </a>


                                        <div class="checkout-product-info">

                                            <a asp-controller="Products"
                                               asp-action="Details"
                                               asp-route-id="@item.Product.Id"
                                               class="checkout-product-name">

                                                @item.Product.Name

                                            </a>


                                            <span class="checkout-product-quantity">

                                                <i class="fa-solid fa-xmark"></i>

                                                @item.Quantity adet

                                            </span>

                                        </div>


                                        <strong class="checkout-product-price">

                                            @((item.Product.Price *
                                                item.Quantity)
                                                .ToString("N2")) ₺

                                        </strong>

                                    </div>
                                }

                            </div>


                            <div class="summary-divider"></div>


                            <!-- =================================================
                                 ÜRÜN TOPLAMI
                                 ================================================= -->
                            <div class="summary-row">

                                <span>
                                    Ürün Toplamı
                                </span>

                                <strong>
                                    @Model.TotalPrice.ToString("N2") ₺
                                </strong>

                            </div>


                            <!-- =================================================
                                 KARGO
                                 ================================================= -->
                            <div class="summary-row">

                                <span>
                                    Kargo
                                </span>

                                <strong class="free-shipping">

                                    <i class="fa-solid fa-check"></i>

                                    Ücretsiz

                                </strong>

                            </div>


                            <div class="summary-divider"></div>


                            <!-- =================================================
                                 GENEL TOPLAM
                                 ================================================= -->
                            <div class="summary-total">

                                <span>
                                    Toplam
                                </span>

                                <strong>
                                    @Model.TotalPrice.ToString("N2") ₺
                                </strong>

                            </div>


                            <!-- =================================================
                                 SİPARİŞİ TAMAMLA
                                 ================================================= -->
                            <button type="submit"
                                    class="complete-order-button"
                                    @(Model.Addresses.Any() ? null : "disabled")>

                                <i class="fa-solid fa-lock"></i>

                                <span>
                                    Siparişi Tamamla
                                </span>

                                <i class="fa-solid fa-chevron-right complete-order-arrow"></i>

                            </button>


                            <div class="summary-security">

                                <i class="fa-solid fa-shield-halved"></i>

                                <span>
                                    Güvenli ödeme
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </form>

    </div>

</section>


<style>

    /* =========================================================
       SAYFA
       ========================================================= */

    .checkout-page {
        min-height: 75vh;

        padding: 55px 0 70px;

        background:
            radial-gradient(
                circle at top left,
                rgba(190, 145, 91, 0.07),
                transparent 32%
            ),
            linear-gradient(
                180deg,
                #ffffff 0%,
                #faf7f3 100%
            );
    }


    /* =========================================================
       SAYFA BAŞLIĞI
       ========================================================= */

    .checkout-page-header {
        margin-bottom: 30px;
    }


    .checkout-page-label {
        display: inline-block;

        margin-bottom: 6px;

        color: #9a7042;

        font-size: 0.67rem;
        font-weight: 800;

        letter-spacing: 0.15em;
    }


    .checkout-page-header h1 {
        position: relative;

        margin: 0 0 10px;
        padding-bottom: 12px;

        color: #30251d;

        font-size: 2rem;
        font-weight: 800;

        letter-spacing: -0.02em;
    }


    .checkout-page-header h1::after {
        content: "";

        position: absolute;

        left: 0;
        bottom: 0;

        width: 42px;
        height: 3px;

        border-radius: 20px;

        background:
            linear-gradient(
                90deg,
                #895b2e,
                #d0a16a
            );
    }


    .checkout-page-header p {
        max-width: 680px;

        margin: 0;

        color: #887b70;

        font-size: 0.84rem;
        line-height: 1.65;
    }


    /* =========================================================
       VALIDATION SUMMARY
       ========================================================= */

    .checkout-validation-summary {
        margin-bottom: 22px;
        padding: 12px 15px;

        border: 1px solid #edd0d0;
        border-radius: 11px;

        color: #a54d4d;

        background-color: #fcf2f2;

        font-size: 0.75rem;
    }


    .checkout-validation-summary:empty {
        display: none;
    }


    .checkout-validation-message {
        display: block;

        margin-top: 5px;

        font-size: 0.7rem;
    }


    /* =========================================================
       CHECKOUT CARD
       ========================================================= */

    .checkout-card {
        padding: 26px;

        border: 1px solid #e7ddd2;
        border-radius: 19px;

        background-color: #ffffff;

        box-shadow:
            0 9px 27px rgba(70, 47, 30, 0.06);
    }


    /* =========================================================
       CARD HEADER
       ========================================================= */

    .checkout-card-header {
        display: flex;
        align-items: center;

        gap: 13px;

        margin-bottom: 24px;
    }


    .checkout-step {
        width: 43px;
        height: 43px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 12px;

        color: #ffffff;

        background:
            linear-gradient(
                135deg,
                #503525,
                #996538
            );

        font-size: 0.82rem;
        font-weight: 800;

        box-shadow:
            0 5px 14px rgba(73, 50, 37, 0.17);
    }


    .checkout-card-heading > span {
        display: block;

        margin-bottom: 1px;

        color: #9a7042;

        font-size: 0.57rem;
        font-weight: 800;

        letter-spacing: 0.12em;
    }


    .checkout-card-heading h2 {
        margin: 0 0 3px;

        color: #3b2d24;

        font-size: 1rem;
        font-weight: 800;
    }


    .checkout-card-heading p {
        margin: 0;

        color: #93867a;

        font-size: 0.7rem;
        line-height: 1.5;
    }


    /* =========================================================
       YENİ ADRES
       ========================================================= */

    .new-address-button {
        min-height: 37px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 6px;

        flex-shrink: 0;

        padding: 7px 11px;

        border: 1px solid #d7c5b3;
        border-radius: 9px;

        color: #684f3c;

        background-color: #ffffff;

        font-size: 0.68rem;
        font-weight: 700;

        text-decoration: none;

        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background-color 0.2s ease,
            transform 0.2s ease;
    }


    .new-address-button:hover {
        color: #ffffff;

        border-color: #80562f;

        background-color: #80562f;

        transform: translateY(-1px);
    }


    /* =========================================================
       ADRES SEÇİMİ
       ========================================================= */

    .address-select-card {
        position: relative;

        display: block;

        height: 100%;

        margin: 0;

        cursor: pointer;
    }


    .address-radio {
        position: absolute;

        opacity: 0;

        pointer-events: none;
    }


    .address-select-content {
        position: relative;

        height: 100%;

        overflow: hidden;

        padding: 17px;

        border: 1.5px solid #e4d9ce;
        border-radius: 14px;

        background:
            linear-gradient(
                145deg,
                #ffffff,
                #fdfbf8
            );

        transition:
            border-color 0.2s ease,
            background-color 0.2s ease,
            box-shadow 0.2s ease,
            transform 0.2s ease;
    }


    .address-select-card:hover .address-select-content {
        border-color: #caae90;

        transform: translateY(-2px);

        box-shadow:
            0 7px 18px rgba(70, 47, 30, 0.07);
    }


    .address-radio:checked + .address-select-content {
        border-color: #95683d;

        background:
            linear-gradient(
                145deg,
                #fffdf9,
                #f8efe4
            );

        box-shadow:
            0 0 0 3px rgba(149, 104, 61, 0.08);
    }


    /* =========================================================
       SEÇİM İKONU
       ========================================================= */

    .address-selected-icon {
        position: absolute;

        top: 11px;
        right: 11px;

        width: 25px;
        height: 25px;

        display: flex;
        align-items: center;
        justify-content: center;

        border: 1px solid #e0d5ca;
        border-radius: 50%;

        color: transparent;

        background-color: #ffffff;

        font-size: 0.56rem;

        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background-color 0.2s ease;
    }


    .address-radio:checked +
    .address-select-content
    .address-selected-icon {
        color: #ffffff;

        border-color: #895d33;

        background-color: #895d33;
    }


    /* =========================================================
       ADRES KARTI İÇİ
       ========================================================= */

    .address-title-area {
        display: flex;
        align-items: center;

        gap: 9px;

        padding-right: 28px;
    }


    .address-icon {
        width: 34px;
        height: 34px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 9px;

        color: #8e6238;

        background-color: #f5e9dc;

        font-size: 0.7rem;
    }


    .address-title {
        display: inline-block;

        color: #45352a;

        font-size: 0.8rem;
        font-weight: 800;
    }


    .default-address-badge {
        display: inline-flex;
        align-items: center;

        gap: 3px;

        margin-left: 5px;
        padding: 3px 6px;

        border: 1px solid #dfc8aa;
        border-radius: 20px;

        color: #80592f;

        background-color: #f8eee2;

        font-size: 0.51rem;
        font-weight: 800;
    }


    .address-person {
        display: flex;
        align-items: center;

        gap: 6px;

        margin: 14px 0 10px;

        color: #554237;

        font-size: 0.72rem;
        font-weight: 700;
    }


    .address-person i {
        color: #a68a70;

        font-size: 0.64rem;
    }


    .address-details {
        display: flex;
        flex-direction: column;

        gap: 7px;
    }


    .address-detail-row {
        display: flex;
        align-items: flex-start;

        gap: 7px;

        color: #8a7d72;

        font-size: 0.66rem;
        line-height: 1.5;
    }


    .address-detail-row i {
        width: 14px;

        margin-top: 3px;

        flex-shrink: 0;

        color: #af9175;

        font-size: 0.58rem;

        text-align: center;
    }


    .address-select-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 10px;

        margin-top: 14px;
        padding-top: 11px;

        border-top: 1px solid #eee4da;

        color: #a09387;

        font-size: 0.59rem;
        font-weight: 600;
    }


    .address-select-footer i {
        color: #b39a80;
    }


    .address-radio:checked +
    .address-select-content
    .address-select-footer {
        color: #805b38;
    }


    .address-radio:checked +
    .address-select-content
    .address-select-footer i {
        color: #805b38;
    }


    /* =========================================================
       ADRESLERİ YÖNET
       ========================================================= */

    .manage-address-area {
        margin-top: 16px;
    }


    .manage-address-link {
        display: inline-flex;
        align-items: center;

        gap: 6px;

        color: #8c623a;

        font-size: 0.68rem;
        font-weight: 700;

        text-decoration: none;
    }


    .manage-address-link i:last-child {
        font-size: 0.5rem;

        transition:
            transform 0.2s ease;
    }


    .manage-address-link:hover {
        color: #60442e;
    }


    .manage-address-link:hover i:last-child {
        transform: translateX(2px);
    }


    /* =========================================================
       ADRES YOK
       ========================================================= */

    .no-address-warning {
        display: flex;
        align-items: flex-start;

        gap: 12px;

        padding: 16px;

        border: 1px solid #e5d4be;
        border-radius: 12px;

        background-color: #fcf6ee;
    }


    .no-address-icon {
        width: 38px;
        height: 38px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        color: #94673b;

        background-color: #f1e1ce;

        font-size: 0.8rem;
    }


    .no-address-warning strong {
        display: block;

        margin-bottom: 3px;

        color: #60472f;

        font-size: 0.75rem;
    }


    .no-address-warning p {
        margin: 0 0 5px;

        color: #927f6d;

