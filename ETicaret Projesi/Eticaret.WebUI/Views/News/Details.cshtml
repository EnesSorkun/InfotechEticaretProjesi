@model News

@{
    ViewData["Title"] = Model.Name;

    int? campaignCategoryId = null;

    if (!string.IsNullOrWhiteSpace(Model.Name))
    {
        var campaignName = Model.Name.ToLowerInvariant();

        if (campaignName.Contains("ateş"))
        {
            campaignCategoryId = 11;
        }
        else if (campaignName.Contains("sıkma"))
        {
            campaignCategoryId = 12;
        }
        else if (campaignName.Contains("damla"))
        {
            campaignCategoryId = 13;
        }
    }
}

<section class="campaign-detail-section">

    <div class="container">

        <!-- =====================================================
             ÜST ALAN
             ===================================================== -->
        <div class="campaign-detail-top">

            <div>

                <span class="campaign-page-label">
                    KEHR-İ BAR
                </span>

                <h1>
                    Kampanya Detayı
                </h1>

                <p>
                    Kehr-i Bar'a özel kampanya ve koleksiyon fırsatlarını keşfedin.
                </p>

            </div>


            <a asp-controller="Home" asp-action="Index" class="campaign-back">

                <i class="fa-solid fa-arrow-left"></i>

                <span>
                    Ana Sayfaya Dön
                </span>

            </a>

        </div>


        <!-- =====================================================
             KAMPANYA DETAY KARTI
             ===================================================== -->
        <div class="campaign-detail-card">

            <!-- =================================================
                 KAMPANYA GÖRSELİ
                 ================================================= -->
            <div class="campaign-detail-image-area">

                @if (!string.IsNullOrWhiteSpace(Model.Image))
                {
                    <img src="@Model.Image" alt="@Model.Name" class="campaign-detail-image" />
                }
                else
                {
                    <div class="campaign-no-image">

                        <div class="campaign-no-image-icon">
                            <i class="fa-regular fa-image"></i>
                        </div>

                        <span>
                            Kampanya görseli bulunamadı.
                        </span>

                    </div>
                }

            </div>


            <!-- =================================================
                 İÇERİK
                 ================================================= -->
            <div class="campaign-detail-content">

                <div class="campaign-detail-eyebrow">

                    <span class="eyebrow-line"></span>

                    <span>
                        ÖZEL KAMPANYA
                    </span>

                </div>


                <h2 class="campaign-detail-title">
                    @Model.Name
                </h2>


                <div class="campaign-title-line"></div>


                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="campaign-detail-description">
                        @Model.Description
                    </p>
                }
                else
                {
                    <p class="campaign-detail-description">
                        Kehr-i Bar'a özel hazırlanan bu kampanya kapsamındaki
                        ürünleri ve koleksiyonları inceleyebilirsiniz.
                    </p>
                }


                <!-- =================================================
                     BİLGİ ALANI
                     ================================================= -->
                <div class="campaign-info">

                    <div class="campaign-info-icon">
                        <i class="fa-solid fa-gem"></i>
                    </div>

                    <div>

                        <strong>
                            Kehr-i Bar'a Özel
                        </strong>

                        <p>
                            Kampanya kapsamındaki tesbih modellerini keşfedin.
                        </p>

                    </div>

                </div>


                @if (campaignCategoryId.HasValue)
                {
                    <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@campaignCategoryId.Value"
                       class="campaign-products-button">

                        <div class="campaign-products-button-content">

                            <i class="fa-solid fa-bag-shopping"></i>

                            <span>
                                Kampanya Ürünlerini İncele
                            </span>

                        </div>

                        <span class="campaign-products-arrow">
                            <i class="fa-solid fa-arrow-right"></i>
                        </span>

                    </a>
                }
                else
                {
                    <a asp-controller="Products" asp-action="Index" class="campaign-products-button">

                        <div class="campaign-products-button-content">

                            <i class="fa-solid fa-bag-shopping"></i>

                            <span>
                                Ürünleri İncele
                            </span>

                        </div>

                        <span class="campaign-products-arrow">
                            <i class="fa-solid fa-arrow-right"></i>
                        </span>

                    </a>
                }


                <!-- =================================================
                     ALT NOT
                     ================================================= -->
                <div class="campaign-bottom-note">

                    <i class="fa-solid fa-gem"></i>

                    <span>
                        Kehr-i Bar Kehribar Tesbih Koleksiyonları
                    </span>

                </div>

            </div>

        </div>

    </div>

</section>


<style>
    /* =========================================================
       SAYFA
       ========================================================= */

    .campaign-detail-section {
        min-height: 75vh;

        padding: 55px 0 75px;

        background:
            radial-gradient(circle at top left,
                rgba(190, 145, 91, 0.07),
                transparent 32%),
            linear-gradient(180deg,
                #ffffff 0%,
                #faf7f3 100%);
    }


    /* =========================================================
       ÜST ALAN
       ========================================================= */

    .campaign-detail-top {
        display: flex;

        align-items: flex-end;
        justify-content: space-between;

        gap: 25px;

        margin-bottom: 28px;
    }


    .campaign-page-label {
        display: inline-block;

        margin-bottom: 6px;

        color: #9a7042;

        font-size: 0.65rem;
        font-weight: 800;

        letter-spacing: 0.15em;
    }


    .campaign-detail-top h1 {
        position: relative;

        margin: 0 0 9px;

        padding-bottom: 12px;

        color: #30251d;

        font-size: 2rem;
        font-weight: 800;

        letter-spacing: -0.02em;
    }


    .campaign-detail-top h1::after {
        content: "";

        position: absolute;

        left: 0;
        bottom: 0;

        width: 44px;
        height: 3px;

        border-radius: 20px;

        background:
            linear-gradient(90deg,
                #895b2e,
                #d0a16a);
    }


    .campaign-detail-top p {
        max-width: 620px;

        margin: 0;

        color: #887b70;

        font-size: 0.82rem;
        line-height: 1.65;
    }


    /* =========================================================
       GERİ DÖN
       ========================================================= */

    .campaign-back {
        min-height: 42px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 8px;

        flex-shrink: 0;

        padding: 9px 14px;

        border: 1px solid #d8c9ba;
        border-radius: 10px;

        color: #66503f;

        background-color: #ffffff;

        font-size: 0.72rem;
        font-weight: 700;

        text-decoration: none;

        box-shadow:
            0 4px 12px rgba(70, 47, 30, 0.04);

        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background-color 0.2s ease,
            transform 0.2s ease;
    }


    .campaign-back:hover {
        color: #493529;

        border-color: #bd9e7d;

        background-color: #faf6f1;

        transform: translateX(-2px);
    }


    /* =========================================================
       ANA KART
       ========================================================= */

    .campaign-detail-card {
        overflow: hidden;

        border: 1px solid #e5d9cd;
        border-radius: 24px;

        background-color: #ffffff;

        box-shadow:
            0 18px 45px rgba(70, 47, 30, 0.09);
    }


    /* =========================================================
       GÖRSEL ALANI
       ========================================================= */

    .campaign-detail-image-area {
        width: 100%;

        display: flex;

        align-items: center;
        justify-content: center;

        padding: 24px;

        border-bottom: 1px solid #eee5dc;

        background:
            linear-gradient(145deg,
                #fbf8f4,
                #f5eee6);
    }


    /* =========================================================
       GÖRSEL

       GÖRSEL KESİLMEZ.
       ORİJİNAL ORANINI KORUR.
       ========================================================= */

    .campaign-detail-image {
        display: block;

        width: 100%;
        height: auto;

        max-height: 720px;

        object-fit: contain;
        object-position: center;

        border-radius: 17px;

        box-shadow:
            0 10px 28px rgba(61, 40, 26, 0.08);

        transition:
            transform 0.45s ease;
    }


    .campaign-detail-card:hover .campaign-detail-image {
        transform: scale(1.008);
    }


    /* =========================================================
       GÖRSEL YOK
       ========================================================= */

    .campaign-no-image {
        width: 100%;

        min-height: 420px;

        display: flex;
        flex-direction: column;

        align-items: center;
        justify-content: center;

        gap: 14px;

        color: #89796c;

        text-align: center;
    }


    .campaign-no-image-icon {
        width: 70px;
        height: 70px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 50%;

        color: #8b5e34;

        background-color: #eee0d0;

        font-size: 1.6rem;
    }


    /* =========================================================
       İÇERİK
       ========================================================= */

    .campaign-detail-content {
        max-width: 860px;

        margin: 0 auto;

        padding: 46px 42px 42px;

        text-align: center;
    }


    /* =========================================================
       EYEBROW
       ========================================================= */

    .campaign-detail-eyebrow {
        display: flex;

        align-items: center;
        justify-content: center;

        gap: 9px;

        margin-bottom: 12px;

        color: #9a7042;

        font-size: 0.61rem;
        font-weight: 800;

        letter-spacing: 0.15em;
    }


    .eyebrow-line {
        width: 24px;
        height: 2px;

        display: block;

        border-radius: 20px;

        background-color: #c69764;
    }


    /* =========================================================
       BAŞLIK
       ========================================================= */

    .campaign-detail-title {
        margin: 0;

        color: #30251d;

        font-size: clamp(1.8rem,
                3vw,
                2.75rem);

        font-weight: 800;

        line-height: 1.18;

        letter-spacing: -0.025em;
    }


    .campaign-title-line {
        width: 55px;
        height: 3px;

        margin: 20px auto;

        border-radius: 20px;

        background:
            linear-gradient(90deg,
                #895b2e,
                #d0a16a);
    }


    /* =========================================================
       AÇIKLAMA
       ========================================================= */

    .campaign-detail-description {
        max-width: 680px;

        margin: 0 auto;

        color: #817469;

        font-size: 0.9rem;

        line-height: 1.9;

        white-space: pre-line;
    }


    /* =========================================================
       BİLGİ KARTI
       ========================================================= */

    .campaign-info {
        max-width: 570px;

        display: flex;

        align-items: center;

        gap: 13px;

        margin:
            32px auto 18px;

        padding: 15px 17px;

        border: 1px solid #e5dacf;
        border-radius: 13px;

        background:
            linear-gradient(145deg,
                #fcf9f5,
                #f8f2eb);

        text-align: left;
    }


    .campaign-info-icon {
        width: 42px;
        height: 42px;

        display: flex;

        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 10px;

        color: #835a35;

        background-color: #eee0d1;

        font-size: 0.78rem;
    }


    .campaign-info strong {
        display: block;

        margin-bottom: 3px;

        color: #584333;

        font-size: 0.74rem;
        font-weight: 800;
    }


    .campaign-info p {
        margin: 0;

        color: #938579;

        font-size: 0.66rem;

        line-height: 1.55;
    }


    /* =========================================================
       ÜRÜNLERİ İNCELE
       ========================================================= */

    .campaign-products-button {
        max-width: 570px;

        min-height: 50px;

        display: flex;

        align-items: center;
        justify-content: space-between;

        gap: 10px;

        margin: 0 auto;

        padding: 10px 11px 10px 17px;

        border: 1px solid #493225;
        border-radius: 11px;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #493225,
                #8b5e34);

        font-size: 0.76rem;
        font-weight: 750;

        text-decoration: none;

        box-shadow:
            0 7px 18px rgba(73, 50, 37, 0.17);

        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }


    .campaign-products-button-content {
        display: flex;

        align-items: center;

        gap: 9px;
    }


    .campaign-products-arrow {
        width: 31px;
        height: 31px;

        display: flex;

        align-items: center;
        justify-content: center;

        border-radius: 8px;

        background-color:
            rgba(255, 255, 255, 0.12);

        font-size: 0.6rem;

        transition:
            transform 0.2s ease,
            background-color 0.2s ease;
    }


    .campaign-products-button:hover {
        color: #ffffff;

        transform: translateY(-2px);

        box-shadow:
            0 10px 22px rgba(73, 50, 37, 0.22);
    }


    .campaign-products-button:hover .campaign-products-arrow {
        transform: translateX(3px);

        background-color:
            rgba(255, 255, 255, 0.18);
    }


    /* =========================================================
       ALT NOT
       ========================================================= */

    .campaign-bottom-note {
        display: flex;

        align-items: center;
        justify-content: center;

        gap: 7px;

        margin-top: 14px;

        color: #a09387;

        font-size: 0.59rem;
    }


    .campaign-bottom-note i {
        color: #9b7959;
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 991.98px) {

        .campaign-detail-section {
            padding: 40px 0 55px;
        }


        .campaign-detail-image-area {
            padding: 19px;
        }


        .campaign-detail-content {
            padding: 38px 30px;
        }

    }


    /* =========================================================
       MOBİL
       ========================================================= */

    @@media (max-width: 767.98px) {

        .campaign-detail-section {
            padding: 30px 0 45px;
        }


        .campaign-detail-top {
            flex-direction: column;

            align-items: flex-start;

            gap: 17px;
        }


        .campaign-detail-top h1 {
            font-size: 1.65rem;
        }


        .campaign-back {
            width: 100%;
        }


        .campaign-detail-card {
            border-radius: 18px;
        }


        .campaign-detail-image-area {
            padding: 12px;
        }


        .campaign-detail-image {
            border-radius: 13px;
        }


        .campaign-detail-content {
            padding: 31px 21px;
        }


        .campaign-detail-title {
            font-size: 1.65rem;
        }


        .campaign-detail-description {
            font-size: 0.81rem;

            line-height: 1.8;
        }


        .campaign-info {
            margin-top: 27px;
        }

    }


    /* =========================================================
       KÜÇÜK TELEFON
       ========================================================= */

    @@media (max-width: 480px) {

        .campaign-detail-image-area {
            padding: 8px;
        }


        .campaign-detail-image {
            border-radius: 11px;
        }


        .campaign-detail-content {
            padding: 27px 17px;
        }


        .campaign-detail-title {
            font-size: 1.45rem;
        }


        .campaign-info {
            align-items: flex-start;
        }


        .campaign-products-button {
            min-height: 47px;
        }

    }
</style>