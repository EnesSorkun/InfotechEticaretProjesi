@model News

@{
    ViewData["Title"] = Model.Name;
}

<section class="campaign-detail-section">

    <div class="container">

        <!-- =====================================================
             ÜST ALAN
             ===================================================== -->
        <div class="campaign-detail-top">

            <div>

                <span class="campaign-page-label">
                    KAMPANYALAR
                </span>

                <h1>
                    Kampanya Detayı
                </h1>

                <p>
                    Kehr-i Bar'a özel kampanya ve fırsatların detaylarını inceleyin.
                </p>

            </div>


            <a asp-controller="Home" asp-action="Index" class="campaign-back">

                <i class="fa-solid fa-arrow-left"></i>

                <span>
                    Ana Sayfaya Dön
                </span>

            </a>

        </div>


        <!-- =====================================================
             KAMPANYA DETAY KARTI
             ===================================================== -->
        <div class="campaign-detail-card">

            <div class="row g-0 align-items-stretch">

                <!-- =================================================
                     SOL TARAF - GÖRSEL
                     ================================================= -->
                <div class="col-lg-7">

                    <div class="campaign-detail-image-wrapper">

                        <img src="@Model.Image" alt="@Model.Name" class="campaign-detail-image" />


                        <!-- Görsel Overlay -->
                        <div class="campaign-detail-overlay"></div>


                        <!-- Kampanya Badge -->
                        <div class="campaign-detail-badge">

                            <span class="campaign-badge-icon">
                                <i class="fa-solid fa-bolt"></i>
                            </span>

                            <span>
                                Kampanya
                            </span>

                        </div>


                        <!-- Alt Marka Alanı -->
                        <div class="campaign-image-brand">

                            <span>
                                KEHR-İ BAR
                            </span>

                            <strong>
                                Özel Koleksiyonlar
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     SAĞ TARAF - İÇERİK
                     ================================================= -->
                <div class="col-lg-5">

                    <div class="campaign-detail-content">

                        <!-- =========================================
                             ÜST İÇERİK
                             ========================================= -->
                        <div>

                            <div class="campaign-detail-eyebrow">

                                <span class="eyebrow-line"></span>

                                <span>
                                    ÖZEL FIRSAT
                                </span>

                            </div>


                            <h2 class="campaign-detail-title">
                                @Model.Name
                            </h2>


                            <div class="campaign-title-line"></div>


                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                <p class="campaign-detail-description">
                                    @Model.Description
                                </p>
                            }
                            else
                            {
                                <p class="campaign-detail-description">
                                    Bu kampanyaya özel ürünleri ve fırsatları
                                    inceleyebilirsiniz.
                                </p>
                            }

                        </div>


                        <!-- =========================================
                             ALT ALAN
                             ========================================= -->
                        <div class="campaign-detail-bottom">

                            <!-- Bilgilendirme -->
                            <div class="campaign-info">

                                <div class="campaign-info-icon">

                                    <i class="fa-solid fa-gem"></i>

                                </div>


                                <div>

                                    <strong>
                                        Kehr-i Bar'a Özel
                                    </strong>

                                    <p>
                                        Kampanya kapsamındaki ürünleri inceleyerek
                                        size uygun tesbih modellerini keşfedebilirsiniz.
                                    </p>

                                </div>

                            </div>


                            <!-- Ürünleri İncele -->
                            <a asp-controller="Products" asp-action="Index" class="campaign-products-button">

                                <div class="campaign-products-button-content">

                                    <i class="fa-solid fa-bag-shopping"></i>

                                    <span>
                                        Ürünleri İncele
                                    </span>

                                </div>


                                <span class="campaign-products-arrow">

                                    <i class="fa-solid fa-arrow-right"></i>

                                </span>

                            </a>


                            <!-- Alt Güven / Marka Bilgisi -->
                            <div class="campaign-bottom-note">

                                <i class="fa-solid fa-gem"></i>

                                <span>
                                    Kehr-i Bar Kehribar Tesbih Koleksiyonları
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<style>
    /* =========================================================
       SAYFA
       ========================================================= */

    .campaign-detail-section {
        min-height: 75vh;

        padding: 55px 0 75px;

        background:
            radial-gradient(circle at top left,
                rgba(190, 145, 91, 0.07),
                transparent 32%),
            linear-gradient(180deg,
                #ffffff 0%,
                #faf7f3 100%);
    }


    /* =========================================================
       ÜST ALAN
       ========================================================= */

    .campaign-detail-top {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 25px;

        margin-bottom: 28px;
    }


    .campaign-page-label {
        display: inline-block;

        margin-bottom: 6px;

        color: #9a7042;

        font-size: 0.65rem;
        font-weight: 800;

        letter-spacing: 0.15em;
    }


    .campaign-detail-top h1 {
        position: relative;

        margin: 0 0 9px;
        padding-bottom: 12px;

        color: #30251d;

        font-size: 2rem;
        font-weight: 800;

        letter-spacing: -0.02em;
    }


    .campaign-detail-top h1::after {
        content: "";

        position: absolute;

        left: 0;
        bottom: 0;

        width: 42px;
        height: 3px;

        border-radius: 20px;

        background:
            linear-gradient(90deg,
                #895b2e,
                #d0a16a);
    }


    .campaign-detail-top p {
        max-width: 600px;

        margin: 0;

        color: #887b70;

        font-size: 0.8rem;
        line-height: 1.6;
    }


    /* =========================================================
       GERİ DÖN
       ========================================================= */

    .campaign-back {
        min-height: 40px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 7px;

        flex-shrink: 0;

        padding: 8px 13px;

        border: 1px solid #d8c9ba;
        border-radius: 9px;

        color: #66503f;

        background-color: #ffffff;

        font-size: 0.69rem;
        font-weight: 700;

        text-decoration: none;

        box-shadow:
            0 4px 12px rgba(70, 47, 30, 0.04);

        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background-color 0.2s ease,
            transform 0.2s ease;
    }


    .campaign-back:hover {
        color: #493529;

        border-color: #bd9e7d;

        background-color: #faf6f1;

        transform: translateX(-2px);
    }


    /* =========================================================
       ANA KART
       ========================================================= */

    .campaign-detail-card {
        overflow: hidden;

        border: 1px solid #e5d9cd;
        border-radius: 23px;

        background-color: #ffffff;

        box-shadow:
            0 16px 42px rgba(70, 47, 30, 0.09);
    }


    /* =========================================================
       GÖRSEL
       ========================================================= */

    .campaign-detail-image-wrapper {
        position: relative;

        width: 100%;
        height: 100%;
        min-height: 555px;

        overflow: hidden;

        background:
            linear-gradient(145deg,
                #f7f1ea,
                #eee2d5);
    }


    .campaign-detail-image {
        position: absolute;

        inset: 0;

        width: 100%;
        height: 100%;

        object-fit: cover;
        object-position: center;

        transition:
            transform 0.7s ease;
    }


    .campaign-detail-card:hover .campaign-detail-image {
        transform: scale(1.025);
    }


    /* =========================================================
       GÖRSEL OVERLAY
       ========================================================= */

    .campaign-detail-overlay {
        position: absolute;

        inset: 0;

        pointer-events: none;

        background:
            linear-gradient(180deg,
                rgba(38, 27, 19, 0.03) 35%,
                rgba(38, 27, 19, 0.52) 100%);
    }


    /* =========================================================
       KAMPANYA BADGE
       ========================================================= */

    .campaign-detail-badge {
        position: absolute;

        z-index: 2;

        top: 20px;
        left: 20px;

        display: inline-flex;
        align-items: center;

        gap: 7px;

        padding: 6px 11px 6px 7px;

        border: 1px solid rgba(255, 255, 255, 0.55);
        border-radius: 30px;

        color: #583e2a;

        background-color: rgba(255, 250, 244, 0.94);

        font-size: 0.64rem;
        font-weight: 800;

        box-shadow:
            0 5px 15px rgba(43, 29, 19, 0.13);

        backdrop-filter: blur(9px);
    }


    .campaign-badge-icon {
        width: 22px;
        height: 22px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #80542d,
                #bd8248);

        font-size: 0.52rem;
    }


    /* =========================================================
       GÖRSEL ALT MARKA
       ========================================================= */

    .campaign-image-brand {
        position: absolute;

        z-index: 2;

        left: 25px;
        bottom: 24px;

        display: flex;
        flex-direction: column;
    }


    .campaign-image-brand span {
        margin-bottom: 2px;

        color: rgba(255, 255, 255, 0.76);

        font-size: 0.54rem;
        font-weight: 800;

        letter-spacing: 0.16em;
    }


    .campaign-image-brand strong {
        color: #ffffff;

        font-size: 0.88rem;
        font-weight: 700;

        text-shadow:
            0 2px 10px rgba(0, 0, 0, 0.18);
    }


    /* =========================================================
       SAĞ İÇERİK
       ========================================================= */

    .campaign-detail-content {
        display: flex;
        flex-direction: column;
        justify-content: space-between;

        height: 100%;
        min-height: 555px;

        padding: 45px 38px;

        background:
            radial-gradient(circle at top right,
                rgba(194, 143, 87, 0.06),
                transparent 35%),
            #ffffff;
    }


    /* =========================================================
       EYEBROW
       ========================================================= */

    .campaign-detail-eyebrow {
        display: flex;
        align-items: center;

        gap: 8px;

        margin-bottom: 11px;

        color: #9a7042;

        font-size: 0.59rem;
        font-weight: 800;

        letter-spacing: 0.14em;
    }


    .eyebrow-line {
        width: 21px;
        height: 2px;

        display: block;

        border-radius: 20px;

        background-color: #c69764;
    }


    /* =========================================================
       BAŞLIK
       ========================================================= */

    .campaign-detail-title {
        margin: 0;

        color: #30251d;

        font-size: clamp(1.8rem, 2.7vw, 2.65rem);
        font-weight: 800;
        line-height: 1.17;

        letter-spacing: -0.025em;
    }


    .campaign-title-line {
        width: 48px;
        height: 3px;

        margin: 19px 0;

        border-radius: 20px;

        background:
            linear-gradient(90deg,
                #895b2e,
                #d0a16a);
    }


    /* =========================================================
       AÇIKLAMA
       ========================================================= */

    .campaign-detail-description {
        margin: 0;

        color: #817469;

        font-size: 0.84rem;
        line-height: 1.85;

        white-space: pre-line;
    }


    /* =========================================================
       ALT ALAN
       ========================================================= */

    .campaign-detail-bottom {
        margin-top: 38px;
    }


    /* =========================================================
       BİLGİ KARTI
       ========================================================= */

    .campaign-info {
        display: flex;
        align-items: center;

        gap: 11px;

        margin-bottom: 16px;
        padding: 13px;

        border: 1px solid #e5dacf;
        border-radius: 11px;

        background:
            linear-gradient(145deg,
                #fcf9f5,
                #f8f2eb);
    }


    .campaign-info-icon {
        width: 37px;
        height: 37px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 9px;

        color: #835a35;

        background-color: #eee0d1;

        font-size: 0.72rem;
    }


    .campaign-info strong {
        display: block;

        margin-bottom: 2px;

        color: #584333;

        font-size: 0.7rem;
        font-weight: 800;
    }


    .campaign-info p {
        margin: 0;

        color: #938579;

        font-size: 0.62rem;
        line-height: 1.5;
    }


    /* =========================================================
       ÜRÜNLERİ İNCELE BUTONU
       ========================================================= */

    .campaign-products-button {
        width: 100%;
        min-height: 47px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 10px;

        padding: 9px 10px 9px 15px;

        border: 1px solid #493225;
        border-radius: 10px;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #493225,
                #8b5e34);

        font-size: 0.73rem;
        font-weight: 750;

        text-decoration: none;

        box-shadow:
            0 6px 16px rgba(73, 50, 37, 0.16);

        transition:
            background 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }


    .campaign-products-button-content {
        display: flex;
        align-items: center;

        gap: 8px;
    }


    .campaign-products-button-content>i {
        font-size: 0.68rem;
    }


    .campaign-products-arrow {
        width: 29px;
        height: 29px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 8px;

        background-color: rgba(255, 255, 255, 0.11);

        font-size: 0.57rem;

        transition:
            transform 0.2s ease,
            background-color 0.2s ease;
    }


    .campaign-products-button:hover {
        color: #ffffff;

        background:
            linear-gradient(135deg,
                #5b3e2b,
                #9b6a3a);

        transform: translateY(-2px);

        box-shadow:
            0 8px 20px rgba(73, 50, 37, 0.22);
    }


    .campaign-products-button:hover .campaign-products-arrow {
        background-color: rgba(255, 255, 255, 0.17);

        transform: translateX(2px);
    }


    /* =========================================================
       ALT NOT
       ========================================================= */

    .campaign-bottom-note {
        display: flex;
        align-items: center;
        justify-content: center;

        gap: 6px;

        margin-top: 12px;

        color: #a09387;

        font-size: 0.57rem;
    }


    .campaign-bottom-note i {
        color: #9b7959;

        font-size: 0.56rem;
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 991.98px) {

        .campaign-detail-section {
            padding: 40px 0 55px;
        }


        .campaign-detail-card {
            border-radius: 20px;
        }


        .campaign-detail-image-wrapper {
            height: 430px;
            min-height: 0;
        }


        .campaign-detail-image {
            position: relative;
        }


        .campaign-detail-content {
            min-height: auto;

            padding: 35px;
        }


        .campaign-detail-bottom {
            margin-top: 30px;
        }

    }


    /* =========================================================
       MOBİL
       ========================================================= */

    @@media (max-width: 767.98px) {

        .campaign-detail-section {
            padding: 30px 0 45px;
        }


        .campaign-detail-top {
            flex-direction: column;
            align-items: flex-start;

            gap: 17px;
        }


        .campaign-detail-top h1 {
            font-size: 1.65rem;
        }


        .campaign-back {
            width: 100%;
        }


        .campaign-detail-card {
            border-radius: 17px;
        }


        .campaign-detail-image-wrapper {
            height: 310px;
        }


        .campaign-detail-badge {
            top: 13px;
            left: 13px;
        }


        .campaign-image-brand {
            left: 17px;
            bottom: 17px;
        }


        .campaign-detail-content {
            padding: 27px 22px;
        }


        .campaign-detail-title {
            font-size: 1.65rem;
        }


        .campaign-detail-description {
            font-size: 0.79rem;
            line-height: 1.75;
        }


        .campaign-detail-bottom {
            margin-top: 27px;
        }

    }


    /* =========================================================
       KÜÇÜK TELEFON
       ========================================================= */

    @@media (max-width: 480px) {

        .campaign-detail-image-wrapper {
            height: 250px;
        }


        .campaign-detail-content {
            padding: 23px 18px;
        }


        .campaign-detail-title {
            font-size: 1.45rem;
        }


        .campaign-info {
            align-items: flex-start;
        }


        .campaign-products-button {
            min-height: 45px;
        }

    }
</style>