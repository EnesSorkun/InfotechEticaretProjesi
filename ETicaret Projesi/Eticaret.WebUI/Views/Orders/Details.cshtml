@model Order

@{
    ViewData["Title"] = "Sipariş Detayı";
}

<div class="container py-5">

    <!-- =====================================================
         ÜST ALAN
         ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div class="order-detail-header">
            <span>Sipariş Detayı</span>

            <h1>@Model.OrderNumber</h1>

            <p>
                @(Model.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
            </p>
        </div>


        <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary">

            <i class="fa-solid fa-arrow-left me-2"></i>

            Siparişlerime Dön

        </a>

    </div>


    <div class="row g-4">

        <!-- =================================================
             SOL TARAF
             ================================================= -->

        <div class="col-lg-8">

            <!-- =================================================
                 ÜRÜNLER
                 ================================================= -->

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <h2 class="h5 fw-bold mb-4">
                        Siparişteki Ürünler
                    </h2>


                    @if (!Model.OrderDetails.Any())
                    {
                        <div class="alert alert-warning mb-0">

                            Bu siparişe ait ürün bilgisi bulunamadı.

                        </div>
                    }
                    else
                    {
                        @foreach (var item in Model.OrderDetails)
                        {
                            <div class="order-product">

                                <!-- Ürün Görseli -->

                                <div class="product-image">

                                    @if (item.Product is not null &&
                                         !string.IsNullOrWhiteSpace(item.Product.Image))
                                    {
                                        <img src="@item.Product.Image" alt="@item.Product.Name" />
                                    }
                                    else
                                    {
                                        <div class="no-image">

                                            <i class="fa-solid fa-image"></i>

                                        </div>
                                    }

                                </div>


                                <!-- Ürün Bilgileri -->

                                <div class="flex-grow-1">

                                    <strong class="d-block">

                                        @if (item.Product is not null)
                                        {
                                            @item.Product.Name
                                        }
                                        else
                                        {
                                            <span>Ürün</span>
                                        }

                                    </strong>


                                    <span class="text-muted small">

                                        @item.Quantity adet ×
                                        @item.UnitPrice.ToString("N2") ₺

                                    </span>

                                </div>


                                <!-- Satır Toplamı -->

                                <strong>

                                    @((item.UnitPrice * item.Quantity)
                                        .ToString("N2")) ₺

                                </strong>

                            </div>
                        }
                    }

                </div>

            </div>


            <!-- =================================================
                 TESLİMAT ADRESİ
                 ================================================= -->

            <div class="card border-0 shadow-sm mt-4">

                <div class="card-body p-4">

                    <h2 class="h5 fw-bold mb-3">

                        <i class="fa-solid fa-location-dot me-2"></i>

                        Teslimat Adresi

                    </h2>


                    <p class="text-muted mb-0">
                        @Model.DeliveryAddress
                    </p>

                </div>

            </div>


            <!-- =================================================
                 FATURA ADRESİ
                 ================================================= -->

            <div class="card border-0 shadow-sm mt-4">

                <div class="card-body p-4">

                    <h2 class="h5 fw-bold mb-3">

                        <i class="fa-solid fa-file-invoice me-2"></i>

                        Fatura Adresi

                    </h2>


                    <p class="text-muted mb-0">
                        @Model.BillingAddress
                    </p>

                </div>

            </div>

        </div>


        <!-- =================================================
             SAĞ TARAF - ÖZET
             ================================================= -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm order-summary">

                <div class="card-body p-4">

                    <h2 class="h5 fw-bold mb-4">
                        Sipariş Özeti
                    </h2>


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Farklı Ürün
                        </span>

                        <strong>
                            @Model.OrderDetails.Count
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Toplam Adet
                        </span>

                        <strong>
                            @Model.OrderDetails.Sum(x => x.Quantity)
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Kargo
                        </span>

                        <strong class="text-success">
                            Ücretsiz
                        </strong>

                    </div>


                    <hr />


                    <div class="d-flex justify-content-between align-items-center">

                        <strong>
                            Toplam
                        </strong>

                        <strong class="fs-5">
                            @Model.TotalPrice.ToString("N2") ₺
                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<style>
    .order-product {
        display: flex;
        align-items: center;

        gap: 15px;

        padding: 18px 0;

        border-bottom: 1px solid #eeeeee;
    }


    .order-product:last-child {
        border-bottom: none;
    }


    .product-image {
        width: 75px;
        height: 75px;

        flex-shrink: 0;
    }


    .product-image img {
        width: 100%;
        height: 100%;

        object-fit: contain;

        border-radius: 10px;
    }


    .no-image {
        width: 100%;
        height: 100%;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background-color: #f1f3f5;

        color: #adb5bd;
    }


    .order-summary {
        position: sticky;

        top: 20px;
    }


    @@media (max-width: 991.98px) {

        .order-summary {
            position: static;
        }

    }
</style>