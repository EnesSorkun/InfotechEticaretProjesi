@model Address

@{
    ViewData["Title"] = "Adres Ekle";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="mb-4">

                <h1 class="fw-bold mb-1">
                    Yeni Adres Ekle
                </h1>

                <p class="text-muted mb-0">
                    Siparişlerinizin teslim edileceği adres bilgilerini girin.
                </p>

            </div>


            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <form asp-action="Create" method="post">

                        @Html.AntiForgeryToken()


                        <div asp-validation-summary="ModelOnly" class="alert alert-danger">
                        </div>


                        <div class="row g-3">


                            <div class="col-12">

                                <label asp-for="Title" class="form-label fw-semibold">
                                </label>

                                <input asp-for="Title" class="form-control" placeholder="Ev, İş, Ailem..." />

                                <span asp-validation-for="Title" class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="Name" class="form-label fw-semibold">
                                </label>

                                <input asp-for="Name" class="form-control" />

                                <span asp-validation-for="Name" class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="Surname" class="form-label fw-semibold">
                                </label>

                                <input asp-for="Surname" class="form-control" />

                                <span asp-validation-for="Surname" class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="Phone" class="form-label fw-semibold">
                                </label>

                                <input asp-for="Phone" class="form-control" placeholder="05xx xxx xx xx" />

                                <span asp-validation-for="Phone" class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="PostalCode" class="form-label fw-semibold">
                                </label>

                                <input asp-for="PostalCode" class="form-control" />

                            </div>


                            <div class="col-md-6">

                                <label asp-for="City" class="form-label fw-semibold">
                                </label>

                                <input asp-for="City" class="form-control" />

                                <span asp-validation-for="City" class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label asp-for="District" class="form-label fw-semibold">
                                </label>

                                <input asp-for="District" class="form-control" />

                                <span asp-validation-for="District" class="text-danger small">
                                </span>

                            </div>


                            <div class="col-12">

                                <label asp-for="FullAddress" class="form-label fw-semibold">
                                </label>

                                <textarea asp-for="FullAddress" class="form-control" rows="4"
                                          placeholder="Mahalle, cadde, sokak, bina ve daire bilgileri"></textarea>

                                <span asp-validation-for="FullAddress" class="text-danger small">
                                </span>

                            </div>


                            <div class="col-12">

                                <div class="form-check form-switch">

                                    <input asp-for="IsDefault" class="form-check-input" />

                                    <label asp-for="IsDefault" class="form-check-label">

                                        Varsayılan teslimat adresim yap

                                    </label>

                                </div>

                            </div>

                        </div>


                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-action="Index" class="btn btn-outline-secondary">

                                İptal

                            </a>


                            <button type="submit" class="btn btn-dark px-4">

                                <i class="fa-solid fa-floppy-disk me-2"></i>

                                Adresi Kaydet

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}