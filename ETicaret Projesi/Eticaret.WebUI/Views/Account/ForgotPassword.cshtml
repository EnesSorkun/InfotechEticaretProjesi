@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-5 col-md-7">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">

                        <div class="forgot-icon mb-3">
                            <i class="fa-solid fa-key"></i>
                        </div>

                        <h2 class="fw-bold">
                            Şifremi Unuttum
                        </h2>

                        <p class="text-muted">
                            Hesabınıza kayıtlı email adresinizi girin.
                            Şifrenizi yenileyebilmeniz için size bir bağlantı göndereceğiz.
                        </p>

                    </div>


                    @if (TempData["SuccessMessage"] is not null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }


                    @if (TempData["ErrorMessage"] is not null)
                    {
                        <div class="alert alert-danger">
                            @TempData["ErrorMessage"]
                        </div>
                    }


                    <form asp-controller="Account" asp-action="ForgotPassword" method="post">

                        @Html.AntiForgeryToken()


                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                        </div>


                        <div class="mb-3">

                            <label asp-for="Email" class="form-label">
                            </label>

                            <input asp-for="Email" class="form-control form-control-lg" placeholder="ornek@email.com" />

                            <span asp-validation-for="Email" class="text-danger">
                            </span>

                        </div>


                        <button type="submit" class="btn btn-dark w-100 py-3">

                            <i class="fa-solid fa-envelope me-2"></i>

                            Şifre Yenileme Bağlantısı Gönder

                        </button>

                    </form>


                    <div class="text-center mt-4">

                        <a asp-controller="Account" asp-action="SignIn" class="text-decoration-none">

                            <i class="fa-solid fa-arrow-left me-1"></i>

                            Giriş Yap'a Dön

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<style>
    .forgot-icon {
        width: 70px;
        height: 70px;

        margin-left: auto;
        margin-right: auto;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background-color: #f1f3f5;

        font-size: 1.6rem;
    }
</style>