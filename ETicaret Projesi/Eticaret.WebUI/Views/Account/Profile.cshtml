@model Eticaret.Core.Entities.AppUser

@{
    ViewData["Title"] = "Kullanıcı Bilgilerim";
}

<section class="profile-section">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-9 col-lg-10">

                <!-- =====================================================
                     PROFİL KARTI
                     ===================================================== -->
                <div class="profile-card">

                    <!-- =================================================
                         ÜST PROFİL ALANI
                         ================================================= -->
                    <div class="profile-header">

                        <div class="profile-header-decoration"></div>

                        <div class="profile-header-content">

                            <!-- Avatar -->
                            <div class="profile-avatar">

                                @(string.IsNullOrWhiteSpace(Model.Name)
                                    ? "?"
                                    : Model.Name.Substring(0, 1).ToUpper())

                            </div>


                            <!-- Kullanıcı -->
                            <div class="profile-header-info">

                                <span class="profile-label">
                                    HESABIM
                                </span>

                                <h1 class="profile-name">
                                    @Model.Name @Model.Surname
                                </h1>

                                <p class="profile-username">

                                    <i class="fa-solid fa-at"></i>

                                    <span>
                                        @(string.IsNullOrWhiteSpace(Model.UserName)
                                            ? "Kullanıcı adı belirtilmemiş"
                                            : Model.UserName)
                                    </span>

                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         PROFİL İÇERİĞİ
                         ================================================= -->
                    <div class="profile-body">

                        <!-- Başlık -->
                        <div class="profile-body-header">

                            <div>

                                <span class="profile-body-label">
                                    HESAP DETAYLARI
                                </span>

                                <h2 class="profile-section-title">
                                    Kullanıcı Bilgileri
                                </h2>

                                <p class="profile-section-description">
                                    Hesabınıza ait kişisel ve iletişim
                                    bilgilerinizi görüntüleyebilirsiniz.
                                </p>

                            </div>

                        </div>


                        <!-- =================================================
                             BİLGİLER
                             ================================================= -->
                        <div class="row g-3">


                            <!-- AD -->
                            <div class="col-md-6">

                                <div class="profile-info-card">

                                    <div class="profile-info-icon">
                                        <i class="fa-regular fa-user"></i>
                                    </div>

                                    <div class="profile-info-content">

                                        <span class="profile-info-label">
                                            Ad
                                        </span>

                                        <div class="profile-info-value">
                                            @Model.Name
                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- SOYAD -->
                            <div class="col-md-6">

                                <div class="profile-info-card">

                                    <div class="profile-info-icon">
                                        <i class="fa-regular fa-id-card"></i>
                                    </div>

                                    <div class="profile-info-content">

                                        <span class="profile-info-label">
                                            Soyad
                                        </span>

                                        <div class="profile-info-value">
                                            @Model.Surname
                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- E-POSTA -->
                            <div class="col-md-6">

                                <div class="profile-info-card">

                                    <div class="profile-info-icon">
                                        <i class="fa-regular fa-envelope"></i>
                                    </div>

                                    <div class="profile-info-content">

                                        <span class="profile-info-label">
                                            E-posta
                                        </span>

                                        <div class="profile-info-value text-break">
                                            @Model.Email
                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- TELEFON -->
                            <div class="col-md-6">

                                <div class="profile-info-card">

                                    <div class="profile-info-icon">
                                        <i class="fa-solid fa-phone"></i>
                                    </div>

                                    <div class="profile-info-content">

                                        <span class="profile-info-label">
                                            Telefon
                                        </span>

                                        <div class="profile-info-value">

                                            @(string.IsNullOrWhiteSpace(Model.Phone)
                                                ? "Belirtilmemiş"
                                                : Model.Phone)

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- KULLANICI ADI -->
                            <div class="col-md-6">

                                <div class="profile-info-card">

                                    <div class="profile-info-icon">
                                        <i class="fa-solid fa-at"></i>
                                    </div>

                                    <div class="profile-info-content">

                                        <span class="profile-info-label">
                                            Kullanıcı Adı
                                        </span>

                                        <div class="profile-info-value">

                                            @(string.IsNullOrWhiteSpace(Model.UserName)
                                                ? "Belirtilmemiş"
                                                : Model.UserName)

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- KAYIT TARİHİ -->
                            <div class="col-md-6">

                                <div class="profile-info-card">

                                    <div class="profile-info-icon">
                                        <i class="fa-regular fa-calendar"></i>
                                    </div>

                                    <div class="profile-info-content">

                                        <span class="profile-info-label">
                                            Kayıt Tarihi
                                        </span>

                                        <div class="profile-info-value">
                                            @Model.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             ALT BUTONLAR
                             ================================================= -->
                        <div class="profile-actions">

                            <a asp-controller="Home" asp-action="Index" class="profile-back-button">

                                <i class="fa-solid fa-arrow-left"></i>

                                <span>
                                    Ana Sayfaya Dön
                                </span>

                            </a>


                            <a asp-controller="Account" asp-action="EditProfile" class="profile-edit-button">

                                <i class="fa-solid fa-user-pen"></i>

                                <span>
                                    Bilgilerimi Düzenle
                                </span>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<style>
    /* =========================================================
       SAYFA
       ========================================================= */

    .profile-section {
        min-height: 72vh;

        padding: 55px 0 70px;

        background:
            radial-gradient(circle at top left,
                rgba(190, 145, 91, 0.07),
                transparent 32%),
            linear-gradient(180deg,
                #ffffff 0%,
                #faf7f3 100%);
    }


    /* =========================================================
       ANA KART
       ========================================================= */

    .profile-card {
        overflow: hidden;

        border: 1px solid #e7ddd2;
        border-radius: 22px;

        background-color: #ffffff;

        box-shadow:
            0 16px 42px rgba(70, 47, 30, 0.09);
    }


    /* =========================================================
       PROFİL HEADER
       ========================================================= */

    .profile-header {
        position: relative;

        overflow: hidden;

        padding: 38px;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #35251b 0%,
                #513724 55%,
                #8b5d32 130%);
    }


    /*
     * Sağ üst tarafta hafif dekoratif
     * kehribar parlaması.
     */
    .profile-header::after {
        content: "";

        position: absolute;

        top: -100px;
        right: -70px;

        width: 260px;
        height: 260px;

        border-radius: 50%;

        background:
            radial-gradient(circle,
                rgba(224, 177, 112, 0.18),
                transparent 67%);

        pointer-events: none;
    }


    .profile-header-decoration {
        position: absolute;

        right: 35px;
        bottom: -55px;

        width: 150px;
        height: 150px;

        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 50%;

        pointer-events: none;
    }


    .profile-header-content {
        position: relative;

        z-index: 2;

        display: flex;
        align-items: center;

        gap: 22px;
    }


    /* =========================================================
       AVATAR
       ========================================================= */

    .profile-avatar {
        width: 84px;
        height: 84px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border: 2px solid rgba(255, 255, 255, 0.28);
        border-radius: 50%;

        color: #4c3423;

        background:
            linear-gradient(145deg,
                #fffaf3,
                #e8c99e);

        font-size: 1.9rem;
        font-weight: 800;

        box-shadow:
            0 9px 24px rgba(25, 15, 8, 0.20);
    }


    /* =========================================================
       PROFİL BAŞLIK
       ========================================================= */

    .profile-label {
        display: inline-block;

        margin-bottom: 5px;

        color: #ddb47d;

        font-size: 0.67rem;
        font-weight: 800;

        letter-spacing: 0.16em;
    }


    .profile-name {
        margin: 0 0 7px;

        color: #ffffff;

        font-size: 1.9rem;
        font-weight: 800;

        letter-spacing: -0.02em;
    }


    .profile-username {
        display: flex;
        align-items: center;

        gap: 6px;

        margin: 0;

        color: rgba(255, 255, 255, 0.68);

        font-size: 0.82rem;
    }


    .profile-username i {
        color: #d9ad75;

        font-size: 0.72rem;
    }


    /* =========================================================
       BODY
       ========================================================= */

    .profile-body {
        padding: 34px;
    }


    .profile-body-header {
        margin-bottom: 24px;
    }


    .profile-body-label {
        display: inline-block;

        margin-bottom: 5px;

        color: #9a7042;

        font-size: 0.66rem;
        font-weight: 800;

        letter-spacing: 0.14em;
    }


    .profile-section-title {
        position: relative;

        margin: 0 0 8px;
        padding-bottom: 11px;

        color: #30251d;

        font-size: 1.3rem;
        font-weight: 800;
    }


    .profile-section-title::after {
        content: "";

        position: absolute;

        left: 0;
        bottom: 0;

        width: 38px;
        height: 3px;

        border-radius: 20px;

        background:
            linear-gradient(90deg,
                #8a5c2f,
                #d0a16a);
    }


    .profile-section-description {
        margin: 0;

        color: #897c70;

        font-size: 0.82rem;
        line-height: 1.6;
    }


    /* =========================================================
       BİLGİ KARTLARI
       ========================================================= */

    .profile-info-card {
        min-height: 88px;

        display: flex;
        align-items: center;

        gap: 14px;

        padding: 16px;

        border: 1px solid #e9e0d6;
        border-radius: 13px;

        background:
            linear-gradient(145deg,
                #ffffff,
                #fcfaf7);

        transition:
            transform 0.2s ease,
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }


    .profile-info-card:hover {
        border-color: #d7c0a6;

        transform: translateY(-2px);

        box-shadow:
            0 7px 18px rgba(70, 47, 30, 0.07);
    }


    /* =========================================================
       BİLGİ İKONU
       ========================================================= */

    .profile-info-icon {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 11px;

        color: #8c6035;

        background:
            linear-gradient(145deg,
                #f7eee4,
                #f1e3d3);

        font-size: 0.9rem;
    }


    .profile-info-content {
        min-width: 0;
    }


    /* =========================================================
       BİLGİ YAZILARI
       ========================================================= */

    .profile-info-label {
        display: block;

        margin-bottom: 3px;

        color: #9a8d81;

        font-size: 0.69rem;
        font-weight: 600;
    }


    .profile-info-value {
        color: #403229;

        font-size: 0.87rem;
        font-weight: 700;

        word-break: break-word;
    }


    /* =========================================================
       ALT BUTONLAR
       ========================================================= */

    .profile-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 12px;

        margin-top: 30px;
        padding-top: 23px;

        border-top: 1px solid #eee6dd;
    }


    .profile-back-button,
    .profile-edit-button {
        min-height: 43px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        padding: 9px 16px;

        border-radius: 10px;

        font-size: 0.78rem;
        font-weight: 700;

        text-decoration: none;

        transition:
            color 0.2s ease,
            border-color 0.2s ease,
            background 0.2s ease,
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }


    /* =========================================================
       GERİ DÖN
       ========================================================= */

    .profile-back-button {
        border: 1px solid #ddd2c5;

        color: #685343;

        background-color: #ffffff;
    }


    .profile-back-button:hover {
        color: #443226;

        border-color: #c7aa88;

        background-color: #fbf8f4;

        transform: translateX(-2px);
    }


    /* =========================================================
       DÜZENLE
       ========================================================= */

    .profile-edit-button {
        border: 1px solid #493225;

        color: #ffffff;

        background:
            linear-gradient(135deg,
                #493225,
                #8b5e34);

        box-shadow:
            0 5px 15px rgba(73, 50, 37, 0.16);
    }


    .profile-edit-button:hover {
        color: #ffffff;

        border-color: #9b6a3a;

        background:
            linear-gradient(135deg,
                #5b3e2b,
                #9b6a3a);

        transform: translateY(-2px);

        box-shadow:
            0 8px 20px rgba(73, 50, 37, 0.21);
    }


    /* =========================================================
       TABLET
       ========================================================= */

    @@media (max-width: 991.98px) {

        .profile-section {
            padding: 40px 0 55px;
        }


        .profile-header {
            padding: 30px;
        }


        .profile-body {
            padding: 28px;
        }

    }


    /* =========================================================
       MOBİL
       ========================================================= */

    @@media (max-width: 767.98px) {

        .profile-section {
            padding: 28px 0 45px;
        }


        .profile-card {
            border-radius: 17px;
        }


        .profile-header {
            padding: 26px 21px;
        }


        .profile-avatar {
            width: 67px;
            height: 67px;

            font-size: 1.45rem;
        }


        .profile-name {
            font-size: 1.45rem;
        }


        .profile-body {
            padding: 23px 19px;
        }


        .profile-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }


        .profile-back-button,
        .profile-edit-button {
            width: 100%;
        }

    }


    /* =========================================================
       KÜÇÜK TELEFON
       ========================================================= */

    @@media (max-width: 480px) {

        .profile-header-content {
            flex-direction: column;
            align-items: flex-start;

            gap: 15px;
        }


        .profile-name {
            font-size: 1.3rem;
        }


        .profile-info-card {
            min-height: auto;
        }

    }
</style>