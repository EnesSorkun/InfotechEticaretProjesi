@model Eticaret.WebUI.Models.LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "_LayoutAuth";
}

<div class="auth-page">

    <div class="auth-container">

        <!-- Logo -->
        <div class="text-center mb-4">

            <a asp-controller="Home" asp-action="Index" class="auth-logo text-decoration-none">

                <span class="logo-main">Tekno</span><span class="logo-sub">Grit</span>

            </a>

            <p class="text-muted mt-2 mb-0">
                Hesabınıza giriş yapın
            </p>

        </div>


        <!-- Giriş Kartı -->
        <div class="auth-card">

            <div class="mb-4">

                <h1 class="auth-title">
                    Giriş Yap
                </h1>

                <p class="auth-description">
                    TeknoGrit hesabınıza giriş yapmak için bilgilerinizi girin.
                </p>

            </div>


            <form asp-controller="Account" asp-action="SignIn" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="ReturnUrl" />


                <!-- Genel Validation -->
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                </div>


                <!-- Email -->
                <div class="mb-3">

                    <label asp-for="Email" class="form-label fw-semibold">
                    </label>

                    <div class="auth-input">

                        <i class="fa-regular fa-envelope"></i>

                        <input asp-for="Email" class="form-control" placeholder="ornek@email.com"
                               autocomplete="email" />

                    </div>

                    <span asp-validation-for="Email" class="text-danger small">
                    </span>

                </div>


                <!-- Şifre -->
                <div class="mb-2">

                    <div class="d-flex justify-content-between align-items-center mb-2">

                        <label asp-for="Password" class="form-label fw-semibold mb-0">
                        </label>

                        <a href="#" class="forgot-password">
                            Şifremi Unuttum
                        </a>

                    </div>

                    <div class="auth-input">

                        <i class="fa-solid fa-lock"></i>

                        <input asp-for="Password" class="form-control" placeholder="Şifrenizi girin"
                               autocomplete="current-password" />

                    </div>

                    <span asp-validation-for="Password" class="text-danger small">
                    </span>

                </div>


                <!-- Beni Hatırla -->
                <div class="form-check my-4">

                    <input asp-for="RememberMe" class="form-check-input" />

                    <label asp-for="RememberMe" class="form-check-label text-muted">
                    </label>

                </div>


                <!-- Giriş Butonu -->
                <button type="submit" class="btn auth-button w-100">

                    Giriş Yap

                    <i class="fa-solid fa-arrow-right ms-2"></i>

                </button>

            </form>


            <!-- Kayıt -->
            <div class="auth-register">

                <span class="text-muted">
                    Henüz hesabınız yok mu?
                </span>

                <a asp-controller="Account" asp-action="SignUp">
                    Kayıt Ol
                </a>

            </div>

        </div>


        <!-- Ana Sayfaya Dön -->
        <div class="text-center mt-4">

            <a asp-controller="Home" asp-action="Index" class="back-home">

                <i class="fa-solid fa-arrow-left me-2"></i>
                Ana Sayfaya Dön

            </a>

        </div>

    </div>

</div>


<style>
    body {
        background-color: #f5f7fa;
    }


    .auth-page {
        min-height: 100vh;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 40px 16px;
    }


    .auth-container {
        width: 100%;
        max-width: 460px;
    }


    /* Logo */

    .auth-logo {
        display: inline-block;

        font-size: 2rem;
        font-weight: 800;

        letter-spacing: -1px;
    }


    .logo-main {
        color: #212529;
    }


    .logo-sub {
        color: #0d6efd;
    }


    /* Kart */

    .auth-card {
        padding: 36px;

        background-color: #ffffff;

        border: 1px solid #e9ecef;
        border-radius: 20px;

        box-shadow:
            0 12px 40px rgba(0, 0, 0, 0.07);
    }


    .auth-title {
        margin-bottom: 8px;

        font-size: 1.7rem;
        font-weight: 800;

        color: #212529;
    }


    .auth-description {
        margin: 0;

        color: #6c757d;

        font-size: 0.92rem;
        line-height: 1.6;
    }


    /* Input */

    .auth-input {
        height: 52px;

        display: flex;
        align-items: center;

        padding: 0 16px;

        border: 1px solid #dee2e6;
        border-radius: 12px;

        background-color: #ffffff;

        transition: 0.2s ease;
    }


    .auth-input:focus-within {
        border-color: #0d6efd;

        box-shadow:
            0 0 0 0.2rem rgba(13, 110, 253, 0.10);
    }


    .auth-input i {
        width: 22px;

        color: #adb5bd;
    }


    .auth-input .form-control {
        height: 100%;

        border: 0;

        box-shadow: none;

        background-color: transparent;
    }


    /* Validation */

    .field-validation-error {
        display: block;

        margin-top: 6px;

        font-size: 0.8rem;
    }


    /* Şifremi unuttum */

    .forgot-password {
        color: #0d6efd;

        font-size: 0.85rem;
        font-weight: 500;

        text-decoration: none;
    }


    .forgot-password:hover {
        text-decoration: underline;
    }


    /* Buton */

    .auth-button {
        padding: 13px;

        border: 0;
        border-radius: 12px;

        color: #ffffff;

        background-color: #212529;

        font-weight: 600;

        transition: 0.2s ease;
    }


    .auth-button:hover {
        color: #ffffff;

        background-color: #000000;

        transform: translateY(-1px);
    }


    /* Kayıt */

    .auth-register {
        margin-top: 26px;
        padding-top: 22px;

        border-top: 1px solid #eeeeee;

        text-align: center;

        font-size: 0.9rem;
    }


    .auth-register a {
        margin-left: 4px;

        color: #0d6efd;

        font-weight: 600;

        text-decoration: none;
    }


    .auth-register a:hover {
        text-decoration: underline;
    }


    /* Ana sayfa */

    .back-home {
        color: #6c757d;

        font-size: 0.9rem;

        text-decoration: none;

        transition: 0.2s ease;
    }


    .back-home:hover {
        color: #212529;
    }


    /* Mobil */

    @@media (max-width: 575.98px) {

        .auth-page {
            align-items: flex-start;

            padding-top: 30px;
        }


        .auth-card {
            padding: 26px 20px;

            border-radius: 16px;
        }


        .auth-logo {
            font-size: 1.7rem;
        }


        .auth-title {
            font-size: 1.5rem;
        }

    }
</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}